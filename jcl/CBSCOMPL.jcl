//CBSCOMPL JOB (CBS,PROD,BSA),'CBS BSA/AML RERUN',
//             CLASS=P,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=0M,COND=(4,LT)
//*********************************************************************
//* JOB      : CBSCOMPL                                               *
//* PURPOSE  : BSA/AML COMPLIANCE STREAM. THE SAME PROGRAMS RUN       *
//*            INSIDE CBSEOD (STEPS EOD08A-C AND EOD20); THIS JOB IS  *
//*            USED BY BSA OPERATIONS FOR AN OFF-CYCLE RERUN (E.G.    *
//*            AFTER AN SDN LIST UPDATE OR A SCENARIO THRESHOLD       *
//*            CHANGE) AND TO REFRESH THE ONLINE ALERT WORK QUEUE     *
//*            (VSAM KSDS ALERTKS USED BY CICS TRANSACTION CB60).     *
//*                                                                   *
//*   STEP     PROGRAM   FUNCTION                                     *
//*   CMP010   CTRSCAN   CTR DETERMINATION -> CTRFILE(+1), CTR1 ALERTS *
//*   CMP020   STRUCTUR  STRUCTURING (10 BUSINESS DAY LOOKBACK)        *
//*   CMP030   AMLMON    AML SCENARIOS (30 DAY LOOKBACK)               *
//*   CMP040   OFACBAT   SDN RE-SCREEN OF CUSTMST + TODAY'S WIRES      *
//*   CMP050   SORT      ALERTS -> KEYED WORK QUEUE EXTRACT            *
//*   CMP060   IDCAMS    REPRO EXTRACT INTO ALERTKS (NEW ALERTS ONLY)  *
//*                                                                   *
//* NOTES                                                             *
//*   - RUN ONLY WHILE CBSEOD IS NOT ACTIVE (SCHEDULER RESOURCE       *
//*     CBS.EOD.LOCK). TRANPOST IS TODAY'S POSTED FILE; AFTER EOD21   *
//*     IT HAS ALREADY BEEN APPENDED TO TRANHIST AND THE BUSINESS     *
//*     DATE HAS ROLLED, SO A RERUN AFTER EOD21 FINDS NOTHING.        *
//*   - A RERUN WRITES DUPLICATE ALERTS. BSA OPERATIONS CLOSES THE    *
//*     DUPLICATES IN CB60 WITH DISPOSITION C.                        *
//*   - CMP060 USES REPRO NOREPLACE SO DISPOSITIONED ALERTS ARE NOT   *
//*     OVERWRITTEN (DUPLICATE KEYS GIVE RC 8 -> SET MAXCC 4).        *
//*   - RESTART: RESUBMIT WITH RESTART=CMPnnn. ALL STEPS ARE RERUNNABLE*
//*     EXCEPT CMP010, WHICH CREATES A NEW CTRFILE GENERATION - DELETE*
//*     IT FIRST OR THE BSA E-FILING EXTRACT WILL FILE TWICE.         *
//*-------------------------------------------------------------------*
//* CHANGE LOG                                                        *
//* 2001-10-26 BHS  ORIGINAL (CTRSCAN, STRUCTUR)                      *
//* 2004-08-02 BHS  AMLMON                                            *
//* 2011-01-24 DPS  OFACBAT DAILY                                     *
//* 2013-05-13 DPS  ALERTKS REFRESH FOR CB60 WORK QUEUE               *
//*********************************************************************
//JOBLIB   DD DSN=CBS.PROD.LOADLIB,DISP=SHR
//         DD DSN=CEE.SCEERUN,DISP=SHR
//*
//CMP010   EXEC PGM=CTRSCAN
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//TRANPOST DD DSN=CBS.PROD.TRANPOST.DAILY,DISP=SHR
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=SHR
//CUSTMST  DD DSN=CBS.PROD.CUSTMST,DISP=SHR
//CTRFILE  DD DSN=CBS.PROD.BSA.CTRFILE(+1),DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(15,15),RLSE),
//            DCB=(RECFM=FB,LRECL=474,BLKSIZE=0)
//ALERTS   DD DSN=CBS.PROD.ALERTS,DISP=MOD
//CTRRPT   DD SYSOUT=(R,,CTR1)
//SYSOUT   DD SYSOUT=*
//*
//CMP020   EXEC PGM=STRUCTUR
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//TRANHIST DD DSN=CBS.PROD.TRANHIST(0),DISP=SHR
//TRANPOST DD DSN=CBS.PROD.TRANPOST.DAILY,DISP=SHR
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=SHR
//CUSTMST  DD DSN=CBS.PROD.CUSTMST,DISP=SHR
//ALERTS   DD DSN=CBS.PROD.ALERTS,DISP=MOD
//STRCRPT  DD SYSOUT=(R,,BSA1)
//SYSOUT   DD SYSOUT=*
//*
//CMP030   EXEC PGM=AMLMON
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//TRANHIST DD DSN=CBS.PROD.TRANHIST(0),DISP=SHR
//TRANPOST DD DSN=CBS.PROD.TRANPOST.DAILY,DISP=SHR
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=SHR
//CUSTMST  DD DSN=CBS.PROD.CUSTMST,DISP=SHR
//ALERTS   DD DSN=CBS.PROD.ALERTS,DISP=MOD
//AMLRPT   DD SYSOUT=(R,,BSA1)
//SYSOUT   DD SYSOUT=*
//*
//CMP040   EXEC PGM=OFACBAT
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//SDNLIST  DD DSN=CBS.PROD.OFAC.SDNLIST,DISP=SHR
//CUSTMST  DD DSN=CBS.PROD.CUSTMST,DISP=OLD
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=SHR
//TRANPOST DD DSN=CBS.PROD.TRANPOST.DAILY,DISP=SHR
//ALERTS   DD DSN=CBS.PROD.ALERTS,DISP=MOD
//OFACRPT  DD SYSOUT=(R,,BSA1)
//SYSOUT   DD SYSOUT=*
//*
//*-------------------------------------------------------------------*
//* CMP050 - BUILD ALERTKS RECORDS (COPYBOOK ALRTWRK, LRECL 300):     *
//*   KEY = ALRT-DATE (8) + SEQUENCE WITHIN DATE (6)                  *
//*   DATA = ALERTREC (166) + DISPOSITION AREA (120, BLANK = OPEN)    *
//*-------------------------------------------------------------------*
//CMP050   EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=CBS.PROD.ALERTS,DISP=SHR
//SORTOUT  DD DSN=&&ALRTWQ,DISP=(NEW,PASS),
//            UNIT=SYSDA,SPACE=(CYL,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=300,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(1,8,CH,A,9,6,CH,A,15,4,CH,A,20,10,CH,A)
  OUTREC FIELDS=(1,8,SEQNUM,6,ZD,RESTART=(1,8),1,166,120X)
/*
//*
//CMP060   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//WQIN     DD DSN=&&ALRTWQ,DISP=(OLD,DELETE)
//WQOUT    DD DSN=CBS.PROD.ALERTKS,DISP=SHR
//SYSIN    DD *
  REPRO INFILE(WQIN) OUTFILE(WQOUT) NOREPLACE
  IF LASTCC = 8 THEN SET MAXCC = 4
/*
//
