//CBSEOD   JOB (CBS,PROD,EOD),'CBS END OF DAY',
//             CLASS=P,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=0M,COND=(4,LT)
//*********************************************************************
//* JOB      : CBSEOD                                                 *
//* PURPOSE  : CORE BANKING SYSTEM - MASTER END-OF-DAY JOB STREAM.    *
//*            RELEASED BY THE SCHEDULER (CA-7 JOB CBSEOD01) AFTER    *
//*            THE ONLINE REGION CLOSES FILES (CICS CEMT SET FILE     *
//*            CLOSED VIA JOB CBSCLOSE) AND THE CHANNEL FEEDS ARRIVE. *
//*                                                                   *
//*   STEP    PROGRAM   FUNCTION                                      *
//*   EOD01   EODCTL    START - CYCLE STATUS E, ME/QE/YE FLAGS         *
//*   EOD02A  IDCAMS    CLEAR TODAY'S TRANPOST/TRANEDT/TRANREJ/ACH/PAY *
//*   EOD02   ACHIN     INBOUND NACHA -> ACHTRAN                       *
//*   EOD03   PAYPROC   DUE PAYMENT INSTRUCTIONS -> PAYTRAN, NACHA/FED *
//*   EOD04   TRANEDIT  TRANIN+ACHTRAN+PAYTRAN -> TRANEDT / TRANREJ    *
//*   EOD05   POSTTRAN  POST TO ACCTMST/HOLDMST -> TRANPOST            *
//*   EOD06   ACHRET    ACH RETURN FILE                                *
//*   EOD07   LNPAYAP   LOAN PAYMENT APPLICATION                       *
//*   EOD08A  CTRSCAN   CURRENCY TRANSACTION REPORTS                   *
//*   EOD08B  STRUCTUR  STRUCTURING DETECTION                          *
//*   EOD08C  AMLMON    AML SCENARIO MONITORING                        *
//*   EOD09   HOLDREL   HOLD RELEASE                                   *
//*   EOD10   SWEEPRUN  ZBA / TARGET BALANCE SWEEPS                    *
//*   EOD11   INTACCR   DEPOSIT INTEREST ACCRUAL                       *
//*   EOD12   LNACCR    LOAN INTEREST ACCRUAL                          *
//*   EOD13   ODAGING   OVERDRAFT AGING / CHARGE-OFF                   *
//*   EOD14   CDMATUR   CD MATURITY / RENEWAL                          *
//*   EOD15A  LNBILL    LOAN BILLING                                   *
//*   EOD15B  LNDELQ    LOAN DELINQUENCY / LATE FEES                   *
//*   EOD16xx           MONTH-END ONLY (IF MECHK.RC = 0):              *
//*           INTCAP FEEASSES ANLYSFEE POOLCALC STMTGEN DORMSCAN       *
//*           KYCREVW                                                  *
//*   EOD17   INT1099   YEAR-END ONLY (IF YECHK.RC = 0)                *
//*   EOD18   RELBAL    RELATIONSHIP BALANCES                          *
//*   EOD19A  GLEXTR    GL EXTRACT                                     *
//*   EOD19B  GLTRIAL   GL TRIAL BALANCE                               *
//*   EOD19C  GLRECON   GL / SUB-LEDGER RECONCILIATION                 *
//*   EOD20   OFACBAT   OFAC CUSTOMER / WIRE RE-SCREENING              *
//*   EOD21A  IEBGENER  TRANHIST(0) -> TRANHIST(+1)                    *
//*   EOD21   EODCTL    END - TRANPOST -> TRANHIST(+1), RESET, ROLL    *
//*                                                                   *
//* CONDITION CODES                                                   *
//*   JOB-LEVEL COND=(4,LT): ANY STEP ENDING RC > 4 BYPASSES ALL      *
//*   REMAINING STEPS. RC 4 = WARNING (E.G. EODCTL START ON A CYCLE   *
//*   ALREADY IN STATUS E, OFACBAT WITH AN EMPTY SDN LIST).           *
//*   MECHK / YECHK END RC 0 WHEN THE FLAG IS Y AND RC 4 WHEN IT IS N *
//*   (ICETOOL COUNT ... EMPTY RC4). THE PROGRAMS ALSO SELF-CHECK THE *
//*   BANKCTL FLAGS, SO A FORCED RUN OF A 16XX STEP ON ANOTHER DAY    *
//*   NEEDS PARM='FORCE'.                                             *
//*                                                                   *
//* RESTART                                                           *
//*   1. FIX THE CAUSE OF THE FAILING STEP (SEE SYSOUT / ABENDRTN).   *
//*   2. RESUBMIT WITH RESTART=<STEPNAME> ON THE JOB CARD, E.G.       *
//*         //CBSEOD JOB ...,RESTART=EOD08B                           *
//*   3. NEVER RESTART AT OR BEFORE EOD02A ONCE EOD05 HAS COMPLETED - *
//*      EOD02A EMPTIES TRANPOST AND TODAY'S POSTINGS WOULD BE LOST   *
//*      (ACCTMST WOULD STILL CARRY THEM). RESTORE ACCTMST FROM THE   *
//*      CBSBKUP IMAGE COPY INSTEAD AND RERUN FROM EOD01.             *
//*   4. EOD01 MAY BE RERUN (RC 4 - RESTART ASSUMED).                 *
//*   5. A RESTART AT EOD16XX MUST STILL RUN MECHK - USE              *
//*      RESTART=MECHK.                                               *
//*   6. IF EOD21 FAILED AFTER EOD21A, DELETE THE NEW TRANHIST(+1)    *
//*      GENERATION BEFORE RESTARTING AT EOD21A.                      *
//*   LOCAL EQUIVALENT: SCRIPTS/RUN-EOD.SH --FROM <STEP>              *
//*-------------------------------------------------------------------*
//* CHANGE LOG                                                        *
//* 1989-02-14 RJT  ORIGINAL                                          *
//* 2001-10-26 BHS  CTR / STRUCTURING STEPS (USA PATRIOT ACT)         *
//* 2004-08-02 BHS  AMLMON                                            *
//* 2011-04-12 DPS  SWEEPS, POOLING, ANALYSIS (TXB CONVERSION)        *
//* 2014-06-02 DPS  TRANHIST CONVERTED TO GDG (LIMIT 31)              *
//* 2016-09-23 DPS  SAME-DAY ACH - ACHIN BEFORE TRANEDIT              *
//* 2019-03-25 AKW  MONTH-END GATING VIA ICETOOL CHECK STEP           *
//* 2023-02-06 AKW  CHG2140 OFACBAT MOVED TO END OF CYCLE             *
//*********************************************************************
//JOBLIB   DD DSN=CBS.PROD.LOADLIB,DISP=SHR
//         DD DSN=CEE.SCEERUN,DISP=SHR
//*
//*-------------------------------------------------------------------*
//* EOD01 - OPEN THE CYCLE                                            *
//*-------------------------------------------------------------------*
//EOD01    EXEC PGM=EODCTL,PARM='START'
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=OLD
//EODRPT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//*-------------------------------------------------------------------*
//* EOD02A - EMPTY TODAY'S WORK FILES                                 *
//*-------------------------------------------------------------------*
//EOD02A   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE CBS.PROD.TRANPOST.DAILY PURGE
  DELETE CBS.PROD.TRANEDT.DAILY  PURGE
  DELETE CBS.PROD.TRANREJ.DAILY  PURGE
  DELETE CBS.PROD.ACHTRAN.DAILY  PURGE
  DELETE CBS.PROD.PAYTRAN.DAILY  PURGE
  SET MAXCC = 0
/*
//EOD02B   EXEC PGM=IEFBR14
//TRANPOST DD DSN=CBS.PROD.TRANPOST.DAILY,DISP=(NEW,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(50,25),RLSE),
//            DCB=(RECFM=FB,LRECL=281,BLKSIZE=0)
//TRANEDT  DD DSN=CBS.PROD.TRANEDT.DAILY,DISP=(NEW,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(50,25),RLSE),
//            DCB=(RECFM=FB,LRECL=281,BLKSIZE=0)
//TRANREJ  DD DSN=CBS.PROD.TRANREJ.DAILY,DISP=(NEW,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=281,BLKSIZE=0)
//ACHTRAN  DD DSN=CBS.PROD.ACHTRAN.DAILY,DISP=(NEW,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(20,10),RLSE),
//            DCB=(RECFM=FB,LRECL=281,BLKSIZE=0)
//PAYTRAN  DD DSN=CBS.PROD.PAYTRAN.DAILY,DISP=(NEW,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=281,BLKSIZE=0)
//*
//*-------------------------------------------------------------------*
//* EOD02 - INBOUND ACH                                               *
//*-------------------------------------------------------------------*
//EOD02    EXEC PGM=ACHIN
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=SHR
//ACHINBND DD DSN=CBS.PROD.ACH.INBOUND(0),DISP=SHR
//ACHTRAN  DD DSN=CBS.PROD.ACHTRAN.DAILY,DISP=MOD
//ACHRTN   DD DSN=CBS.PROD.ACH.RTNSTAGE,DISP=MOD
//ACHINRPT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//*-------------------------------------------------------------------*
//* EOD03 - PAYMENT INSTRUCTIONS                                      *
//*-------------------------------------------------------------------*
//EOD03    EXEC PGM=PAYPROC
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//PAYMST   DD DSN=CBS.PROD.PAYMST,DISP=SHR
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=SHR
//CUSTMST  DD DSN=CBS.PROD.CUSTMST,DISP=SHR
//SDNLIST  DD DSN=CBS.PROD.OFAC.SDNLIST,DISP=SHR
//PAYTRAN  DD DSN=CBS.PROD.PAYTRAN.DAILY,DISP=MOD
//ACHOUTB  DD DSN=CBS.PROD.ACH.OUTBOUND(+1),DISP=(NEW,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(10,10),RLSE),
//            DCB=(RECFM=FB,LRECL=94,BLKSIZE=0)
//FEDWOUT  DD DSN=CBS.PROD.FEDWIRE.OUTBOUND(+1),DISP=(NEW,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(5,5),RLSE)
//ALERTS   DD DSN=CBS.PROD.ALERTS,DISP=MOD
//PAYRPT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//*-------------------------------------------------------------------*
//* EOD04 - TRANSACTION EDIT                                          *
//*-------------------------------------------------------------------*
//EOD04    EXEC PGM=TRANEDIT
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=SHR
//CUSTMST  DD DSN=CBS.PROD.CUSTMST,DISP=SHR
//PRODMST  DD DSN=CBS.PROD.PRODMST,DISP=SHR
//TRANIN   DD DSN=CBS.PROD.TRANIN.CHANNEL(0),DISP=SHR
//ACHTRAN  DD DSN=CBS.PROD.ACHTRAN.DAILY,DISP=SHR
//PAYTRAN  DD DSN=CBS.PROD.PAYTRAN.DAILY,DISP=SHR
//TRANEDT  DD DSN=CBS.PROD.TRANEDT.DAILY,DISP=OLD
//TRANREJ  DD DSN=CBS.PROD.TRANREJ.DAILY,DISP=MOD
//EDITRPT  DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//*-------------------------------------------------------------------*
//* EOD05 - POSTING                                                   *
//*-------------------------------------------------------------------*
//EOD05    EXEC PGM=POSTTRAN
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=OLD
//HOLDMST  DD DSN=CBS.PROD.HOLDMST,DISP=OLD
//PRODMST  DD DSN=CBS.PROD.PRODMST,DISP=SHR
//CUSTMST  DD DSN=CBS.PROD.CUSTMST,DISP=SHR
//TRANEDT  DD DSN=CBS.PROD.TRANEDT.DAILY,DISP=SHR
//TRANPOST DD DSN=CBS.PROD.TRANPOST.DAILY,DISP=MOD
//TRANREJ  DD DSN=CBS.PROD.TRANREJ.DAILY,DISP=MOD
//ALERTS   DD DSN=CBS.PROD.ALERTS,DISP=MOD
//POSTRPT  DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//*-------------------------------------------------------------------*
//* EOD06 - ACH RETURNS                                               *
//*-------------------------------------------------------------------*
//EOD06    EXEC PGM=ACHRET
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//TRANREJ  DD DSN=CBS.PROD.TRANREJ.DAILY,DISP=SHR
//ACHRTN   DD DSN=CBS.PROD.ACH.RTNSTAGE,DISP=MOD
//ACHRTNF  DD DSN=CBS.PROD.ACH.RETURNS(+1),DISP=(NEW,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=94,BLKSIZE=0)
//ACHRRPT  DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//*-------------------------------------------------------------------*
//* EOD07 - LOAN PAYMENT APPLICATION                                  *
//*-------------------------------------------------------------------*
//EOD07    EXEC PGM=LNPAYAP
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//LOANMST  DD DSN=CBS.PROD.LOANMST,DISP=OLD
//TRANPOST DD DSN=CBS.PROD.TRANPOST.DAILY,DISP=SHR
//LNPAYHST DD DSN=CBS.PROD.LNPAYHST(+1),DISP=(NEW,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(5,5),RLSE)
//LNPYRPT  DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//*-------------------------------------------------------------------*
//* EOD08A/B/C - BSA/AML MONITORING (SEE ALSO JOB CBSCOMPL FOR AN     *
//* OFF-CYCLE RERUN OF THESE STEPS)                                   *
//*-------------------------------------------------------------------*
//EOD08A   EXEC PGM=CTRSCAN
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//TRANPOST DD DSN=CBS.PROD.TRANPOST.DAILY,DISP=SHR
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=SHR
//CUSTMST  DD DSN=CBS.PROD.CUSTMST,DISP=SHR
//CTRFILE  DD DSN=CBS.PROD.BSA.CTRFILE(+1),DISP=(NEW,CATLG),
//            UNIT=SYSDA,SPACE=(TRK,(15,15),RLSE),
//            DCB=(RECFM=FB,LRECL=474,BLKSIZE=0)
//ALERTS   DD DSN=CBS.PROD.ALERTS,DISP=MOD
//CTRRPT   DD SYSOUT=(R,,CTR1)
//SYSOUT   DD SYSOUT=*
//*
//EOD08B   EXEC PGM=STRUCTUR
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//TRANHIST DD DSN=CBS.PROD.TRANHIST(0),DISP=SHR
//TRANPOST DD DSN=CBS.PROD.TRANPOST.DAILY,DISP=SHR
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=SHR
//CUSTMST  DD DSN=CBS.PROD.CUSTMST,DISP=SHR
//ALERTS   DD DSN=CBS.PROD.ALERTS,DISP=MOD
//STRCRPT  DD SYSOUT=(R,,BSA1)
//SYSOUT   DD SYSOUT=*
//*
//EOD08C   EXEC PGM=AMLMON
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//TRANHIST DD DSN=CBS.PROD.TRANHIST(0),DISP=SHR
//TRANPOST DD DSN=CBS.PROD.TRANPOST.DAILY,DISP=SHR
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=SHR
//CUSTMST  DD DSN=CBS.PROD.CUSTMST,DISP=SHR
//ALERTS   DD DSN=CBS.PROD.ALERTS,DISP=MOD
//AMLRPT   DD SYSOUT=(R,,BSA1)
//SYSOUT   DD SYSOUT=*
//*
//*-------------------------------------------------------------------*
//* EOD09 - EOD15B - DAILY ACCOUNT MAINTENANCE                        *
//*-------------------------------------------------------------------*
//EOD09    EXEC PGM=HOLDREL
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//HOLDMST  DD DSN=CBS.PROD.HOLDMST,DISP=OLD
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=OLD
//HOLDRPT  DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//EOD10    EXEC PGM=SWEEPRUN
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//SWEEPMST DD DSN=CBS.PROD.SWEEPMST,DISP=SHR
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=OLD
//TRANPOST DD DSN=CBS.PROD.TRANPOST.DAILY,DISP=MOD
//SWEEPRPT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//EOD11    EXEC PGM=INTACCR
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=OLD
//PRODMST  DD DSN=CBS.PROD.PRODMST,DISP=SHR
//RATECHG  DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//EOD12    EXEC PGM=LNACCR
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//LOANMST  DD DSN=CBS.PROD.LOANMST,DISP=OLD
//LNACRPT  DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//EOD13    EXEC PGM=ODAGING
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=OLD
//TRANPOST DD DSN=CBS.PROD.TRANPOST.DAILY,DISP=MOD
//ALERTS   DD DSN=CBS.PROD.ALERTS,DISP=MOD
//ODAGRPT  DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//EOD14    EXEC PGM=CDMATUR
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=OLD
//PRODMST  DD DSN=CBS.PROD.PRODMST,DISP=SHR
//TRANPOST DD DSN=CBS.PROD.TRANPOST.DAILY,DISP=MOD
//CDMATRPT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//EOD15A   EXEC PGM=LNBILL
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//LOANMST  DD DSN=CBS.PROD.LOANMST,DISP=OLD
//LNBILLS  DD DSN=CBS.PROD.LNBILLS(+1),DISP=(NEW,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(5,5),RLSE)
//LNAUTOPY DD DSN=CBS.PROD.TRANIN.LNAUTOPY,DISP=MOD
//LNBLRPT  DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//EOD15B   EXEC PGM=LNDELQ
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//LOANMST  DD DSN=CBS.PROD.LOANMST,DISP=OLD
//ALERTS   DD DSN=CBS.PROD.ALERTS,DISP=MOD
//LNDQRPT  DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//*-------------------------------------------------------------------*
//* MECHK - RC 0 IF CTL-MONTH-END-FLAG (COL 38) = Y, ELSE RC 4        *
//*-------------------------------------------------------------------*
//MECHK    EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//CTL      DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//TOOLIN   DD *
  COUNT FROM(CTL) USING(MEFL) EMPTY RC4
/*
//MEFLCNTL DD *
  INCLUDE COND=(38,1,CH,EQ,C'Y')
/*
//*
//IFME     IF (MECHK.RC = 0) THEN
//EOD16A   EXEC PGM=INTCAP
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=OLD
//TRANPOST DD DSN=CBS.PROD.TRANPOST.DAILY,DISP=MOD
//INTCAPR  DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//EOD16B   EXEC PGM=FEEASSES
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=OLD
//PRODMST  DD DSN=CBS.PROD.PRODMST,DISP=SHR
//TRANPOST DD DSN=CBS.PROD.TRANPOST.DAILY,DISP=MOD
//FEERPT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//EOD16C   EXEC PGM=ANLYSFEE
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=OLD
//ANLYCFI  DD DSN=CBS.PROD.ANALYSIS.CARRYFWD(0),DISP=SHR
//ANLYCFO  DD DSN=CBS.PROD.ANALYSIS.CARRYFWD(+1),DISP=(NEW,CATLG),
//            UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE)
//TRANPOST DD DSN=CBS.PROD.TRANPOST.DAILY,DISP=MOD
//ANLYSRPT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//EOD16D   EXEC PGM=POOLCALC
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//POOLMST  DD DSN=CBS.PROD.POOLMST,DISP=SHR
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=OLD
//TRANPOST DD DSN=CBS.PROD.TRANPOST.DAILY,DISP=MOD
//POOLRPT  DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//EOD16E   EXEC PGM=STMTGEN
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=OLD
//CUSTMST  DD DSN=CBS.PROD.CUSTMST,DISP=SHR
//TRANHIST DD DSN=CBS.PROD.TRANHIST(0),DISP=SHR
//TRANPOST DD DSN=CBS.PROD.TRANPOST.DAILY,DISP=SHR
//STMTOUT  DD DSN=CBS.PROD.STMT.PRINT(+1),DISP=(NEW,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(100,50),RLSE),
//            DCB=(RECFM=FBA,LRECL=133,BLKSIZE=0)
//STMTRPT  DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//EOD16F   EXEC PGM=DORMSCAN
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=OLD
//CUSTMST  DD DSN=CBS.PROD.CUSTMST,DISP=SHR
//TRANPOST DD DSN=CBS.PROD.TRANPOST.DAILY,DISP=MOD
//ALERTS   DD DSN=CBS.PROD.ALERTS,DISP=MOD
//DORMRPT  DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//EOD16G   EXEC PGM=KYCREVW
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//CUSTMST  DD DSN=CBS.PROD.CUSTMST,DISP=OLD
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=SHR
//ALERTS   DD DSN=CBS.PROD.ALERTS,DISP=MOD
//KYCRPT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//IFMEEND  ENDIF
//*
//*-------------------------------------------------------------------*
//* YECHK - RC 0 IF CTL-YEAR-END-FLAG (COL 40) = Y, ELSE RC 4         *
//*-------------------------------------------------------------------*
//YECHK    EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//CTL      DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//TOOLIN   DD *
  COUNT FROM(CTL) USING(YEFL) EMPTY RC4
/*
//YEFLCNTL DD *
  INCLUDE COND=(40,1,CH,EQ,C'Y')
/*
//IFYE     IF (YECHK.RC = 0) THEN
//EOD17    EXEC PGM=INT1099
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=SHR
//CUSTMST  DD DSN=CBS.PROD.CUSTMST,DISP=SHR
//TAX1099  DD DSN=CBS.PROD.IRS.TAX1099(+1),DISP=(NEW,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(5,5),RLSE)
//TAXRPT   DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//IFYEEND  ENDIF
//*
//*-------------------------------------------------------------------*
//* EOD18 - EOD19C - RELATIONSHIP BALANCES AND GENERAL LEDGER         *
//*-------------------------------------------------------------------*
//EOD18    EXEC PGM=RELBAL
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=SHR
//CUSTMST  DD DSN=CBS.PROD.CUSTMST,DISP=OLD
//RELBRPT  DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//EOD19A   EXEC PGM=GLEXTR
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//TRANPOST DD DSN=CBS.PROD.TRANPOST.DAILY,DISP=SHR
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=SHR
//GLJRNL   DD DSN=CBS.PROD.GL.JOURNAL(+1),DISP=(NEW,CATLG),
//            UNIT=SYSDA,SPACE=(CYL,(10,10),RLSE)
//GLEXRPT  DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//EOD19B   EXEC PGM=GLTRIAL
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//GLJRNL   DD DSN=CBS.PROD.GL.JOURNAL(+1),DISP=SHR
//GLBAL    DD DSN=CBS.PROD.GLBAL,DISP=OLD
//GLTBRPT  DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//EOD19C   EXEC PGM=GLRECON
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//GLBAL    DD DSN=CBS.PROD.GLBAL,DISP=SHR
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=SHR
//ALERTS   DD DSN=CBS.PROD.ALERTS,DISP=MOD
//GLRCRPT  DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//*-------------------------------------------------------------------*
//* EOD20 - OFAC RE-SCREENING (SDN LIST REFRESHED BY JOB CBSOFACL)    *
//*-------------------------------------------------------------------*
//EOD20    EXEC PGM=OFACBAT
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//SDNLIST  DD DSN=CBS.PROD.OFAC.SDNLIST,DISP=SHR
//CUSTMST  DD DSN=CBS.PROD.CUSTMST,DISP=OLD
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=SHR
//TRANPOST DD DSN=CBS.PROD.TRANPOST.DAILY,DISP=SHR
//ALERTS   DD DSN=CBS.PROD.ALERTS,DISP=MOD
//OFACRPT  DD SYSOUT=(R,,BSA1)
//SYSOUT   DD SYSOUT=*
//*
//*-------------------------------------------------------------------*
//* EOD21A - NEW TRANHIST GENERATION = COPY OF CURRENT GENERATION.    *
//* EOD21 THEN APPENDS TODAY'S TRANPOST TO IT (DISP=MOD).             *
//*-------------------------------------------------------------------*
//EOD21A   EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=CBS.PROD.TRANHIST(0),DISP=SHR
//SYSUT2   DD DSN=CBS.PROD.TRANHIST(+1),DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(500,100),RLSE),
//            DCB=(RECFM=FB,LRECL=281,BLKSIZE=0)
//*
//*-------------------------------------------------------------------*
//* EOD21 - CLOSE THE CYCLE                                           *
//*-------------------------------------------------------------------*
//EOD21    EXEC PGM=EODCTL,PARM='END'
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=OLD
//TRANPOST DD DSN=CBS.PROD.TRANPOST.DAILY,DISP=SHR
//TRANHIST DD DSN=CBS.PROD.TRANHIST(+1),DISP=MOD
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=OLD
//ALERTS   DD DSN=CBS.PROD.ALERTS,DISP=SHR
//EODRPT   DD SYSOUT=(R,,EOD1)
//SYSOUT   DD SYSOUT=*
//*
//*  SUCCESSOR JOBS (SCHEDULER): CBSTHLD (DB2 LOAD CBS.TRAN_HISTORY
//*  FROM TRANHIST(0)), CBSALRTL (ALERTS -> ALERTKS FOR CICS), CBSOPEN
//*  (CEMT SET FILE OPEN), CBSBKUP (IMAGE COPIES).
//
