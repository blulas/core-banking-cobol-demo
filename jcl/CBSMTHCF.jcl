//CBSMTHCF JOB (CBS,CIF),'CIF MONTH-END',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,REGION=0M
//*********************************************************************
//* JOB      : CBSMTHCF                                               *
//* PURPOSE  : CIF MONTH-END - DORMANCY / ESCHEAT (DORMSCAN) THEN     *
//*            PERIODIC KYC REVIEW (KYCREVW). EOD STEP 16 (LAST TWO   *
//*            MONTH-END PROGRAMS, AFTER STMTGEN).                    *
//*            DORMSCAN MUST RUN FIRST - KYCREVW RESTRICTS ONLY       *
//*            ACCOUNTS STILL ACTIVE AFTER DORMANCY CLASSIFICATION.   *
//*            BOTH PROGRAMS EXIT RC 0 ON NON-MONTH-END DATES.        *
//*            RERUN: DORMSCAN IS RESTARTABLE (SKIPS ACCOUNTS ALREADY *
//*            UPDATED TODAY). TO FORCE OFF-CYCLE USE PARM='FORCE'.   *
//* CHANGE LOG                                                        *
//* 2004-02-17 BHS  ORIGINAL                                          *
//* 2018-05-11 AKW  KYCREVW ADDED (FINCEN CDD RULE)                   *
//* 2024-05-20 TKO  KYCREVW READS TRANPOST FOR CASH LOOKBACK          *
//*********************************************************************
//JOBLIB   DD DSN=CBS.PROD.LOADLIB,DISP=SHR
//*
//*--------------------------------------------------------------------
//* STEP010 - BACK UP ACCTMST AND CUSTMST BEFORE UPDATE
//*--------------------------------------------------------------------
//STEP010  EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//ACCTIN   DD DSN=CBS.PROD.ACCTMST,DISP=SHR
//ACCTOUT  DD DSN=CBS.BKUP.ACCTMST.CIF(+1),DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(50,10),RLSE),DCB=(RECFM=VB,LRECL=468)
//CUSTIN   DD DSN=CBS.PROD.CUSTMST,DISP=SHR
//CUSTOUT  DD DSN=CBS.BKUP.CUSTMST.CIF(+1),DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(20,5),RLSE),DCB=(RECFM=VB,LRECL=404)
//SYSIN    DD *
  REPRO INFILE(ACCTIN) OUTFILE(ACCTOUT)
  REPRO INFILE(CUSTIN) OUTFILE(CUSTOUT)
/*
//*
//*--------------------------------------------------------------------
//* STEP020 - DORMSCAN  DORMANCY, DORMANT FEE, ESCHEAT REMITTANCE
//*--------------------------------------------------------------------
//STEP020  EXEC PGM=DORMSCAN,COND=(0,NE,STEP010)
//STEPLIB  DD DSN=CBS.PROD.LOADLIB,DISP=SHR
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=SHR
//ACCTMST1 DD DSN=CBS.PROD.ACCTMST.CUSTAIX.PATH,DISP=SHR
//CUSTMST  DD DSN=CBS.PROD.CUSTMST,DISP=SHR
//HOLDMST  DD DSN=CBS.PROD.HOLDMST,DISP=SHR
//TRANPOST DD DSN=CBS.PROD.TRANPOST.DAILY,DISP=MOD
//ALERTS   DD DSN=CBS.PROD.ALERTS.DAILY,DISP=MOD
//DORMRPT  DD DSN=CBS.PROD.RPT.DORMSCAN(+1),
//            DISP=(NEW,CATLG,DELETE),SPACE=(TRK,(15,15),RLSE),
//            DCB=(RECFM=FB,LRECL=132,BLKSIZE=27984)
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//*
//*--------------------------------------------------------------------
//* STEP030 - KYCREVW  RISK RE-SCORE, RE-TIER, KYC EXPIRY, RESTRICT
//*--------------------------------------------------------------------
//STEP030  EXEC PGM=KYCREVW,COND=(4,LT,STEP020)
//STEPLIB  DD DSN=CBS.PROD.LOADLIB,DISP=SHR
//BANKCTL  DD DSN=CBS.PROD.BANKCTL,DISP=SHR
//CUSTMST  DD DSN=CBS.PROD.CUSTMST,DISP=SHR
//ACCTMST  DD DSN=CBS.PROD.ACCTMST,DISP=SHR
//ACCTMST1 DD DSN=CBS.PROD.ACCTMST.CUSTAIX.PATH,DISP=SHR
//TRANHIST DD DSN=CBS.PROD.TRANHIST(0),DISP=SHR
//TRANPOST DD DSN=CBS.PROD.TRANPOST.DAILY,DISP=SHR
//ALERTS   DD DSN=CBS.PROD.ALERTS.DAILY,DISP=MOD
//KYCRPT   DD DSN=CBS.PROD.RPT.KYCREVW(+1),
//            DISP=(NEW,CATLG,DELETE),SPACE=(TRK,(15,15),RLSE),
//            DCB=(RECFM=FB,LRECL=132,BLKSIZE=27984)
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//*
//*--------------------------------------------------------------------
//* STEP040 - PRINT REPORTS TO COMPLIANCE / UNCLAIMED PROPERTY OPS
//*--------------------------------------------------------------------
//STEP040  EXEC PGM=IEBGENER,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DSN=CBS.PROD.RPT.DORMSCAN(+1),DISP=SHR
//         DD DSN=CBS.PROD.RPT.KYCREVW(+1),DISP=SHR
//SYSUT2   DD SYSOUT=(R,,CIFR)
//SYSIN    DD DUMMY
//
