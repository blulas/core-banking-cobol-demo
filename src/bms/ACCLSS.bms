***********************************************************************
* MAPSET  : ACCLSS    MAP ACCLSM    TRANSACTION CB05 (ACCTCLS)
* PURPOSE : ACCOUNT CLOSURE - QUOTE (PF5) AND CLOSE (PF10)
* CHANGE LOG
* 1995-03-20 RJT  ORIGINAL
* 2012-09-04 DPS  EARLY CLOSURE FEE
* 2016-03-30 DPS  CD PENALTY QUOTE BEFORE CLOSE
***********************************************************************
ACCLSS   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,                   X
               CTRL=(FREEKB,FRSET),STORAGE=AUTO,TIOAPFX=YES,           X
               DSATTS=(COLOR,HILIGHT),MAPATTS=(COLOR,HILIGHT)
ACCLSM   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
TRANID   DFHMDF POS=(01,001),LENGTH=004,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CB05'
TITLE    DFHMDF POS=(01,025),LENGTH=040,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CBS - CLOSE ACCOUNT'
CURDATE  DFHMDF POS=(01,067),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(02,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='---------------------------------------------'
         DFHMDF POS=(03,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ACCOUNT NO.....:'
ACCTNO   DFHMDF POS=(03,019),LENGTH=012,ATTRB=(UNPROT,NORM,IC,FSET),   X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(03,031),LENGTH=001,ATTRB=ASKIP
PRODNM   DFHMDF POS=(03,033),LENGTH=030,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(03,065),LENGTH=003,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ST:'
ASTAT    DFHMDF POS=(03,069),LENGTH=011,ATTRB=(ASKIP,BRT),COLOR=WHITE
         DFHMDF POS=(04,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='OWNER..........:'
OWNER    DFHMDF POS=(04,019),LENGTH=040,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(04,061),LENGTH=007,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='OPENED:'
OPENDT   DFHMDF POS=(04,069),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(05,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PAYOUT ACCOUNT.:'
PAYACT   DFHMDF POS=(05,019),LENGTH=012,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(05,031),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(05,033),LENGTH=013,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='CLOSE REASON:'
RSNCD    DFHMDF POS=(05,047),LENGTH=002,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(05,049),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(05,051),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='WAIVE FEE (MGR):'
WAIVE    DFHMDF POS=(05,068),LENGTH=001,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(05,069),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(07,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='LEDGER BALANCE.:'
LEDGER   DFHMDF POS=(07,019),LENGTH=018,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(08,002),LENGTH=017,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ACCRUED INTEREST:'
ACCRINT  DFHMDF POS=(08,020),LENGTH=017,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(09,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='CD PENALTY.....:'
PENALTY  DFHMDF POS=(09,019),LENGTH=018,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(10,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='EARLY CLOSE FEE:'
ECFEE    DFHMDF POS=(10,019),LENGTH=018,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(11,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='NET DISBURSED..:'
NETAMT   DFHMDF POS=(11,019),LENGTH=018,ATTRB=(ASKIP,BRT),COLOR=WHITE
         DFHMDF POS=(13,002),LENGTH=015,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='CLOSURE CHECKS:'
CHK01    DFHMDF POS=(14,004),LENGTH=075,ATTRB=(ASKIP,BRT),COLOR=WHITE
CHK02    DFHMDF POS=(15,004),LENGTH=075,ATTRB=(ASKIP,BRT),COLOR=WHITE
CHK03    DFHMDF POS=(16,004),LENGTH=075,ATTRB=(ASKIP,BRT),COLOR=WHITE
CHK04    DFHMDF POS=(17,004),LENGTH=075,ATTRB=(ASKIP,BRT),COLOR=WHITE
CHK05    DFHMDF POS=(18,004),LENGTH=075,ATTRB=(ASKIP,BRT),COLOR=WHITE
         DFHMDF POS=(20,002),LENGTH=007,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='STATUS:'
CLSSTAT  DFHMDF POS=(20,010),LENGTH=040,ATTRB=(ASKIP,BRT),COLOR=WHITE
MSG      DFHMDF POS=(23,001),LENGTH=079,ATTRB=(ASKIP,BRT,FSET),        X
               COLOR=YELLOW
PFKEYS   DFHMDF POS=(24,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE
         DFHMSD TYPE=FINAL
         END
