***********************************************************************
* MAPSET  : ACINQS    MAP ACINQM    TRANSACTION CB04 (ACCTINQ)
* PURPOSE : ACCOUNT BALANCES, HOLDS AND TRANSACTION HISTORY
* CHANGE LOG
* 1995-03-20 RJT  ORIGINAL
* 2004-06-14 BHS  HISTORY FROM DB2 CBS.TRAN_HISTORY
***********************************************************************
ACINQS   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,                   X
               CTRL=(FREEKB,FRSET),STORAGE=AUTO,TIOAPFX=YES,           X
               DSATTS=(COLOR,HILIGHT),MAPATTS=(COLOR,HILIGHT)
ACINQM   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
TRANID   DFHMDF POS=(01,001),LENGTH=004,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CB04'
TITLE    DFHMDF POS=(01,025),LENGTH=040,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CBS - ACCOUNT INQUIRY'
CURDATE  DFHMDF POS=(01,067),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(02,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='---------------------------------------------'
         DFHMDF POS=(03,002),LENGTH=012,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ACCOUNT NO.:'
ACCTNO   DFHMDF POS=(03,015),LENGTH=012,ATTRB=(UNPROT,NORM,IC,FSET),   X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(03,027),LENGTH=001,ATTRB=ASKIP
PRODNM   DFHMDF POS=(03,029),LENGTH=030,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(03,061),LENGTH=007,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='STATUS:'
ASTAT    DFHMDF POS=(03,069),LENGTH=011,ATTRB=(ASKIP,BRT),COLOR=WHITE
         DFHMDF POS=(04,002),LENGTH=012,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='OWNER......:'
OWNER    DFHMDF POS=(04,015),LENGTH=040,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(04,057),LENGTH=007,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='OPENED:'
OPENDT   DFHMDF POS=(04,065),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(05,002),LENGTH=012,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='JOINT......:'
JOINT    DFHMDF POS=(05,015),LENGTH=040,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(05,057),LENGTH=009,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='LAST ACT:'
LASTACT  DFHMDF POS=(05,067),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(06,002),LENGTH=012,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='LEDGER BAL.:'
LEDGER   DFHMDF POS=(06,015),LENGTH=018,ATTRB=(ASKIP,BRT),COLOR=WHITE
         DFHMDF POS=(06,036),LENGTH=010,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='AVAILABLE:'
AVAIL    DFHMDF POS=(06,047),LENGTH=018,ATTRB=(ASKIP,BRT),COLOR=WHITE
         DFHMDF POS=(07,002),LENGTH=012,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='HOLDS......:'
HOLDAMT  DFHMDF POS=(07,015),LENGTH=018,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(07,036),LENGTH=010,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ACCRUED..:'
ACCRINT  DFHMDF POS=(07,047),LENGTH=018,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(08,002),LENGTH=012,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='RATE.......:'
RATE     DFHMDF POS=(08,015),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(08,027),LENGTH=006,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PROMO:'
PROMO    DFHMDF POS=(08,034),LENGTH=022,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(08,058),LENGTH=007,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='OD LIM:'
ODLIM    DFHMDF POS=(08,066),LENGTH=013,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(09,002),LENGTH=012,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='MATURITY...:'
MATDT    DFHMDF POS=(09,015),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(09,027),LENGTH=009,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='REG D WD:'
REGDWD   DFHMDF POS=(09,037),LENGTH=003,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(09,042),LENGTH=010,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='OD OPT-IN:'
ODOPT    DFHMDF POS=(09,053),LENGTH=001,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(09,056),LENGTH=008,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='NSF 12M:'
NSFCNT   DFHMDF POS=(09,065),LENGTH=003,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(10,002),LENGTH=012,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ACTIVE HOLD:'
HOLDLN   DFHMDF POS=(10,015),LENGTH=064,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(11,002),LENGTH=040,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='POST DATE  CODE D/C          AMOUNT  CHA'
         DFHMDF POS=(11,042),LENGTH=013,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='N DESCRIPTION'
TLN01    DFHMDF POS=(12,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
TLN02    DFHMDF POS=(13,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
TLN03    DFHMDF POS=(14,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
TLN04    DFHMDF POS=(15,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
TLN05    DFHMDF POS=(16,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
TLN06    DFHMDF POS=(17,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
TLN07    DFHMDF POS=(18,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
TLN08    DFHMDF POS=(19,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
TLN09    DFHMDF POS=(20,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
TLN10    DFHMDF POS=(21,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(22,002),LENGTH=005,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PAGE:'
PAGENO   DFHMDF POS=(22,008),LENGTH=003,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
MSG      DFHMDF POS=(23,001),LENGTH=079,ATTRB=(ASKIP,BRT,FSET),        X
               COLOR=YELLOW
PFKEYS   DFHMDF POS=(24,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE
         DFHMSD TYPE=FINAL
         END
