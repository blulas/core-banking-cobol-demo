***********************************************************************
* MAPSET  : ACOPNS    MAP ACOPNM    TRANSACTION CB03 (ACCTOPEN)
* PURPOSE : DEPOSIT ACCOUNT OPENING
* CHANGE LOG
* 1995-03-20 RJT  ORIGINAL
* 2009-11-17 DPS  REG E OD OPT-IN FIELD
* 2017-02-08 AKW  RATE / APY DISCLOSURE FROM RATETIER
***********************************************************************
ACOPNS   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,                   X
               CTRL=(FREEKB,FRSET),STORAGE=AUTO,TIOAPFX=YES,           X
               DSATTS=(COLOR,HILIGHT),MAPATTS=(COLOR,HILIGHT)
ACOPNM   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
TRANID   DFHMDF POS=(01,001),LENGTH=004,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CB03'
TITLE    DFHMDF POS=(01,025),LENGTH=040,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CBS - OPEN ACCOUNT'
CURDATE  DFHMDF POS=(01,067),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(02,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='---------------------------------------------'
         DFHMDF POS=(03,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='CUSTOMER ID....:'
CUSTID   DFHMDF POS=(03,019),LENGTH=010,ATTRB=(UNPROT,NORM,IC,FSET),   X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(03,029),LENGTH=001,ATTRB=ASKIP
CNAME    DFHMDF POS=(03,031),LENGTH=040,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(04,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PRODUCT CODE...:'
PRODCD   DFHMDF POS=(04,019),LENGTH=004,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(04,023),LENGTH=001,ATTRB=ASKIP
PRODNM   DFHMDF POS=(04,031),LENGTH=030,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(05,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='JOINT OWNER ID.:'
JOINTID  DFHMDF POS=(05,019),LENGTH=010,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(05,029),LENGTH=001,ATTRB=ASKIP
JNAME    DFHMDF POS=(05,031),LENGTH=040,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(06,002),LENGTH=018,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='OWNERSHIP S/J/T/C:'
OWNTYP   DFHMDF POS=(06,021),LENGTH=001,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(06,022),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(07,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='INITIAL DEPOSIT:'
DEPAMT   DFHMDF POS=(07,019),LENGTH=015,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(07,034),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(07,037),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='FUNDING ACCOUNT:'
FUNDACT  DFHMDF POS=(07,054),LENGTH=012,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(07,066),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(08,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='OD OPT-IN (Y/N):'
ODOPTIN  DFHMDF POS=(08,019),LENGTH=001,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(08,020),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(08,023),LENGTH=039,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='REG E - DEFAULT N FOR PERSONAL CHECKING'
         DFHMDF POS=(09,002),LENGTH=017,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='CD RENEWAL A/M/C:'
RENEW    DFHMDF POS=(09,020),LENGTH=001,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(09,021),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(09,024),LENGTH=015,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PAYOUT ACCOUNT:'
PAYACT   DFHMDF POS=(09,040),LENGTH=012,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(09,052),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(11,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ELIGIBILITY....:'
ELIGDSC  DFHMDF POS=(11,019),LENGTH=060,ATTRB=(ASKIP,BRT),COLOR=WHITE
         DFHMDF POS=(12,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='DECLINE REASONS:'
DECLN1   DFHMDF POS=(12,019),LENGTH=060,ATTRB=(ASKIP,BRT),COLOR=WHITE
DECLN2   DFHMDF POS=(13,019),LENGTH=060,ATTRB=(ASKIP,BRT),COLOR=WHITE
         DFHMDF POS=(15,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='RATE...........:'
RATE     DFHMDF POS=(15,019),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(15,032),LENGTH=004,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='APY:'
APY      DFHMDF POS=(15,037),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(15,050),LENGTH=005,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='TIER:'
RTTIER   DFHMDF POS=(15,056),LENGTH=004,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(16,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='OD LIMIT.......:'
ODLIM    DFHMDF POS=(16,019),LENGTH=012,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(16,032),LENGTH=009,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='MATURITY:'
MATDT    DFHMDF POS=(16,042),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(18,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='NEW ACCOUNT NO.:'
NEWACCT  DFHMDF POS=(18,019),LENGTH=012,ATTRB=(ASKIP,BRT),COLOR=WHITE
         DFHMDF POS=(18,034),LENGTH=009,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='KYC TIER:'
KTIER    DFHMDF POS=(18,044),LENGTH=001,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(18,048),LENGTH=012,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='NEXT REVIEW:'
KREVDT   DFHMDF POS=(18,061),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
MSG      DFHMDF POS=(23,001),LENGTH=079,ATTRB=(ASKIP,BRT,FSET),        X
               COLOR=YELLOW
PFKEYS   DFHMDF POS=(24,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE
         DFHMSD TYPE=FINAL
         END
