***********************************************************************
* MAPSET   : ALRTWKS                                                   *
* MAP      : ALRTWKM                                                   *
* TRANS    : CB60 - ALERT WORK QUEUE                                   *
* BROWSE OF VSAM KSDS ALERTKS (LOADED BY JOB CBSCOMPL STEP CMP060).   *
* S = SELECT A ROW; DISPOSITION C CLOSED / E ESCALATED / S SAR FILED. *
* CHANGE LOG                                                          *
* 2013-05-13 DPS  ORIGINAL                                            *
* 2017-02-20 AKW  CHG1544 SAR DUE DATE AND AGE COLUMNS                *
***********************************************************************
ALRTWKS  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,      X
               CTRL=(FREEKB,FRSET),TIOAPFX=YES,MAPATTS=(COLOR,HILIGHT),X
               DSATTS=(COLOR,HILIGHT)
ALRTWKM  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,2),LENGTH=4,ATTRB=(ASKIP,BRT),COLOR=BLUE,       X
               INITIAL='CB60'
         DFHMDF POS=(1,24),LENGTH=22,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL,  X
               INITIAL='CBS - ALERT WORK QUEUE'
CURDATE  DFHMDF POS=(1,70),LENGTH=10,ATTRB=ASKIP,COLOR=TURQUOISE
USERID   DFHMDF POS=(2,70),LENGTH=8,ATTRB=ASKIP,COLOR=TURQUOISE
         DFHMDF POS=(3,2),LENGTH=5,ATTRB=ASKIP,COLOR=GREEN,            X
               INITIAL='TYPE:'
FTYPE    DFHMDF POS=(3,8),LENGTH=4,ATTRB=(UNPROT,FSET),COLOR=YELLOW
         DFHMDF POS=(3,12),LENGTH=1,ATTRB=ASKIP
         DFHMDF POS=(3,15),LENGTH=16,ATTRB=ASKIP,COLOR=GREEN,          X
               INITIAL='OPEN ONLY (Y/N):'
FOPEN    DFHMDF POS=(3,32),LENGTH=1,ATTRB=(UNPROT,FSET),COLOR=YELLOW
         DFHMDF POS=(3,33),LENGTH=1,ATTRB=ASKIP
         DFHMDF POS=(3,36),LENGTH=10,ATTRB=ASKIP,COLOR=GREEN,          X
               INITIAL='FROM DATE:'
FDATE    DFHMDF POS=(3,47),LENGTH=8,ATTRB=(UNPROT,NUM,FSET),           X
               COLOR=YELLOW
         DFHMDF POS=(3,55),LENGTH=1,ATTRB=ASKIP
         DFHMDF POS=(5,2),LENGTH=76,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL,   X
               INITIAL='S DATE     TYPE SEV CUST-ID    ACCOUNT         X
                 AMOUNT  AGE SAR-DUE  D'
SEL01    DFHMDF POS=(6,2),LENGTH=1,ATTRB=(UNPROT,FSET),COLOR=YELLOW
         DFHMDF POS=(6,3),LENGTH=1,ATTRB=ASKIP
LIN01    DFHMDF POS=(6,4),LENGTH=75,ATTRB=ASKIP,COLOR=GREEN
SEL02    DFHMDF POS=(7,2),LENGTH=1,ATTRB=(UNPROT,FSET),COLOR=YELLOW
         DFHMDF POS=(7,3),LENGTH=1,ATTRB=ASKIP
LIN02    DFHMDF POS=(7,4),LENGTH=75,ATTRB=ASKIP,COLOR=GREEN
SEL03    DFHMDF POS=(8,2),LENGTH=1,ATTRB=(UNPROT,FSET),COLOR=YELLOW
         DFHMDF POS=(8,3),LENGTH=1,ATTRB=ASKIP
LIN03    DFHMDF POS=(8,4),LENGTH=75,ATTRB=ASKIP,COLOR=GREEN
SEL04    DFHMDF POS=(9,2),LENGTH=1,ATTRB=(UNPROT,FSET),COLOR=YELLOW
         DFHMDF POS=(9,3),LENGTH=1,ATTRB=ASKIP
LIN04    DFHMDF POS=(9,4),LENGTH=75,ATTRB=ASKIP,COLOR=GREEN
SEL05    DFHMDF POS=(10,2),LENGTH=1,ATTRB=(UNPROT,FSET),COLOR=YELLOW
         DFHMDF POS=(10,3),LENGTH=1,ATTRB=ASKIP
LIN05    DFHMDF POS=(10,4),LENGTH=75,ATTRB=ASKIP,COLOR=GREEN
SEL06    DFHMDF POS=(11,2),LENGTH=1,ATTRB=(UNPROT,FSET),COLOR=YELLOW
         DFHMDF POS=(11,3),LENGTH=1,ATTRB=ASKIP
LIN06    DFHMDF POS=(11,4),LENGTH=75,ATTRB=ASKIP,COLOR=GREEN
SEL07    DFHMDF POS=(12,2),LENGTH=1,ATTRB=(UNPROT,FSET),COLOR=YELLOW
         DFHMDF POS=(12,3),LENGTH=1,ATTRB=ASKIP
LIN07    DFHMDF POS=(12,4),LENGTH=75,ATTRB=ASKIP,COLOR=GREEN
SEL08    DFHMDF POS=(13,2),LENGTH=1,ATTRB=(UNPROT,FSET),COLOR=YELLOW
         DFHMDF POS=(13,3),LENGTH=1,ATTRB=ASKIP
LIN08    DFHMDF POS=(13,4),LENGTH=75,ATTRB=ASKIP,COLOR=GREEN
SEL09    DFHMDF POS=(14,2),LENGTH=1,ATTRB=(UNPROT,FSET),COLOR=YELLOW
         DFHMDF POS=(14,3),LENGTH=1,ATTRB=ASKIP
LIN09    DFHMDF POS=(14,4),LENGTH=75,ATTRB=ASKIP,COLOR=GREEN
SEL10    DFHMDF POS=(15,2),LENGTH=1,ATTRB=(UNPROT,FSET),COLOR=YELLOW
         DFHMDF POS=(15,3),LENGTH=1,ATTRB=ASKIP
LIN10    DFHMDF POS=(15,4),LENGTH=75,ATTRB=ASKIP,COLOR=GREEN
         DFHMDF POS=(17,2),LENGTH=6,ATTRB=ASKIP,COLOR=GREEN,           X
               INITIAL='ALERT:'
DALRTID  DFHMDF POS=(17,9),LENGTH=14,ATTRB=ASKIP,COLOR=TURQUOISE
DDESC    DFHMDF POS=(17,24),LENGTH=56,ATTRB=ASKIP,COLOR=TURQUOISE
         DFHMDF POS=(18,2),LENGTH=9,ATTRB=ASKIP,COLOR=GREEN,           X
               INITIAL='DETECTED:'
DDETECT  DFHMDF POS=(18,12),LENGTH=8,ATTRB=ASKIP,COLOR=TURQUOISE
         DFHMDF POS=(18,21),LENGTH=8,ATTRB=ASKIP,COLOR=GREEN,          X
               INITIAL='SAR DUE:'
DSARDUE  DFHMDF POS=(18,30),LENGTH=8,ATTRB=ASKIP,COLOR=TURQUOISE
         DFHMDF POS=(18,40),LENGTH=4,ATTRB=ASKIP,COLOR=GREEN,          X
               INITIAL='AGE:'
DAGE     DFHMDF POS=(18,45),LENGTH=4,ATTRB=ASKIP,COLOR=TURQUOISE
         DFHMDF POS=(18,51),LENGTH=7,ATTRB=ASKIP,COLOR=GREEN,          X
               INITIAL='STATUS:'
DSTAT    DFHMDF POS=(18,59),LENGTH=20,ATTRB=ASKIP,COLOR=TURQUOISE
         DFHMDF POS=(19,2),LENGTH=20,ATTRB=ASKIP,COLOR=GREEN,          X
               INITIAL='DISPOSITION (C/E/S):'
DISP     DFHMDF POS=(19,23),LENGTH=1,ATTRB=(UNPROT,FSET),COLOR=YELLOW
         DFHMDF POS=(19,24),LENGTH=1,ATTRB=ASKIP
         DFHMDF POS=(19,26),LENGTH=20,ATTRB=ASKIP,COLOR=GREEN,         X
               INITIAL='SUSPECT KNOWN (Y/N):'
SUSP     DFHMDF POS=(19,47),LENGTH=1,ATTRB=(UNPROT,FSET),COLOR=YELLOW
         DFHMDF POS=(19,48),LENGTH=1,ATTRB=ASKIP
         DFHMDF POS=(19,50),LENGTH=7,ATTRB=ASKIP,COLOR=GREEN,          X
               INITIAL='SAR ID:'
SARID    DFHMDF POS=(19,58),LENGTH=14,ATTRB=(UNPROT,FSET),COLOR=YELLOW
         DFHMDF POS=(19,72),LENGTH=1,ATTRB=ASKIP
         DFHMDF POS=(20,2),LENGTH=6,ATTRB=ASKIP,COLOR=GREEN,           X
               INITIAL='NOTES:'
NOTES    DFHMDF POS=(20,9),LENGTH=60,ATTRB=(UNPROT,FSET),COLOR=YELLOW
         DFHMDF POS=(20,69),LENGTH=1,ATTRB=ASKIP
MSG      DFHMDF POS=(23,2),LENGTH=78,ATTRB=(ASKIP,BRT),COLOR=RED
         DFHMDF POS=(24,2),LENGTH=70,ATTRB=ASKIP,COLOR=BLUE,           X
               INITIAL='PF3=MENU  PF7=BACK  PF8=FORWARD  ENTER=SELECT/UX
               PDATE  PF12=CANCEL'
         DFHMSD TYPE=FINAL
         END
