***********************************************************************
* MAPSET  : CBMNUS    MAP CBMNUM    TRANSACTION CB00 (CBMENU)
* PURPOSE : CORE BANKING SYSTEM MAIN MENU - ALL FUNCTIONS
* CHANGE LOG
* 1995-03-20 RJT  ORIGINAL
* 2011-04-12 DPS  TREASURY FUNCTIONS (CB50-CB52)
* 2019-02-11 AKW  ROLE-BASED MENU (CHG1777)
***********************************************************************
CBMNUS   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,                   X
               CTRL=(FREEKB,FRSET),STORAGE=AUTO,TIOAPFX=YES,           X
               DSATTS=(COLOR,HILIGHT),MAPATTS=(COLOR,HILIGHT)
CBMNUM   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
TRANID   DFHMDF POS=(01,001),LENGTH=004,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CB00'
TITLE    DFHMDF POS=(01,025),LENGTH=040,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CBS - MAIN MENU'
CURDATE  DFHMDF POS=(01,067),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(02,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='---------------------------------------------'
         DFHMDF POS=(03,002),LENGTH=030,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='CUSTOMER / DEPOSITS / PAYMENTS'
         DFHMDF POS=(03,042),LENGTH=031,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='LENDING / TREASURY / COMPLIANCE'
OPT01    DFHMDF POS=(04,003),LENGTH=036,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
OPT02    DFHMDF POS=(05,003),LENGTH=036,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
OPT03    DFHMDF POS=(06,003),LENGTH=036,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
OPT04    DFHMDF POS=(07,003),LENGTH=036,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
OPT05    DFHMDF POS=(08,003),LENGTH=036,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
OPT06    DFHMDF POS=(09,003),LENGTH=036,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
OPT07    DFHMDF POS=(10,003),LENGTH=036,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
OPT08    DFHMDF POS=(11,003),LENGTH=036,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
OPT09    DFHMDF POS=(12,003),LENGTH=036,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
OPT10    DFHMDF POS=(13,003),LENGTH=036,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
OPT11    DFHMDF POS=(14,003),LENGTH=036,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
OPT12    DFHMDF POS=(04,043),LENGTH=036,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
OPT13    DFHMDF POS=(05,043),LENGTH=036,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
OPT14    DFHMDF POS=(06,043),LENGTH=036,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
OPT15    DFHMDF POS=(07,043),LENGTH=036,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
OPT16    DFHMDF POS=(08,043),LENGTH=036,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
OPT17    DFHMDF POS=(09,043),LENGTH=036,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
OPT18    DFHMDF POS=(10,043),LENGTH=036,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
OPT19    DFHMDF POS=(11,043),LENGTH=036,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
OPT20    DFHMDF POS=(12,043),LENGTH=036,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
OPT21    DFHMDF POS=(13,043),LENGTH=036,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
OPT22    DFHMDF POS=(14,043),LENGTH=036,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(17,003),LENGTH=033,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='SELECTION (TRAN ID OR 01-22) ===>'
CHOICE   DFHMDF POS=(17,037),LENGTH=004,ATTRB=(UNPROT,NORM,IC,FSET),   X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(17,041),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(19,003),LENGTH=005,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='USER:'
USERID   DFHMDF POS=(19,009),LENGTH=008,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(19,020),LENGTH=005,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ROLE:'
ROLEDSC  DFHMDF POS=(19,026),LENGTH=020,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(19,048),LENGTH=009,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='BUS DATE:'
BUSDT    DFHMDF POS=(19,058),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(20,003),LENGTH=042,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='UNLISTED FUNCTIONS NOT AUTHORISED FOR ROLE'
MSG      DFHMDF POS=(23,001),LENGTH=079,ATTRB=(ASKIP,BRT,FSET),        X
               COLOR=YELLOW
PFKEYS   DFHMDF POS=(24,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE
         DFHMSD TYPE=FINAL
         END
