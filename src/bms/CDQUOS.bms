***********************************************************************
* MAPSET  : CDQUOS   MAP CDQUOM   TRANSACTION CB21 (CDQUOTE)
* PURPOSE : QUOTE THE EARLY WITHDRAWAL PENALTY AND NET PROCEEDS FOR A CD
* CHANGE LOG
* 1997-06-02 RJT  ORIGINAL
* 2004-11-15 BHS  GRACE PERIOD DISPLAY
* 2017-02-08 AKW  NO-PENALTY CD
***********************************************************************
CDQUOS   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,                   X
               CTRL=(FREEKB,FRSET),STORAGE=AUTO,TIOAPFX=YES,           X
               DSATTS=(COLOR,HILIGHT),MAPATTS=(COLOR,HILIGHT)
CDQUOM   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
TRANID   DFHMDF POS=(01,001),LENGTH=004,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CB21'
TITLE    DFHMDF POS=(01,025),LENGTH=040,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CBS - CD EARLY WITHDRAWAL QUOTE'
CURDATE  DFHMDF POS=(01,067),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(02,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='---------------------------------------------'
         DFHMDF POS=(03,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='CD ACCOUNT.....:'
ACCTNO   DFHMDF POS=(03,019),LENGTH=012,ATTRB=(UNPROT,NORM,FSET,IC),   X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(03,031),LENGTH=001,ATTRB=ASKIP
OWNER    DFHMDF POS=(03,034),LENGTH=030,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(04,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='WITHDRAW AMOUNT:'
WDAMT    DFHMDF POS=(04,019),LENGTH=015,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(04,034),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(04,037),LENGTH=014,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='(BLANK = FULL)'
         DFHMDF POS=(05,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='WITHDRAW DATE..:'
WDDATE   DFHMDF POS=(05,019),LENGTH=008,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(05,027),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(05,030),LENGTH=025,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='(CCYYMMDD, BLANK = TODAY)'
         DFHMDF POS=(07,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PRODUCT........:'
PRODCD   DFHMDF POS=(07,019),LENGTH=004,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
PRODNM   DFHMDF POS=(07,024),LENGTH=030,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(08,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PRINCIPAL......:'
PRINC    DFHMDF POS=(08,019),LENGTH=017,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(08,040),LENGTH=014,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='RATE %.......:'
RATE     DFHMDF POS=(08,055),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(09,002),LENGTH=017,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='FUNDED / RENEWED:'
FUNDDT   DFHMDF POS=(09,020),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(09,040),LENGTH=014,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='MATURITY.....:'
MATDT    DFHMDF POS=(09,055),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(10,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='GRACE ENDS.....:'
GRACDT   DFHMDF POS=(10,019),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(10,040),LENGTH=014,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='TERM (MONTHS):'
TERM     DFHMDF POS=(10,055),LENGTH=003,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(11,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ACCRUED INT....:'
ACCINT   DFHMDF POS=(11,019),LENGTH=017,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(13,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PENALTY DAYS...:'
PENDAYS  DFHMDF POS=(13,019),LENGTH=003,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(13,040),LENGTH=014,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='WAIVER CODE..:'
WAIVER   DFHMDF POS=(13,055),LENGTH=002,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(14,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PENALTY........:'
PENAMT   DFHMDF POS=(14,019),LENGTH=017,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(15,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='  FROM INTEREST:'
PENINT   DFHMDF POS=(15,019),LENGTH=017,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(16,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='  FROM PRINCIPL:'
PENPRN   DFHMDF POS=(16,019),LENGTH=017,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(18,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='NET PROCEEDS...:'
NETAMT   DFHMDF POS=(18,019),LENGTH=017,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
NOTE     DFHMDF POS=(20,002),LENGTH=077,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
MSG      DFHMDF POS=(23,001),LENGTH=079,ATTRB=(ASKIP,BRT),COLOR=YELLOW
         DFHMDF POS=(24,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ENTER=QUOTE  PF3=MENU  PF12=CANCEL'
         DFHMSD TYPE=FINAL
         END
