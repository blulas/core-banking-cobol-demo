* MAPSET  : CMPOSIS   MAP CMPOSIM   TRANSACTION CB50
* PURPOSE : CASH POSITION FOR A CORPORATE CUSTOMER - BALANCES,
*           PROJECTED EOD SWEEPS AND NOTIONAL POOL POSITION
* CHANGE LOG
* 2001-10-01 BHS  ORIGINAL
* 2011-04-12 DPS  PROJECTED SWEEP COLUMN - CHG1544
* 2019-03-25 AKW  VIRTUAL ACCOUNTS SHOWN WITH V MARKER
CMPOSIS  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,                   X
               CTRL=(FREEKB,FRSET),STORAGE=AUTO,TIOAPFX=YES,           X
               MAPATTS=(COLOR,HILIGHT)
CMPOSIM  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(01,001),LENGTH=004,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CB50'
TITLE    DFHMDF POS=(01,025),LENGTH=040,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CBS - CORPORATE CASH POSITION'
CURDATE  DFHMDF POS=(01,067),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(03,001),LENGTH=012,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='CUSTOMER ID:'
CUSTID   DFHMDF POS=(03,014),LENGTH=010,ATTRB=(UNPROT,NORM,IC,FSET),   X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(03,025),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(03,030),LENGTH=005,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='NAME:'
CUSTNM   DFHMDF POS=(03,036),LENGTH=030,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(04,001),LENGTH=008,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='SEGMENT:'
SEGMT    DFHMDF POS=(04,010),LENGTH=002,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(04,014),LENGTH=013,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='RELATIONSHIP:'
RELID    DFHMDF POS=(04,028),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(04,042),LENGTH=014,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='BUSINESS DATE:'
BUSDT    DFHMDF POS=(04,057),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(06,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ACCOUNT      PROD    LEDGER BALANCE    AVAILABLX
               E BAL    COLLECTED BAL  PROJ SWEEP'
ACLN01   DFHMDF POS=(07,001),LENGTH=079,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
ACLN02   DFHMDF POS=(08,001),LENGTH=079,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
ACLN03   DFHMDF POS=(09,001),LENGTH=079,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
ACLN04   DFHMDF POS=(10,001),LENGTH=079,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
ACLN05   DFHMDF POS=(11,001),LENGTH=079,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
ACLN06   DFHMDF POS=(12,001),LENGTH=079,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
ACLN07   DFHMDF POS=(13,001),LENGTH=079,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
ACLN08   DFHMDF POS=(14,001),LENGTH=079,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
ACLN09   DFHMDF POS=(15,001),LENGTH=079,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
ACLN10   DFHMDF POS=(16,001),LENGTH=079,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(18,001),LENGTH=013,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='TOTAL LEDGER:'
TOTLED   DFHMDF POS=(18,015),LENGTH=017,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(18,040),LENGTH=012,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='TOTAL AVAIL:'
TOTAVL   DFHMDF POS=(18,053),LENGTH=017,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(19,001),LENGTH=013,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PROJ SWEEPS :'
TOTSWP   DFHMDF POS=(19,015),LENGTH=017,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(19,040),LENGTH=005,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='POOL:'
POOLID   DFHMDF POS=(19,046),LENGTH=008,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(20,001),LENGTH=013,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='POOL NET POS:'
POOLNET  DFHMDF POS=(20,015),LENGTH=017,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(20,040),LENGTH=012,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='POOL CR/DR :'
PLRATE   DFHMDF POS=(20,053),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(21,001),LENGTH=013,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PROJ MTH INT:'
PLINT    DFHMDF POS=(21,015),LENGTH=017,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(21,040),LENGTH=012,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PAGE       :'
PAGENO   DFHMDF POS=(21,053),LENGTH=003,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(24,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ENTER=INQUIRE  PF3=MENU  PF7=BACK  PF8=FORWARD X
                PF12=CANCEL'
MSG      DFHMDF POS=(23,001),LENGTH=079,ATTRB=(ASKIP,BRT),COLOR=YELLOW
         DFHMSD TYPE=FINAL
         END
