***********************************************************************
* MAPSET  : CRLSTS   MAP CRLSTM   TRANSACTION CR91
* PURPOSE : CBS - PROPRIETARY CREDIT CARD
* CHANGE LOG
* 1995-11-16 CRP  ORIGINAL
***********************************************************************
CRLSTS   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,CTRL=(FREEKB,      X
               FRSET),STORAGE=AUTO,TIOAPFX=YES,DSATTS=(COLOR,          X
               HILIGHT),MAPATTS=(COLOR,HILIGHT)
CRLSTM   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
TRANID   DFHMDF POS=(01,001),LENGTH=004,ATTRB=(ASKIP,BRT),             X
               COLOR=WHITE,INITIAL='CR91'
TITLE    DFHMDF POS=(01,025),LENGTH=040,ATTRB=(ASKIP,BRT),             X
               COLOR=WHITE,INITIAL='CBS - PROPRIETARY CREDIT CARD'
CURDATE  DFHMDF POS=(01,067),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(03,002),LENGTH=004,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='KEY:'
KEY      DFHMDF POS=(03,020),LENGTH=012,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(03,033),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(04,002),LENGTH=013,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='LATE FEE AMT:'
LATEFE   DFHMDF POS=(04,020),LENGTH=016,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(05,002),LENGTH=012,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='NOTICE DATE:'
NOTICE   DFHMDF POS=(05,020),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(06,002),LENGTH=014,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='BILL CYCLE CD:'
BILLCY   DFHMDF POS=(06,020),LENGTH=001,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(07,002),LENGTH=012,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='FINANCE YTD:'
FINANC   DFHMDF POS=(07,020),LENGTH=016,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(08,002),LENGTH=005,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='NAME:'
NAME     DFHMDF POS=(08,020),LENGTH=030,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(09,002),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='STOP FLAG:'
STOPFL   DFHMDF POS=(09,020),LENGTH=001,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(10,002),LENGTH=008,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='CONTACT:'
CONTAC   DFHMDF POS=(10,020),LENGTH=020,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(11,002),LENGTH=012,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='PENALTY PCT:'
PENALT   DFHMDF POS=(11,020),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(12,002),LENGTH=013,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='LATE FEE YTD:'
LATEFE1  DFHMDF POS=(12,020),LENGTH=016,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(12,037),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(13,002),LENGTH=008,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='TYPE CD:'
TYPECD   DFHMDF POS=(13,020),LENGTH=002,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(14,002),LENGTH=013,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='CARD TYPE CD:'
CARDTY   DFHMDF POS=(14,020),LENGTH=003,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(15,002),LENGTH=016,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='AUTO RENEW FLAG:'
AUTORE   DFHMDF POS=(15,020),LENGTH=001,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(15,022),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(16,002),LENGTH=005,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='RATE:'
RATE     DFHMDF POS=(16,020),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
MSG      DFHMDF POS=(23,001),LENGTH=079,ATTRB=(ASKIP,BRT),             X
               COLOR=YELLOW
         DFHMDF POS=(24,001),LENGTH=079,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,                                             X
               INITIAL='ENTER=PROCESS  PF3=MENU  PF12=CANCEL'
         DFHMSD TYPE=FINAL
         END
