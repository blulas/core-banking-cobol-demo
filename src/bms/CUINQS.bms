***********************************************************************
* MAPSET  : CUINQS    MAP CUINQM    TRANSACTION CB01 (CUSTINQ)
* PURPOSE : CUSTOMER PROFILE, KYC / RISK / OFAC AND ACCOUNTS
* CHANGE LOG
* 1995-03-20 RJT  ORIGINAL
* 2006-08-30 BHS  PEP AND OFAC FIELDS
* 2018-05-11 AKW  KYC TIER / REVIEW DATE
***********************************************************************
CUINQS   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,                   X
               CTRL=(FREEKB,FRSET),STORAGE=AUTO,TIOAPFX=YES,           X
               DSATTS=(COLOR,HILIGHT),MAPATTS=(COLOR,HILIGHT)
CUINQM   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
TRANID   DFHMDF POS=(01,001),LENGTH=004,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CB01'
TITLE    DFHMDF POS=(01,025),LENGTH=040,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CBS - CUSTOMER INQUIRY'
CURDATE  DFHMDF POS=(01,067),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(02,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='---------------------------------------------'
         DFHMDF POS=(03,002),LENGTH=012,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='CUSTOMER ID:'
CUSTID   DFHMDF POS=(03,015),LENGTH=010,ATTRB=(UNPROT,NORM,IC,FSET),   X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(03,025),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(04,002),LENGTH=011,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='NAME......:'
CNAME    DFHMDF POS=(04,014),LENGTH=040,ATTRB=(ASKIP,BRT),COLOR=WHITE
         DFHMDF POS=(04,056),LENGTH=005,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='TYPE:'
CTYPE    DFHMDF POS=(04,062),LENGTH=012,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(05,002),LENGTH=011,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='STATUS....:'
CSTAT    DFHMDF POS=(05,014),LENGTH=012,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(05,028),LENGTH=008,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='SEGMENT:'
CSEG     DFHMDF POS=(05,037),LENGTH=016,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(05,056),LENGTH=006,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='SINCE:'
CSINCE   DFHMDF POS=(05,063),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(06,002),LENGTH=011,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ADDRESS...:'
CADDR    DFHMDF POS=(06,014),LENGTH=060,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(07,002),LENGTH=011,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PHONE.....:'
CPHONE   DFHMDF POS=(07,014),LENGTH=015,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(07,031),LENGTH=006,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='EMAIL:'
CEMAIL   DFHMDF POS=(07,038),LENGTH=040,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(08,002),LENGTH=011,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='DOB / INC.:'
CDOB     DFHMDF POS=(08,014),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(08,028),LENGTH=007,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='TAX ID:'
CTAXID   DFHMDF POS=(08,036),LENGTH=011,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(08,050),LENGTH=013,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='RELATIONSHIP:'
CRELID   DFHMDF POS=(08,064),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(09,002),LENGTH=011,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='KYC STATUS:'
CKYC     DFHMDF POS=(09,014),LENGTH=016,ATTRB=(ASKIP,BRT),COLOR=WHITE
         DFHMDF POS=(09,032),LENGTH=005,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='TIER:'
CTIER    DFHMDF POS=(09,038),LENGTH=012,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(09,052),LENGTH=011,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='REVIEW DUE:'
CKYCRV   DFHMDF POS=(09,064),LENGTH=010,ATTRB=(ASKIP,BRT),COLOR=WHITE
         DFHMDF POS=(10,002),LENGTH=011,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='RISK......:'
CRISK    DFHMDF POS=(10,014),LENGTH=012,ATTRB=(ASKIP,BRT),COLOR=WHITE
         DFHMDF POS=(10,028),LENGTH=006,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='SCORE:'
CSCORE   DFHMDF POS=(10,035),LENGTH=003,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(10,041),LENGTH=004,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PEP:'
CPEP     DFHMDF POS=(10,046),LENGTH=001,ATTRB=(ASKIP,BRT),COLOR=WHITE
         DFHMDF POS=(10,050),LENGTH=004,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='MSB:'
CMSB     DFHMDF POS=(10,055),LENGTH=001,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(10,059),LENGTH=005,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='EMPL:'
CEMPL    DFHMDF POS=(10,065),LENGTH=001,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(11,002),LENGTH=011,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='OFAC......:'
COFAC    DFHMDF POS=(11,014),LENGTH=016,ATTRB=(ASKIP,BRT),COLOR=WHITE
         DFHMDF POS=(11,032),LENGTH=012,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='LAST SCREEN:'
COFDT    DFHMDF POS=(11,045),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(12,002),LENGTH=012,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='REL BALANCE:'
CRELBAL  DFHMDF POS=(12,015),LENGTH=020,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(12,040),LENGTH=011,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='LAST MAINT:'
CMAINT   DFHMDF POS=(12,052),LENGTH=020,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(14,002),LENGTH=040,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ACCOUNT      PROD ST OWN    LEDGER BALAN'
         DFHMDF POS=(14,042),LENGTH=023,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='CE  LAST ACTIVITY  NOTE'
ALN01    DFHMDF POS=(15,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
ALN02    DFHMDF POS=(16,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
ALN03    DFHMDF POS=(17,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
ALN04    DFHMDF POS=(18,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
ALN05    DFHMDF POS=(19,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
ALN06    DFHMDF POS=(20,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
ALN07    DFHMDF POS=(21,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(22,002),LENGTH=005,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PAGE:'
PAGENO   DFHMDF POS=(22,008),LENGTH=003,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(22,013),LENGTH=009,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ACCOUNTS:'
ACCTCNT  DFHMDF POS=(22,023),LENGTH=004,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
MSG      DFHMDF POS=(23,001),LENGTH=079,ATTRB=(ASKIP,BRT,FSET),        X
               COLOR=YELLOW
PFKEYS   DFHMDF POS=(24,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE
         DFHMSD TYPE=FINAL
         END
