***********************************************************************
* MAPSET  : CUMNTS    MAP CUMNTM    TRANSACTION CB02 (CUSTMNT)
* PURPOSE : CUSTOMER ADDRESS / CONTACT / RISK MAINTENANCE
*           NAME AND TAX ID CHANGES ARE MAKER-CHECKER
* CHANGE LOG
* 1995-03-20 RJT  ORIGINAL
* 2007-01-15 BHS  DUAL CONTROL FOR NAME / TAX ID (SOX)
* 2018-05-11 AKW  RISK OVERRIDE WITH REASON
***********************************************************************
CUMNTS   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,                   X
               CTRL=(FREEKB,FRSET),STORAGE=AUTO,TIOAPFX=YES,           X
               DSATTS=(COLOR,HILIGHT),MAPATTS=(COLOR,HILIGHT)
CUMNTM   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
TRANID   DFHMDF POS=(01,001),LENGTH=004,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CB02'
TITLE    DFHMDF POS=(01,025),LENGTH=040,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CBS - CUSTOMER MAINTENANCE'
CURDATE  DFHMDF POS=(01,067),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(02,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='---------------------------------------------'
         DFHMDF POS=(03,002),LENGTH=012,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='CUSTOMER ID:'
CUSTID   DFHMDF POS=(03,015),LENGTH=010,ATTRB=(UNPROT,NORM,IC,FSET),   X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(03,025),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(03,030),LENGTH=007,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='STATUS:'
CSTAT    DFHMDF POS=(03,038),LENGTH=012,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(03,052),LENGTH=011,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='LAST MAINT:'
CMAINT   DFHMDF POS=(03,064),LENGTH=015,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(05,002),LENGTH=041,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='** MAKER-CHECKER FIELDS (DUAL CONTROL) **'
         DFHMDF POS=(06,002),LENGTH=011,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='LAST NAME.:'
LNAME    DFHMDF POS=(06,014),LENGTH=030,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(06,044),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(06,046),LENGTH=006,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='FIRST:'
FNAME    DFHMDF POS=(06,053),LENGTH=020,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(06,073),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(06,075),LENGTH=003,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='MI:'
MINIT    DFHMDF POS=(06,079),LENGTH=001,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(07,002),LENGTH=011,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='TAX ID....:'
TAXID    DFHMDF POS=(07,014),LENGTH=009,ATTRB=(UNPROT,NUM,NORM,FSET),  X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(07,023),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(07,025),LENGTH=005,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='TYPE:'
TAXTYP   DFHMDF POS=(07,031),LENGTH=001,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(07,032),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(07,035),LENGTH=008,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PENDING:'
PENDDSC  DFHMDF POS=(07,044),LENGTH=035,ATTRB=(ASKIP,BRT),COLOR=WHITE
         DFHMDF POS=(09,002),LENGTH=026,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='** STANDARD MAINTENANCE **'
         DFHMDF POS=(10,002),LENGTH=011,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ADDRESS 1.:'
ADDR1    DFHMDF POS=(10,014),LENGTH=035,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(10,049),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(11,002),LENGTH=011,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ADDRESS 2.:'
ADDR2    DFHMDF POS=(11,014),LENGTH=035,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(11,049),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(12,002),LENGTH=011,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='CITY......:'
CITY     DFHMDF POS=(12,014),LENGTH=025,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(12,039),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(12,041),LENGTH=003,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ST:'
STATE    DFHMDF POS=(12,045),LENGTH=002,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(12,047),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(12,049),LENGTH=004,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ZIP:'
ZIP      DFHMDF POS=(12,054),LENGTH=010,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(12,064),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(12,066),LENGTH=005,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='CTRY:'
CTRY     DFHMDF POS=(12,072),LENGTH=002,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(12,074),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(13,002),LENGTH=011,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PHONE.....:'
PHONE    DFHMDF POS=(13,014),LENGTH=015,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(13,029),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(14,002),LENGTH=011,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='EMAIL.....:'
EMAIL    DFHMDF POS=(14,014),LENGTH=050,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(14,064),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(16,002),LENGTH=031,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='RISK RATING OVERRIDE (L/M/H/P):'
RISKOVR  DFHMDF POS=(16,034),LENGTH=001,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(16,035),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(16,038),LENGTH=008,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='CURRENT:'
CRISK    DFHMDF POS=(16,047),LENGTH=001,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(16,050),LENGTH=007,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='REASON:'
RSKRSN   DFHMDF POS=(16,058),LENGTH=020,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(16,078),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(18,002),LENGTH=009,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='KYC TIER:'
CTIER    DFHMDF POS=(18,012),LENGTH=001,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(18,016),LENGTH=011,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='KYC STATUS:'
CKYC     DFHMDF POS=(18,028),LENGTH=001,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(18,032),LENGTH=011,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='REVIEW DUE:'
CKYCRV   DFHMDF POS=(18,044),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(19,002),LENGTH=007,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='RESULT:'
RESULT   DFHMDF POS=(19,010),LENGTH=069,ATTRB=(ASKIP,BRT),COLOR=WHITE
MSG      DFHMDF POS=(23,001),LENGTH=079,ATTRB=(ASKIP,BRT,FSET),        X
               COLOR=YELLOW
PFKEYS   DFHMDF POS=(24,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE
         DFHMSD TYPE=FINAL
         END
