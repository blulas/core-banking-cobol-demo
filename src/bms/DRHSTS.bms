***********************************************************************
* MAPSET  : DRHSTS   MAP DRHSTM   TRANSACTION DR64
* PURPOSE : CBS - DIVIDEND REINVESTMENT
* CHANGE LOG
* 1984-04-19 SKN  ORIGINAL
***********************************************************************
DRHSTS   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,CTRL=(FREEKB,      X
               FRSET),STORAGE=AUTO,TIOAPFX=YES,DSATTS=(COLOR,          X
               HILIGHT),MAPATTS=(COLOR,HILIGHT)
DRHSTM   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
TRANID   DFHMDF POS=(01,001),LENGTH=004,ATTRB=(ASKIP,BRT),             X
               COLOR=WHITE,INITIAL='DR64'
TITLE    DFHMDF POS=(01,025),LENGTH=040,ATTRB=(ASKIP,BRT),             X
               COLOR=WHITE,INITIAL='CBS - DIVIDEND REINVESTMENT'
CURDATE  DFHMDF POS=(01,067),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(03,002),LENGTH=004,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='KEY:'
KEY      DFHMDF POS=(03,020),LENGTH=012,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(03,033),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(04,002),LENGTH=013,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='REINVEST YTD:'
REINVE   DFHMDF POS=(04,020),LENGTH=016,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(04,037),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(05,002),LENGTH=014,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='NEXT DUE DATE:'
NEXTDU   DFHMDF POS=(05,020),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(06,002),LENGTH=013,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='REINVEST AMT:'
REINVE1  DFHMDF POS=(06,020),LENGTH=016,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(07,002),LENGTH=015,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='EFFECTIVE DATE:'
EFFECT   DFHMDF POS=(07,020),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(08,002),LENGTH=011,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='CHANNEL CD:'
CHANNE   DFHMDF POS=(08,020),LENGTH=002,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(08,023),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(09,002),LENGTH=009,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='ITEM CNT:'
ITEMCN   DFHMDF POS=(09,020),LENGTH=007,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(10,002),LENGTH=013,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='WITHHOLD AMT:'
WITHHO   DFHMDF POS=(10,020),LENGTH=016,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(10,037),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(11,002),LENGTH=008,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='CONTACT:'
CONTAC   DFHMDF POS=(11,020),LENGTH=020,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(12,002),LENGTH=015,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='PREFERRED FLAG:'
PREFER   DFHMDF POS=(12,020),LENGTH=001,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(12,022),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(13,002),LENGTH=005,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='NAME:'
NAME     DFHMDF POS=(13,020),LENGTH=030,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(14,002),LENGTH=013,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='DIVIDEND AMT:'
DIVIDE   DFHMDF POS=(14,020),LENGTH=016,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(15,002),LENGTH=014,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='OVERRIDE FLAG:'
OVERRI   DFHMDF POS=(15,020),LENGTH=001,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(15,022),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(16,002),LENGTH=008,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='FEE YTD:'
FEEYTD   DFHMDF POS=(16,020),LENGTH=016,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(16,037),LENGTH=001,ATTRB=ASKIP
MSG      DFHMDF POS=(23,001),LENGTH=079,ATTRB=(ASKIP,BRT),             X
               COLOR=YELLOW
         DFHMDF POS=(24,001),LENGTH=079,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,                                             X
               INITIAL='ENTER=PROCESS  PF3=MENU  PF12=CANCEL'
         DFHMSD TYPE=FINAL
         END
