***********************************************************************
* MAPSET  : FEERVS   MAP FEERVM   TRANSACTION CB22 (FEEREV)
* PURPOSE : REFUND (REVERSE) A SERVICE FEE - TELLER / MANAGER LIMITS
* CHANGE LOG
* 2003-09-15 BHS  ORIGINAL
* 2010-07-01 DPS  REG E FEE CODES
* 2016-05-23 DPS  REFUND FREQUENCY LIMIT - CHG1311
***********************************************************************
FEERVS   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,                   X
               CTRL=(FREEKB,FRSET),STORAGE=AUTO,TIOAPFX=YES,           X
               DSATTS=(COLOR,HILIGHT),MAPATTS=(COLOR,HILIGHT)
FEERVM   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
TRANID   DFHMDF POS=(01,001),LENGTH=004,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CB22'
TITLE    DFHMDF POS=(01,025),LENGTH=040,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CBS - FEE REVERSAL'
CURDATE  DFHMDF POS=(01,067),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(02,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='---------------------------------------------'
         DFHMDF POS=(03,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ACCOUNT........:'
ACCTNO   DFHMDF POS=(03,019),LENGTH=012,ATTRB=(UNPROT,NORM,FSET,IC),   X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(03,031),LENGTH=001,ATTRB=ASKIP
OWNER    DFHMDF POS=(03,034),LENGTH=030,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(04,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='FEE TRAN ID....:'
FEETID   DFHMDF POS=(04,019),LENGTH=016,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(04,035),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(05,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='REFUND AMOUNT..:'
RFAMT    DFHMDF POS=(05,019),LENGTH=010,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(05,029),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(06,002),LENGTH=018,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='REASON (CS/BE/DP):'
REASON   DFHMDF POS=(06,021),LENGTH=002,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(06,023),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(06,026),LENGTH=046,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='CS=CUSTOMER SERVICE BE=BANK ERROR DP=DUPLICATE'
         DFHMDF POS=(08,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='FEE CODE.......:'
FEECD    DFHMDF POS=(08,019),LENGTH=004,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
FEEDESC  DFHMDF POS=(08,024),LENGTH=040,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(09,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='FEE AMOUNT.....:'
FEEAMT   DFHMDF POS=(09,019),LENGTH=012,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(09,040),LENGTH=014,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='POSTED.......:'
FEEDT    DFHMDF POS=(09,055),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(10,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='REFUNDS 12 MO..:'
RFCNT    DFHMDF POS=(10,019),LENGTH=003,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(10,040),LENGTH=014,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='YOUR LIMIT...:'
LIMIT    DFHMDF POS=(10,055),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(11,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='AUTHORITY......:'
ROLE     DFHMDF POS=(11,019),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
CONFIRM  DFHMDF POS=(13,002),LENGTH=077,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
MSG      DFHMDF POS=(23,001),LENGTH=079,ATTRB=(ASKIP,BRT),COLOR=YELLOW
         DFHMDF POS=(24,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ENTER=VALIDATE  PF5=CONFIRM REFUND  PF3=MENU  PF12=CANCEL'
         DFHMSD TYPE=FINAL
         END
