***********************************************************************
* MAPSET  : FNMNTS   MAP FNMNTM   TRANSACTION FN58
* PURPOSE : CBS - FOREIGN BANKNOTES
* CHANGE LOG
* 1995-09-26 MKL  ORIGINAL
***********************************************************************
FNMNTS   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,CTRL=(FREEKB,      X
               FRSET),STORAGE=AUTO,TIOAPFX=YES,DSATTS=(COLOR,          X
               HILIGHT),MAPATTS=(COLOR,HILIGHT)
FNMNTM   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
TRANID   DFHMDF POS=(01,001),LENGTH=004,ATTRB=(ASKIP,BRT),             X
               COLOR=WHITE,INITIAL='FN58'
TITLE    DFHMDF POS=(01,025),LENGTH=040,ATTRB=(ASKIP,BRT),             X
               COLOR=WHITE,INITIAL='CBS - FOREIGN BANKNOTES'
CURDATE  DFHMDF POS=(01,067),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(03,002),LENGTH=004,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='KEY:'
KEY      DFHMDF POS=(03,020),LENGTH=012,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(03,033),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(04,002),LENGTH=014,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='ORDER TYPE CD:'
ORDERT   DFHMDF POS=(04,020),LENGTH=003,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(04,024),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(05,002),LENGTH=012,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='NOTICE DATE:'
NOTICE   DFHMDF POS=(05,020),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(06,002),LENGTH=012,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='CURRENCY CD:'
CURREN   DFHMDF POS=(06,020),LENGTH=001,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(07,002),LENGTH=011,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='MARGIN YTD:'
MARGIN   DFHMDF POS=(07,020),LENGTH=016,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(08,002),LENGTH=012,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='EXEMPT FLAG:'
EXEMPT   DFHMDF POS=(08,020),LENGTH=001,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(09,002),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='CYCLE CNT:'
CYCLEC   DFHMDF POS=(09,020),LENGTH=007,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(10,002),LENGTH=012,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='REVIEW FLAG:'
REVIEW   DFHMDF POS=(10,020),LENGTH=001,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(11,002),LENGTH=013,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='SHIPPING AMT:'
SHIPPI   DFHMDF POS=(11,020),LENGTH=016,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(12,002),LENGTH=011,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='NOTICE CNT:'
NOTICE1  DFHMDF POS=(12,020),LENGTH=007,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(13,002),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='BRANCH CD:'
BRANCH   DFHMDF POS=(13,020),LENGTH=003,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(14,002),LENGTH=012,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='BUYBACK YTD:'
BUYBAC   DFHMDF POS=(14,020),LENGTH=016,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(14,037),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(15,002),LENGTH=014,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='OVERRIDE FLAG:'
OVERRI   DFHMDF POS=(15,020),LENGTH=001,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(16,002),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='OPEN DATE:'
OPENDA   DFHMDF POS=(16,020),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
MSG      DFHMDF POS=(23,001),LENGTH=079,ATTRB=(ASKIP,BRT),             X
               COLOR=YELLOW
         DFHMDF POS=(24,001),LENGTH=079,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,                                             X
               INITIAL='ENTER=PROCESS  PF3=MENU  PF12=CANCEL'
         DFHMSD TYPE=FINAL
         END
