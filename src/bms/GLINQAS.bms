* MAPSET  : GLINQAS   MAP GLINQAM   TRANSACTION CB52
* PURPOSE : GENERAL LEDGER BALANCE BY GL ACCOUNT AND COST CENTER
*           (GLBAL)
* CHANGE LOG
* 2006-02-14 BHS  ORIGINAL - ORACLE GL COST CENTERS
* 2015-10-02 DPS  TODAY DEBIT/CREDIT FIELDS
GLINQAS  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,                   X
               CTRL=(FREEKB,FRSET),STORAGE=AUTO,TIOAPFX=YES,           X
               MAPATTS=(COLOR,HILIGHT)
GLINQAM  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(01,001),LENGTH=004,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CB52'
TITLE    DFHMDF POS=(01,025),LENGTH=040,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CBS - GL BALANCE INQUIRY'
CURDATE  DFHMDF POS=(01,067),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(03,001),LENGTH=012,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='GL ACCOUNT:'
GLACCT   DFHMDF POS=(03,014),LENGTH=010,ATTRB=(UNPROT,NORM,IC,FSET),   X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(03,025),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(03,030),LENGTH=012,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='COST CENTER:'
GLCC     DFHMDF POS=(03,043),LENGTH=005,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(03,049),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(05,001),LENGTH=013,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='DESCRIPTION:'
GLDESC   DFHMDF POS=(05,015),LENGTH=030,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(05,048),LENGTH=005,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='TYPE:'
GLTYPE   DFHMDF POS=(05,054),LENGTH=001,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(05,058),LENGTH=007,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='NORMAL:'
GLNORM   DFHMDF POS=(05,066),LENGTH=001,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(07,001),LENGTH=017,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PERIOD START....:'
PERST    DFHMDF POS=(07,019),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(08,001),LENGTH=017,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='OPENING BALANCE.:'
OPENBL   DFHMDF POS=(08,019),LENGTH=020,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(09,001),LENGTH=017,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PERIOD DEBITS...:'
PERDR    DFHMDF POS=(09,019),LENGTH=020,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(10,001),LENGTH=017,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PERIOD CREDITS..:'
PERCR    DFHMDF POS=(10,019),LENGTH=020,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(11,001),LENGTH=017,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='CLOSING BALANCE.:'
CLOSBL   DFHMDF POS=(11,019),LENGTH=020,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(13,001),LENGTH=017,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='TODAY DEBITS....:'
TDYDR    DFHMDF POS=(13,019),LENGTH=020,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(14,001),LENGTH=017,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='TODAY CREDITS...:'
TDYCR    DFHMDF POS=(14,019),LENGTH=020,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(15,001),LENGTH=017,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='LAST POSTED.....:'
LSTPST   DFHMDF POS=(15,019),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(17,001),LENGTH=027,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ALL COST CENTERS - CLOSING:'
ALLCC    DFHMDF POS=(17,029),LENGTH=020,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(17,052),LENGTH=009,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='CC COUNT:'
CCCNT    DFHMDF POS=(17,062),LENGTH=003,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(24,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ENTER=INQUIRE  PF3=MENU  PF7=PREV CC  PF8=NEXT X
               CC  PF12=CANCEL'
MSG      DFHMDF POS=(23,001),LENGTH=079,ATTRB=(ASKIP,BRT),COLOR=YELLOW
         DFHMSD TYPE=FINAL
         END
