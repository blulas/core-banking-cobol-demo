***********************************************************************
* MAPSET  : HEADDS   MAP HEADDM   TRANSACTION HE61
* PURPOSE : CBS - HOME EQUITY LINES
* CHANGE LOG
* 1991-06-25 MKL  ORIGINAL
***********************************************************************
HEADDS   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,CTRL=(FREEKB,      X
               FRSET),STORAGE=AUTO,TIOAPFX=YES,DSATTS=(COLOR,          X
               HILIGHT),MAPATTS=(COLOR,HILIGHT)
HEADDM   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
TRANID   DFHMDF POS=(01,001),LENGTH=004,ATTRB=(ASKIP,BRT),             X
               COLOR=WHITE,INITIAL='HE61'
TITLE    DFHMDF POS=(01,025),LENGTH=040,ATTRB=(ASKIP,BRT),             X
               COLOR=WHITE,INITIAL='CBS - HOME EQUITY LINES'
CURDATE  DFHMDF POS=(01,067),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(03,002),LENGTH=004,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='KEY:'
KEY      DFHMDF POS=(03,020),LENGTH=012,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(03,033),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(04,002),LENGTH=009,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='DRAW AMT:'
DRAWAM   DFHMDF POS=(04,020),LENGTH=016,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(04,037),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(05,002),LENGTH=012,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='BALANCE AMT:'
BALANC   DFHMDF POS=(05,020),LENGTH=016,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(05,037),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(06,002),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='OPEN DATE:'
OPENDA   DFHMDF POS=(06,020),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(07,002),LENGTH=011,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='CLOSE DATE:'
CLOSED   DFHMDF POS=(07,020),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(08,002),LENGTH=012,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='BALANCE YTD:'
BALANC1  DFHMDF POS=(08,020),LENGTH=016,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(09,002),LENGTH=009,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='DISCOUNT:'
DISCOU   DFHMDF POS=(09,020),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(10,002),LENGTH=013,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='APPRAISE AMT:'
APPRAI   DFHMDF POS=(10,020),LENGTH=016,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(11,002),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='RETRY CNT:'
RETRYC   DFHMDF POS=(11,020),LENGTH=007,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(12,002),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='LIMIT AMT:'
LIMITA   DFHMDF POS=(12,020),LENGTH=016,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(13,002),LENGTH=014,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='OVERRIDE FLAG:'
OVERRI   DFHMDF POS=(13,020),LENGTH=001,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(14,002),LENGTH=012,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='PAYMENT CNT:'
PAYMEN   DFHMDF POS=(14,020),LENGTH=007,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(15,002),LENGTH=012,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='MIN PAY YTD:'
MINPAY   DFHMDF POS=(15,020),LENGTH=016,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(15,037),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(16,002),LENGTH=016,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='NOTICE SENT FLA:'
NOTICE   DFHMDF POS=(16,020),LENGTH=001,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(16,022),LENGTH=001,ATTRB=ASKIP
MSG      DFHMDF POS=(23,001),LENGTH=079,ATTRB=(ASKIP,BRT),             X
               COLOR=YELLOW
         DFHMDF POS=(24,001),LENGTH=079,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,                                             X
               INITIAL='ENTER=PROCESS  PF3=MENU  PF12=CANCEL'
         DFHMSD TYPE=FINAL
         END
