***********************************************************************
* MAPSET  : HOLDMNS   MAP HOLDMNM   TRANSACTION CB12 (HOLDMNT)
* PURPOSE : PLACE / RELEASE ACCOUNT HOLDS AND LIENS
* CHANGE LOG
* 1993-04-19 RJT  ORIGINAL
* 2008-02-11 BHS  ROLE DISPLAY - LEGAL HOLD RELEASE BY OPS/MGR
* 2011-07-21 DPS  CK / CX HOLD TYPES
***********************************************************************
HOLDMNS  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,                   X
               CTRL=(FREEKB,FRSET),STORAGE=AUTO,TIOAPFX=YES,           X
               DSATTS=(COLOR,HILIGHT),MAPATTS=(COLOR,HILIGHT)
HOLDMNM  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
TRANID   DFHMDF POS=(01,001),LENGTH=004,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CB12'
TITLE    DFHMDF POS=(01,025),LENGTH=040,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CBS - ACCOUNT HOLD MAINTENANCE'
CURDATE  DFHMDF POS=(01,067),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(02,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='---------------------------------------------'
         DFHMDF POS=(03,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ACCOUNT........:'
ACCTNO   DFHMDF POS=(03,019),LENGTH=012,ATTRB=(UNPROT,NORM,IC,FSET),   X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(03,031),LENGTH=001,ATTRB=ASKIP
ACCTNM   DFHMDF POS=(03,033),LENGTH=030,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
ASTAT    DFHMDF POS=(03,065),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(04,002),LENGTH=008,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='LEDGER:'
LEDGER   DFHMDF POS=(04,011),LENGTH=015,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(04,028),LENGTH=007,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='AVAIL:'
AVAIL    DFHMDF POS=(04,036),LENGTH=015,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(04,053),LENGTH=007,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='HOLDS:'
HOLDAM   DFHMDF POS=(04,061),LENGTH=015,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(05,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='FUNCTION.......:'
FUNC     DFHMDF POS=(05,019),LENGTH=001,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(05,020),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(05,022),LENGTH=026,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='P=PLACE HOLD R=RELEASE'
         DFHMDF POS=(05,052),LENGTH=006,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ROLE:'
OPROLE   DFHMDF POS=(05,059),LENGTH=003,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(07,002),LENGTH=078,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='SEQ  TP          AMOUNT  PLACED    RELEASE   STX
                 REASON'
HLINE1   DFHMDF POS=(08,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
HLINE2   DFHMDF POS=(09,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
HLINE3   DFHMDF POS=(10,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
HLINE4   DFHMDF POS=(11,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
HLINE5   DFHMDF POS=(12,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
HLINE6   DFHMDF POS=(13,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
HLINE7   DFHMDF POS=(14,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
HLINE8   DFHMDF POS=(15,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(17,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='RELEASE SEQ....:'
RELSEQ   DFHMDF POS=(17,019),LENGTH=004,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(17,023),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(18,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='NEW HOLD TYPE..:'
NTYPE    DFHMDF POS=(18,019),LENGTH=002,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(18,021),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(18,023),LENGTH=007,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='AMOUNT:'
NAMT     DFHMDF POS=(18,031),LENGTH=013,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(18,044),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(18,047),LENGTH=013,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='RELEASE DATE:'
NRELDT   DFHMDF POS=(18,061),LENGTH=008,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(18,069),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(19,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='REASON.........:'
NRSN     DFHMDF POS=(19,019),LENGTH=030,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(19,049),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(19,051),LENGTH=004,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='REF:'
NREF     DFHMDF POS=(19,056),LENGTH=020,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(19,076),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(20,002),LENGTH=070,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='TYPES: AD ADMIN (MAX 10 BUS DAYS)  LG LEGAL  LNX
                LIEN  FR FRAUD  CK/CX CHECK'
MSG      DFHMDF POS=(23,001),LENGTH=079,ATTRB=(ASKIP,BRT),COLOR=YELLOW
         DFHMDF POS=(24,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ENTER=DISPLAY PF5=PLACE PF6=RELEASE PF7/8=PAGE X
               PF3=MENU PF12=CANCEL'
         DFHMSD TYPE=FINAL
         END
