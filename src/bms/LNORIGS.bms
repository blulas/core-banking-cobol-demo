* MAPSET  : LNORIGS   MAP LNORIGM   TRANSACTION CB42 (LNORIG)
* PURPOSE : CONSUMER PERSONAL LOAN (LPER) APPLICATION AND
*           CREDIT DECISION
* CHANGE LOG
* 2016-04-25 AKW  ORIGINAL - LPER LAUNCH
* 2017-09-11 AKW  COUNTEROFFER LINE - CHG2231
* 2019-02-04 JPL  REQUESTED AMOUNT WIDENED TO 6 DIGITS
LNORIGS  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,                   X
               CTRL=(FREEKB,FRSET),STORAGE=AUTO,TIOAPFX=YES,           X
               DSATTS=(COLOR,HILIGHT),MAPATTS=(COLOR,HILIGHT)
LNORIGM  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(01,001),LENGTH=004,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CB42'
TITLE    DFHMDF POS=(01,025),LENGTH=032,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CBS - CONSUMER LOAN APPLICATION'
CURDATE  DFHMDF POS=(01,067),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(02,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='-----------------------------------------------X
               --------------------------------'
         DFHMDF POS=(03,001),LENGTH=013,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='CUSTOMER ID.:'
CUSTID   DFHMDF POS=(03,015),LENGTH=010,ATTRB=(UNPROT,NORM,IC,FSET),   X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(03,026),LENGTH=001,ATTRB=ASKIP
CUSTNM   DFHMDF POS=(03,028),LENGTH=030,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(03,059),LENGTH=009,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='EXISTING:'
EXIST    DFHMDF POS=(03,069),LENGTH=001,ATTRB=(ASKIP,BRT),COLOR=WHITE
         DFHMDF POS=(04,001),LENGTH=013,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='STATE.......:'
STATE    DFHMDF POS=(04,015),LENGTH=002,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(04,018),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(04,020),LENGTH=004,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='KYC:'
KYCST    DFHMDF POS=(04,025),LENGTH=001,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(04,028),LENGTH=009,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='EMPLOYEE:'
EMPFLG   DFHMDF POS=(04,038),LENGTH=001,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(04,041),LENGTH=013,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='REL DEPOSITS:'
RELBAL   DFHMDF POS=(04,055),LENGTH=018,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(06,001),LENGTH=022,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='CREDIT SCORE.........:'
SCORE    DFHMDF POS=(06,024),LENGTH=003,ATTRB=(UNPROT,NUM,NORM,FSET),  X
               JUSTIFY=(RIGHT,ZERO),COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(06,028),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(06,036),LENGTH=020,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ANNUAL INCOME......:'
INCOME   DFHMDF POS=(06,057),LENGTH=009,ATTRB=(UNPROT,NUM,NORM,FSET),  X
               JUSTIFY=(RIGHT,ZERO),COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(06,067),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(07,001),LENGTH=022,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='MONTHLY DEBT PAYMENTS:'
MDEBT    DFHMDF POS=(07,024),LENGTH=007,ATTRB=(UNPROT,NUM,NORM,FSET),  X
               JUSTIFY=(RIGHT,ZERO),COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(07,032),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(07,036),LENGTH=020,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='EMPLOYMENT MONTHS..:'
EMPMOS   DFHMDF POS=(07,057),LENGTH=003,ATTRB=(UNPROT,NUM,NORM,FSET),  X
               JUSTIFY=(RIGHT,ZERO),COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(07,061),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(08,001),LENGTH=022,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='REQUESTED AMOUNT.....:'
REQAMT   DFHMDF POS=(08,024),LENGTH=006,ATTRB=(UNPROT,NUM,NORM,FSET),  X
               JUSTIFY=(RIGHT,ZERO),COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(08,031),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(08,036),LENGTH=020,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='TERM (12-60 MONTHS):'
TERM     DFHMDF POS=(08,057),LENGTH=002,ATTRB=(UNPROT,NUM,NORM,FSET),  X
               JUSTIFY=(RIGHT,ZERO),COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(08,060),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(09,001),LENGTH=022,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='BANKRUPTCY LAST 7 YRS:'
BKRPT    DFHMDF POS=(09,024),LENGTH=001,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(09,026),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(09,036),LENGTH=020,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='AUTOPAY (Y/N)......:'
AUTOPY   DFHMDF POS=(09,057),LENGTH=001,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(09,059),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(09,061),LENGTH=004,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ACCT'
APACCT   DFHMDF POS=(09,066),LENGTH=012,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(09,079),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(11,001),LENGTH=015,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CREDIT DECISION'
         DFHMDF POS=(12,001),LENGTH=013,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='DECISION....:'
DECISN   DFHMDF POS=(12,015),LENGTH=007,ATTRB=(ASKIP,BRT),COLOR=WHITE
         DFHMDF POS=(12,036),LENGTH=020,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='APPLICATION NO.....:'
APPLNO   DFHMDF POS=(12,057),LENGTH=012,ATTRB=(ASKIP,BRT),COLOR=WHITE
         DFHMDF POS=(13,001),LENGTH=013,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='RATE (APR)..:'
RATE     DFHMDF POS=(13,015),LENGTH=008,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(13,036),LENGTH=020,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='MONTHLY PAYMENT....:'
PMT      DFHMDF POS=(13,057),LENGTH=014,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(14,001),LENGTH=013,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='DTI.........:'
DTI      DFHMDF POS=(14,015),LENGTH=008,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(14,036),LENGTH=020,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='TOTAL INTEREST.....:'
TOTINT   DFHMDF POS=(14,057),LENGTH=014,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
COUNTER  DFHMDF POS=(15,001),LENGTH=060,ATTRB=(ASKIP,BRT),COLOR=WHITE
         DFHMDF POS=(17,001),LENGTH=041,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PRINCIPAL REASONS (REG B ADVERSE ACTION):'
RSN1     DFHMDF POS=(18,003),LENGTH=046,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
RSN2     DFHMDF POS=(19,003),LENGTH=046,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
RSN3     DFHMDF POS=(20,003),LENGTH=046,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
RSN4     DFHMDF POS=(21,003),LENGTH=046,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
MSG      DFHMDF POS=(23,001),LENGTH=079,ATTRB=(ASKIP,BRT),COLOR=WHITE
         DFHMDF POS=(24,001),LENGTH=048,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ENTER=VALIDATE  PF5=DECIDE  PF3=MENU  PF12=CLEAX
               R'
         DFHMSD TYPE=FINAL
         END
