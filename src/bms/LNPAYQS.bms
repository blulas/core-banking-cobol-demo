* MAPSET  : LNPAYQS   MAP LNPAYQM   TRANSACTION CB41 (LNPAYOF)
* PURPOSE : LOAN PAYOFF QUOTE - PAYOFF COMPONENTS TO A
*           GOOD-THROUGH DATE
* CHANGE LOG
* 2009-03-02 DPS  ORIGINAL
* 2012-04-30 DPS  NON-ACCRUAL INTEREST MEMO LINE - CHG1187
* 2016-04-25 AKW  PREPAYMENT PENALTY DESCRIPTION LINE
LNPAYQS  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,                   X
               CTRL=(FREEKB,FRSET),STORAGE=AUTO,TIOAPFX=YES,           X
               DSATTS=(COLOR,HILIGHT),MAPATTS=(COLOR,HILIGHT)
LNPAYQM  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(01,001),LENGTH=004,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CB41'
TITLE    DFHMDF POS=(01,025),LENGTH=032,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CBS - LOAN PAYOFF QUOTE'
CURDATE  DFHMDF POS=(01,067),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(02,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='-----------------------------------------------X
               --------------------------------'
         DFHMDF POS=(03,001),LENGTH=012,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='LOAN NUMBER:'
LOANNO   DFHMDF POS=(03,014),LENGTH=012,ATTRB=(UNPROT,NORM,IC,FSET),   X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(03,027),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(03,030),LENGTH=024,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='GOOD THROUGH (CCYYMMDD):'
GTDATE   DFHMDF POS=(03,055),LENGTH=008,ATTRB=(UNPROT,NUM,NORM,FSET),  X
               JUSTIFY=(RIGHT,ZERO),COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(03,064),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(05,001),LENGTH=013,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PRODUCT.....:'
PRODCD   DFHMDF POS=(05,015),LENGTH=004,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
PRODDSC  DFHMDF POS=(05,020),LENGTH=020,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(05,042),LENGTH=007,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='STATUS:'
STATDSC  DFHMDF POS=(05,050),LENGTH=020,ATTRB=(ASKIP,BRT),COLOR=WHITE
         DFHMDF POS=(06,001),LENGTH=013,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='BORROWER....:'
BORRID   DFHMDF POS=(06,015),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
BORRNM   DFHMDF POS=(06,026),LENGTH=030,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(07,001),LENGTH=013,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='RATE........:'
RATE     DFHMDF POS=(07,015),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(07,026),LENGTH=010,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ORIG DATE:'
ORIGDT   DFHMDF POS=(07,037),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(07,049),LENGTH=010,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='LOAN YEAR:'
LOANYR   DFHMDF POS=(07,060),LENGTH=003,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(08,001),LENGTH=013,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='BUSINESS DT.:'
BUSDT    DFHMDF POS=(08,015),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(08,026),LENGTH=010,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ACCR THRU:'
LACCDT   DFHMDF POS=(08,037),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(08,049),LENGTH=010,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='GOOD THRU:'
GTDISP   DFHMDF POS=(08,060),LENGTH=010,ATTRB=(ASKIP,BRT),COLOR=WHITE
         DFHMDF POS=(10,001),LENGTH=017,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='PAYOFF COMPONENTS'
         DFHMDF POS=(11,003),LENGTH=030,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PRINCIPAL BALANCE ............'
PRIN     DFHMDF POS=(11,035),LENGTH=018,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(12,003),LENGTH=030,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ACCRUED INTEREST .............'
ACCINT   DFHMDF POS=(12,035),LENGTH=018,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(13,003),LENGTH=027,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PER DIEM ..................'
PERDIEM  DFHMDF POS=(13,035),LENGTH=018,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(13,055),LENGTH=007,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='X DAYS:'
DAYS     DFHMDF POS=(13,063),LENGTH=005,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(14,003),LENGTH=030,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='INTEREST TO GOOD-THROUGH .....'
INTGT    DFHMDF POS=(14,035),LENGTH=018,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(15,003),LENGTH=030,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='NON-ACCRUAL INTEREST (MEMO) ..'
NAINT    DFHMDF POS=(15,035),LENGTH=018,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(16,003),LENGTH=030,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='LATE FEES OUTSTANDING ........'
LATEFEE  DFHMDF POS=(16,035),LENGTH=018,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(17,003),LENGTH=030,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PREPAYMENT PENALTY ...........'
PPPEN    DFHMDF POS=(17,035),LENGTH=018,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
PPDESC   DFHMDF POS=(18,003),LENGTH=040,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(19,003),LENGTH=030,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='LESS SUSPENSE BALANCE ........'
SUSP     DFHMDF POS=(19,035),LENGTH=018,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(20,035),LENGTH=018,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='=================='
         DFHMDF POS=(21,003),LENGTH=030,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='TOTAL PAYOFF AMOUNT ..........'
TOTAL    DFHMDF POS=(21,035),LENGTH=018,ATTRB=(ASKIP,BRT),COLOR=WHITE
         DFHMDF POS=(22,003),LENGTH=049,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='FUNDS MUST BE RECEIVED BY WIRE OR CERTIFIED CHEX
               CK'
MSG      DFHMDF POS=(23,001),LENGTH=079,ATTRB=(ASKIP,BRT),COLOR=WHITE
         DFHMDF POS=(24,001),LENGTH=033,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ENTER=QUOTE  PF3=MENU  PF12=CLEAR'
         DFHMSD TYPE=FINAL
         END
