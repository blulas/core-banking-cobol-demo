***********************************************************************
* MAPSET   : OFACRVS                                                   *
* MAP      : OFACRVM                                                   *
* TRANS    : CB61 - OFAC POTENTIAL MATCH REVIEW                        *
* REVIEW OF CUSTOMERS WITH CUST-OFAC-STATUS H (SET BY OFACBAT).       *
* R = TRUE MATCH: BLOCK CUSTOMER, FREEZE ACCOUNTS. C = FALSE POSITIVE.*
* CHANGE LOG                                                          *
* 2006-08-30 BHS  ORIGINAL                                            *
* 2019-11-04 AKW  MV-0193 SCORE / RULE DISPLAYED                      *
***********************************************************************
OFACRVS  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,      X
               CTRL=(FREEKB,FRSET),TIOAPFX=YES,MAPATTS=(COLOR,HILIGHT),X
               DSATTS=(COLOR,HILIGHT)
OFACRVM  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,2),LENGTH=4,ATTRB=(ASKIP,BRT),COLOR=BLUE,       X
               INITIAL='CB61'
         DFHMDF POS=(1,22),LENGTH=33,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL,  X
               INITIAL='CBS - OFAC POTENTIAL MATCH REVIEW'
CURDATE  DFHMDF POS=(1,70),LENGTH=10,ATTRB=ASKIP,COLOR=TURQUOISE
USERID   DFHMDF POS=(2,70),LENGTH=8,ATTRB=ASKIP,COLOR=TURQUOISE
         DFHMDF POS=(3,2),LENGTH=12,ATTRB=ASKIP,COLOR=GREEN,           X
               INITIAL='CUSTOMER ID:'
CUSTID   DFHMDF POS=(3,15),LENGTH=10,ATTRB=(UNPROT,FSET),COLOR=YELLOW
         DFHMDF POS=(3,25),LENGTH=1,ATTRB=ASKIP
         DFHMDF POS=(3,28),LENGTH=30,ATTRB=ASKIP,COLOR=GREEN,          X
               INITIAL='(BLANK = NEXT PENDING MATCH)'
         DFHMDF POS=(5,2),LENGTH=12,ATTRB=ASKIP,COLOR=GREEN,           X
               INITIAL='NAME       :'
CNAME    DFHMDF POS=(5,15),LENGTH=52,ATTRB=ASKIP,COLOR=TURQUOISE
         DFHMDF POS=(6,2),LENGTH=12,ATTRB=ASKIP,COLOR=GREEN,           X
               INITIAL='TYPE       :'
CTYPE    DFHMDF POS=(6,15),LENGTH=1,ATTRB=ASKIP,COLOR=TURQUOISE
         DFHMDF POS=(6,19),LENGTH=8,ATTRB=ASKIP,COLOR=GREEN,           X
               INITIAL='COUNTRY:'
CCTRY    DFHMDF POS=(6,28),LENGTH=2,ATTRB=ASKIP,COLOR=TURQUOISE
         DFHMDF POS=(6,33),LENGTH=8,ATTRB=ASKIP,COLOR=GREEN,           X
               INITIAL='DOB/INC:'
CDOB     DFHMDF POS=(6,42),LENGTH=8,ATTRB=ASKIP,COLOR=TURQUOISE
         DFHMDF POS=(6,53),LENGTH=7,ATTRB=ASKIP,COLOR=GREEN,           X
               INITIAL='TAX ID:'
CTAXID   DFHMDF POS=(6,61),LENGTH=9,ATTRB=ASKIP,COLOR=TURQUOISE
         DFHMDF POS=(7,2),LENGTH=12,ATTRB=ASKIP,COLOR=GREEN,           X
               INITIAL='CUST STATUS:'
CSTAT    DFHMDF POS=(7,15),LENGTH=1,ATTRB=ASKIP,COLOR=TURQUOISE
         DFHMDF POS=(7,19),LENGTH=12,ATTRB=ASKIP,COLOR=GREEN,          X
               INITIAL='OFAC STATUS:'
COFAC    DFHMDF POS=(7,32),LENGTH=1,ATTRB=ASKIP,COLOR=TURQUOISE
         DFHMDF POS=(7,36),LENGTH=12,ATTRB=ASKIP,COLOR=GREEN,          X
               INITIAL='LAST SCREEN:'
CLSCRN   DFHMDF POS=(7,49),LENGTH=8,ATTRB=ASKIP,COLOR=TURQUOISE
         DFHMDF POS=(9,2),LENGTH=12,ATTRB=ASKIP,COLOR=GREEN,           X
               INITIAL='SDN MATCH  :'
SDNENT   DFHMDF POS=(9,15),LENGTH=6,ATTRB=ASKIP,COLOR=RED
SDNNAME  DFHMDF POS=(9,22),LENGTH=56,ATTRB=ASKIP,COLOR=RED
         DFHMDF POS=(10,2),LENGTH=12,ATTRB=ASKIP,COLOR=GREEN,          X
               INITIAL='PROGRAM    :'
SDNPGM   DFHMDF POS=(10,15),LENGTH=10,ATTRB=ASKIP,COLOR=TURQUOISE
         DFHMDF POS=(10,27),LENGTH=6,ATTRB=ASKIP,COLOR=GREEN,          X
               INITIAL='SCORE:'
SDNSCOR  DFHMDF POS=(10,34),LENGTH=3,ATTRB=ASKIP,COLOR=TURQUOISE
         DFHMDF POS=(10,39),LENGTH=5,ATTRB=ASKIP,COLOR=GREEN,          X
               INITIAL='RULE:'
SDNRULE  DFHMDF POS=(10,45),LENGTH=4,ATTRB=ASKIP,COLOR=TURQUOISE
         DFHMDF POS=(10,51),LENGTH=12,ATTRB=ASKIP,COLOR=GREEN,         X
               INITIAL='SDN COUNTRY:'
SDNCTRY  DFHMDF POS=(10,64),LENGTH=2,ATTRB=ASKIP,COLOR=TURQUOISE
         DFHMDF POS=(12,2),LENGTH=40,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL,  X
               INITIAL='ACCOUNTS (PRIMARY OWNER)'
ACCT01   DFHMDF POS=(13,4),LENGTH=72,ATTRB=ASKIP,COLOR=GREEN
ACCT02   DFHMDF POS=(14,4),LENGTH=72,ATTRB=ASKIP,COLOR=GREEN
ACCT03   DFHMDF POS=(15,4),LENGTH=72,ATTRB=ASKIP,COLOR=GREEN
ACCT04   DFHMDF POS=(16,4),LENGTH=72,ATTRB=ASKIP,COLOR=GREEN
ACCT05   DFHMDF POS=(17,4),LENGTH=72,ATTRB=ASKIP,COLOR=GREEN
         DFHMDF POS=(19,2),LENGTH=32,ATTRB=ASKIP,COLOR=GREEN,          X
               INITIAL='DECISION (R=CONFIRM / C=CLEAR):'
DECIS    DFHMDF POS=(19,35),LENGTH=1,ATTRB=(UNPROT,FSET),COLOR=YELLOW
         DFHMDF POS=(19,36),LENGTH=1,ATTRB=ASKIP
         DFHMDF POS=(20,2),LENGTH=7,ATTRB=ASKIP,COLOR=GREEN,           X
               INITIAL='REASON:'
REASON   DFHMDF POS=(20,10),LENGTH=60,ATTRB=(UNPROT,FSET),COLOR=YELLOW
         DFHMDF POS=(20,70),LENGTH=1,ATTRB=ASKIP
MSG      DFHMDF POS=(23,2),LENGTH=78,ATTRB=(ASKIP,BRT),COLOR=RED
         DFHMDF POS=(24,2),LENGTH=74,ATTRB=ASKIP,COLOR=BLUE,           X
               INITIAL='PF3=MENU  ENTER=VALIDATE  PF10=COMMIT DECISION X
                PF8=NEXT MATCH  PF12=CANCEL'
         DFHMSD TYPE=FINAL
         END
