***********************************************************************
* MAPSET  : RATINQS   MAP RATINQM   TRANSACTION CB20 (RATEINQ)
* PURPOSE : DEPOSIT RATE SHEET BY PRODUCT WITH WHAT-IF RATE / APY
* CHANGE LOG
* 1994-10-03 RJT  ORIGINAL - TRUTH IN SAVINGS RATE SHEET
* 2017-02-08 AKW  WHAT-IF BALANCE / PROMO
* 2019-08-19 AKW  RELATIONSHIP AND SEGMENT INPUT
***********************************************************************
RATINQS  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,                   X
               CTRL=(FREEKB,FRSET),STORAGE=AUTO,TIOAPFX=YES,           X
               DSATTS=(COLOR,HILIGHT),MAPATTS=(COLOR,HILIGHT)
RATINQM  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
TRANID   DFHMDF POS=(01,001),LENGTH=004,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CB20'
TITLE    DFHMDF POS=(01,025),LENGTH=040,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CBS - DEPOSIT RATE INQUIRY'
CURDATE  DFHMDF POS=(01,067),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(02,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='---------------------------------------------'
         DFHMDF POS=(03,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PRODUCT........:'
PROD     DFHMDF POS=(03,019),LENGTH=004,ATTRB=(UNPROT,NORM,FSET,IC),   X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(03,023),LENGTH=001,ATTRB=ASKIP
PRDNAME  DFHMDF POS=(03,026),LENGTH=030,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(04,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='WHAT-IF BALANCE:'
WIBAL    DFHMDF POS=(04,019),LENGTH=015,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(04,034),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(04,040),LENGTH=014,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='TERM (MONTHS):'
WITERM   DFHMDF POS=(04,056),LENGTH=003,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(04,059),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(05,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='SEGMENT (RT/PW):'
WISEG    DFHMDF POS=(05,019),LENGTH=002,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(05,021),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(05,040),LENGTH=015,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='EMPLOYEE (Y/N):'
WIEMP    DFHMDF POS=(05,056),LENGTH=001,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(05,057),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(06,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='RELATIONSHIP...:'
WIREL    DFHMDF POS=(06,019),LENGTH=015,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(06,034),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(06,040),LENGTH=015,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='AS-OF DATE....:'
ASOF     DFHMDF POS=(06,056),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(08,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='WHAT-IF RATE %.:'
RRATE    DFHMDF POS=(08,019),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(08,032),LENGTH=006,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='APY %:'
RAPY     DFHMDF POS=(08,039),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(08,052),LENGTH=005,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='TIER:'
RTIER    DFHMDF POS=(08,058),LENGTH=004,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(10,002),LENGTH=059,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='TIER  TYPE  FROM BALANCE / TERM         RATE %        APY %'
TLINE01  DFHMDF POS=(11,002),LENGTH=070,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
TLINE02  DFHMDF POS=(12,002),LENGTH=070,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
TLINE03  DFHMDF POS=(13,002),LENGTH=070,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
TLINE04  DFHMDF POS=(14,002),LENGTH=070,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
TLINE05  DFHMDF POS=(15,002),LENGTH=070,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
TLINE06  DFHMDF POS=(16,002),LENGTH=070,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
TLINE07  DFHMDF POS=(17,002),LENGTH=070,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
TLINE08  DFHMDF POS=(18,002),LENGTH=070,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
TLINE09  DFHMDF POS=(19,002),LENGTH=070,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
TLINE10  DFHMDF POS=(20,002),LENGTH=070,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
BONUS    DFHMDF POS=(21,002),LENGTH=077,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
MSG      DFHMDF POS=(23,001),LENGTH=079,ATTRB=(ASKIP,BRT),COLOR=YELLOW
         DFHMDF POS=(24,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ENTER=INQUIRE  PF3=MENU  PF7=PREV PRODUCT  PF8=NEXT PRODUCT  PF12=CANCEL'
         DFHMSD TYPE=FINAL
         END
