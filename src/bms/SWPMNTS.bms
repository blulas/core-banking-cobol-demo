* MAPSET  : SWPMNTS   MAP SWPMNTM   TRANSACTION CB51
* PURPOSE : ADD / CHANGE / INQUIRE ON SWEEP AND ZBA DEFINITIONS
*           (SWEEPMST)
* CHANGE LOG
* 2001-10-01 BHS  ORIGINAL
* 2004-05-17 BHS  RANGE MIN/MAX FIELDS
* 2011-04-12 DPS  INCREMENT, MIN TRANSFER, PRIORITY - CHG1544
SWPMNTS  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,                   X
               CTRL=(FREEKB,FRSET),STORAGE=AUTO,TIOAPFX=YES,           X
               MAPATTS=(COLOR,HILIGHT)
SWPMNTM  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(01,001),LENGTH=004,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CB51'
TITLE    DFHMDF POS=(01,025),LENGTH=040,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CBS - SWEEP DEFINITION MAINTENANCE'
CURDATE  DFHMDF POS=(01,067),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(03,001),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ACTION (A/C/I):'
ACTION   DFHMDF POS=(03,018),LENGTH=001,ATTRB=(UNPROT,NORM,IC,FSET),   X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(03,020),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(03,025),LENGTH=009,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='SWEEP ID:'
SWPID    DFHMDF POS=(03,035),LENGTH=008,ATTRB=(UNPROT,NORM,FSET),      X
