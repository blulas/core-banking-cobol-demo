MNTDT    DFHMDF POS=(18,027),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(24,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ENTER=PROCESS  PF3=MENU  PF5=CONFIRM UPDATE  PFX
               12=CANCEL'
MSG      DFHMDF POS=(23,001),LENGTH=079,ATTRB=(ASKIP,BRT),COLOR=YELLOW
         DFHMSD TYPE=FINAL
         END
