         DFHMDF POS=(11,072),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(12,001),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='INCREMENT     :'
INCRMT   DFHMDF POS=(12,018),LENGTH=011,ATTRB=(UNPROT,NORM,FSET),      X
