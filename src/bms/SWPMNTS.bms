         DFHMDF POS=(13,023),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(13,040),LENGTH=015,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PRIORITY     :'
PRTY     DFHMDF POS=(13,056),LENGTH=002,ATTRB=(UNPROT,NUM,NORM,FSET),  X
