         DFHMDF POS=(13,001),LENGTH=019,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='FREQUENCY (D/W/M):'
FREQ     DFHMDF POS=(13,021),LENGTH=001,ATTRB=(UNPROT,NORM,FSET),      X
