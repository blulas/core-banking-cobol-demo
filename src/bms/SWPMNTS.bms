TGTACT   DFHMDF POS=(08,026),LENGTH=012,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(08,039),LENGTH=001,ATTRB=ASKIP
TGTPRD   DFHMDF POS=(08,041),LENGTH=004,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(10,001),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='TARGET BALANCE:'
TGTBAL   DFHMDF POS=(10,018),LENGTH=015,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(10,034),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(11,001),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='RANGE MINIMUM :'
MINBAL   DFHMDF POS=(11,018),LENGTH=015,ATTRB=(UNPROT,NORM,FSET),      X
