         DFHMDF POS=(13,059),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(14,001),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='EFFECTIVE DATE:'
EFFDT    DFHMDF POS=(14,018),LENGTH=008,ATTRB=(UNPROT,NUM,NORM,FSET),  X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(14,027),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(14,040),LENGTH=015,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='EXPIRY DATE  :'
EXPDT    DFHMDF POS=(14,056),LENGTH=008,ATTRB=(UNPROT,NUM,NORM,FSET),  X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(14,065),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(16,001),LENGTH=012,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='LAST SWEEP:'
LSTDT    DFHMDF POS=(16,014),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
LSTAMT   DFHMDF POS=(16,026),LENGTH=017,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
LSTDIR   DFHMDF POS=(16,045),LENGTH=001,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(18,001),LENGTH=015,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='MAINTAINED BY:'
MNTUSR   DFHMDF POS=(18,017),LENGTH=008,ATTRB=(ASKIP,NORM),            X
