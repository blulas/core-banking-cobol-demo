***********************************************************************
* MAPSET  : TELLTRS   MAP TELLTRM   TRANSACTION CB11 (TELLTRN)
* PURPOSE : TELLER CASH DEPOSIT / WITHDRAWAL / CHECK DEPOSIT
* CHANGE LOG
* 1989-10-02 RJT  ORIGINAL
* 2001-09-10 BHS  CTR CONDUCTOR CAPTURE (BSA 31 CFR 1010.311)
* 2006-05-22 BHS  SUPERVISOR OVERRIDE FIELDS
* 2011-07-21 DPS  REG CC HOLD DISCLOSURE LINES
***********************************************************************
TELLTRS  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,                   X
               CTRL=(FREEKB,FRSET),STORAGE=AUTO,TIOAPFX=YES,           X
               DSATTS=(COLOR,HILIGHT),MAPATTS=(COLOR,HILIGHT)
TELLTRM  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
TRANID   DFHMDF POS=(01,001),LENGTH=004,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CB11'
TITLE    DFHMDF POS=(01,025),LENGTH=040,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CBS - TELLER CASH TRANSACTION'
CURDATE  DFHMDF POS=(01,067),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(02,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='---------------------------------------------'
         DFHMDF POS=(03,002),LENGTH=010,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='TELLER..:'
TLRID    DFHMDF POS=(03,013),LENGTH=008,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(03,023),LENGTH=014,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='DRAWER OUT:'
DRWOUT   DFHMDF POS=(03,038),LENGTH=014,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(03,054),LENGTH=007,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='LIMIT:'
DRWLIM   DFHMDF POS=(03,062),LENGTH=014,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(04,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='FUNCTION.......:'
FUNC     DFHMDF POS=(04,019),LENGTH=001,ATTRB=(UNPROT,NORM,IC,FSET),   X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(04,020),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(04,022),LENGTH=046,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='D=CASH DEPOSIT  W=CASH WITHDRAWAL  C=CHECK DEP'
         DFHMDF POS=(05,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ACCOUNT........:'
ACCTNO   DFHMDF POS=(05,019),LENGTH=012,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(05,031),LENGTH=001,ATTRB=ASKIP
ACCTNM   DFHMDF POS=(05,033),LENGTH=030,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
ASTAT    DFHMDF POS=(05,065),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(06,002),LENGTH=010,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='AVAILABLE:'
AVAIL    DFHMDF POS=(06,013),LENGTH=015,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(06,030),LENGTH=009,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='CASH IN:'
CSHIN    DFHMDF POS=(06,040),LENGTH=014,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(06,056),LENGTH=009,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='CASH OUT:'
CSHOUT   DFHMDF POS=(06,066),LENGTH=013,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(07,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='AMOUNT.........:'
AMOUNT   DFHMDF POS=(07,019),LENGTH=013,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(07,032),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(07,036),LENGTH=018,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ID VERIFIED (Y/N):'
IDVER    DFHMDF POS=(07,055),LENGTH=001,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(07,056),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(09,002),LENGTH=070,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='-- CTR CONDUCTOR INFORMATION (CASH TODAY + THISX
                ITEM AT $10,000) --'
         DFHMDF POS=(10,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='CONDUCTOR NAME.:'
CNDNM    DFHMDF POS=(10,019),LENGTH=030,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(10,049),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(10,052),LENGTH=005,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='DOB:'
CNDDOB   DFHMDF POS=(10,058),LENGTH=008,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(10,066),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(11,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ADDRESS........:'
CNDADR   DFHMDF POS=(11,019),LENGTH=040,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(11,059),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(12,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ID TYPE........:'
CNDIDT   DFHMDF POS=(12,019),LENGTH=002,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(12,021),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(12,023),LENGTH=004,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='NO:'
CNDIDN   DFHMDF POS=(12,028),LENGTH=020,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(12,048),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(12,050),LENGTH=008,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ISSUER:'
CNDIDS   DFHMDF POS=(12,059),LENGTH=002,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(12,061),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(13,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='OCCUPATION.....:'
CNDOCC   DFHMDF POS=(13,019),LENGTH=020,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(13,039),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(13,042),LENGTH=017,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ON BEHALF (Y/N):'
CNDOBO   DFHMDF POS=(13,060),LENGTH=001,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(13,061),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(15,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='SUPERVISOR ID..:'
SUPID    DFHMDF POS=(15,019),LENGTH=008,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(15,027),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(15,030),LENGTH=010,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PASSWORD:'
SUPPWD   DFHMDF POS=(15,041),LENGTH=008,ATTRB=(UNPROT,DRK,FSET),       X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(15,049),LENGTH=001,ATTRB=ASKIP
HLDTX1   DFHMDF POS=(17,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
HLDTX2   DFHMDF POS=(18,002),LENGTH=078,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(20,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='RECEIPT REF....:'
TRNREF   DFHMDF POS=(20,019),LENGTH=020,ATTRB=(ASKIP,BRT),COLOR=YELLOW
         DFHMDF POS=(20,042),LENGTH=014,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='NEW AVAILABLE:'
NEWAVL   DFHMDF POS=(20,057),LENGTH=015,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
MSG      DFHMDF POS=(23,001),LENGTH=079,ATTRB=(ASKIP,BRT),COLOR=YELLOW
         DFHMDF POS=(24,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ENTER=VALIDATE  PF5=POST  PF3=MENU  PF12=CANCELX
               '
         DFHMSD TYPE=FINAL
         END
