***********************************************************************
* MAPSET  : TXADDS   MAP TXADDM   TRANSACTION TX20
* PURPOSE : CBS - TELEX WIRE MESSAGING
* CHANGE LOG
* 1993-04-16 CRP  ORIGINAL
***********************************************************************
TXADDS   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,CTRL=(FREEKB,      X
               FRSET),STORAGE=AUTO,TIOAPFX=YES,DSATTS=(COLOR,          X
               HILIGHT),MAPATTS=(COLOR,HILIGHT)
TXADDM   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
TRANID   DFHMDF POS=(01,001),LENGTH=004,ATTRB=(ASKIP,BRT),             X
               COLOR=WHITE,INITIAL='TX20'
TITLE    DFHMDF POS=(01,025),LENGTH=040,ATTRB=(ASKIP,BRT),             X
               COLOR=WHITE,INITIAL='CBS - TELEX WIRE MESSAGING'
CURDATE  DFHMDF POS=(01,067),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(03,002),LENGTH=004,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='KEY:'
KEY      DFHMDF POS=(03,020),LENGTH=012,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(03,033),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(04,002),LENGTH=007,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='REF NO:'
REFNO    DFHMDF POS=(04,020),LENGTH=016,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(05,002),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='COVER YTD:'
COVERY   DFHMDF POS=(05,020),LENGTH=016,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(06,002),LENGTH=014,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='OVERRIDE FLAG:'
OVERRI   DFHMDF POS=(06,020),LENGTH=001,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(06,022),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(07,002),LENGTH=014,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='LAST ACT DATE:'
LASTAC   DFHMDF POS=(07,020),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(08,002),LENGTH=009,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='WIRE AMT:'
WIREAM   DFHMDF POS=(08,020),LENGTH=016,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(08,037),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(09,002),LENGTH=012,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='CORRESP YTD:'
CORRES   DFHMDF POS=(09,020),LENGTH=016,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(09,037),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(10,002),LENGTH=008,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='TYPE CD:'
TYPECD   DFHMDF POS=(10,020),LENGTH=001,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(10,022),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(11,002),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='COVER AMT:'
COVERA   DFHMDF POS=(11,020),LENGTH=016,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(11,037),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(12,002),LENGTH=011,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='CLOSE DATE:'
CLOSED   DFHMDF POS=(12,020),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(13,002),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='BRANCH CD:'
BRANCH   DFHMDF POS=(13,020),LENGTH=002,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(14,002),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='STOP FLAG:'
STOPFL   DFHMDF POS=(14,020),LENGTH=001,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(15,002),LENGTH=014,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='NEXT DUE DATE:'
NEXTDU   DFHMDF POS=(15,020),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(16,002),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='OPEN DATE:'
OPENDA   DFHMDF POS=(16,020),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
MSG      DFHMDF POS=(23,001),LENGTH=079,ATTRB=(ASKIP,BRT),             X
               COLOR=YELLOW
         DFHMDF POS=(24,001),LENGTH=079,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,                                             X
               INITIAL='ENTER=PROCESS  PF3=MENU  PF12=CANCEL'
         DFHMSD TYPE=FINAL
         END
