***********************************************************************
* MAPSET  : XFERFNS   MAP XFERFNM   TRANSACTION CB10 (XFERFUND)
* PURPOSE : INTERNAL TRANSFER BETWEEN TWO ACCOUNTS OF ONE CUSTOMER
* CHANGE LOG
* 1997-05-12 RJT  ORIGINAL
* 2009-11-17 DPS  REG D COUNT / EXCESS FEE DISPLAY
* 2014-11-03 DPS  CONFIRMATION STEP (PF5)
***********************************************************************
XFERFNS  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,                   X
               CTRL=(FREEKB,FRSET),STORAGE=AUTO,TIOAPFX=YES,           X
               DSATTS=(COLOR,HILIGHT),MAPATTS=(COLOR,HILIGHT)
XFERFNM  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
TRANID   DFHMDF POS=(01,001),LENGTH=004,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CB10'
TITLE    DFHMDF POS=(01,025),LENGTH=040,ATTRB=(ASKIP,BRT),COLOR=WHITE, X
               INITIAL='CBS - INTERNAL FUNDS TRANSFER'
CURDATE  DFHMDF POS=(01,067),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(02,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='---------------------------------------------'
         DFHMDF POS=(03,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='FROM ACCOUNT...:'
FROMAC   DFHMDF POS=(03,019),LENGTH=012,ATTRB=(UNPROT,NORM,IC,FSET),   X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(03,031),LENGTH=001,ATTRB=ASKIP
FROMNM   DFHMDF POS=(03,033),LENGTH=030,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
FRPRD    DFHMDF POS=(03,065),LENGTH=004,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(04,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='  AVAILABLE....:'
FRAVL    DFHMDF POS=(04,019),LENGTH=017,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(04,040),LENGTH=010,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='OD LIMIT:'
FRODL    DFHMDF POS=(04,051),LENGTH=012,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(05,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='TO ACCOUNT.....:'
TOAC     DFHMDF POS=(05,019),LENGTH=012,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(05,031),LENGTH=001,ATTRB=ASKIP
TONM     DFHMDF POS=(05,033),LENGTH=030,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
TOPRD    DFHMDF POS=(05,065),LENGTH=004,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(06,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='  AVAILABLE....:'
TOAVL    DFHMDF POS=(06,019),LENGTH=017,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(08,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='AMOUNT.........:'
AMOUNT   DFHMDF POS=(08,019),LENGTH=013,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(08,032),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(09,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='MEMO...........:'
MEMO     DFHMDF POS=(09,019),LENGTH=030,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(09,049),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(10,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='REQUESTED BY...:'
CUSTID   DFHMDF POS=(10,019),LENGTH=010,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(10,029),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(10,032),LENGTH=024,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='(CUSTOMER ID - OWNER)'
         DFHMDF POS=(11,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='CONFIRM (Y/N)..:'
CONFRM   DFHMDF POS=(11,019),LENGTH=001,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN,HILIGHT=UNDERLINE
         DFHMDF POS=(11,020),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(13,002),LENGTH=022,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='CONVENIENT WD (CYCLE):'
REGDCT   DFHMDF POS=(13,025),LENGTH=003,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(13,030),LENGTH=012,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='EXCESS FEE:'
REGDFE   DFHMDF POS=(13,043),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(14,002),LENGTH=022,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='PROJECTED FROM AVAIL.:'
PROJBL   DFHMDF POS=(14,025),LENGTH=017,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(14,044),LENGTH=009,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='OD USED:'
ODUSED   DFHMDF POS=(14,054),LENGTH=012,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(16,002),LENGTH=016,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='REFERENCE......:'
XFRREF   DFHMDF POS=(16,019),LENGTH=020,ATTRB=(ASKIP,BRT),COLOR=YELLOW
MSG      DFHMDF POS=(23,001),LENGTH=079,ATTRB=(ASKIP,BRT),COLOR=YELLOW
         DFHMDF POS=(24,001),LENGTH=079,ATTRB=(ASKIP,NORM),COLOR=BLUE, X
               INITIAL='ENTER=VALIDATE  PF5=CONFIRM TRANSFER  PF3=MENU X
                PF12=CANCEL'
         DFHMSD TYPE=FINAL
         END
