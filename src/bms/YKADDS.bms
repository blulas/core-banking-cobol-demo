***********************************************************************
* MAPSET  : YKADDS   MAP YKADDM   TRANSACTION YK12
* PURPOSE : CBS - DATE WINDOW BRIDGE
* CHANGE LOG
* 1991-06-27 LMB  ORIGINAL
***********************************************************************
YKADDS   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,CTRL=(FREEKB,      X
               FRSET),STORAGE=AUTO,TIOAPFX=YES,DSATTS=(COLOR,          X
               HILIGHT),MAPATTS=(COLOR,HILIGHT)
YKADDM   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
TRANID   DFHMDF POS=(01,001),LENGTH=004,ATTRB=(ASKIP,BRT),             X
               COLOR=WHITE,INITIAL='YK12'
TITLE    DFHMDF POS=(01,025),LENGTH=040,ATTRB=(ASKIP,BRT),             X
               COLOR=WHITE,INITIAL='CBS - DATE WINDOW BRIDGE'
CURDATE  DFHMDF POS=(01,067),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(03,002),LENGTH=004,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='KEY:'
KEY      DFHMDF POS=(03,020),LENGTH=012,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(03,033),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(04,002),LENGTH=008,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='CUST ID:'
CUSTID   DFHMDF POS=(04,020),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(05,002),LENGTH=012,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='CONTROL YTD:'
CONTRO   DFHMDF POS=(05,020),LENGTH=016,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(05,037),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(06,002),LENGTH=005,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='NAME:'
NAME     DFHMDF POS=(06,020),LENGTH=030,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(07,002),LENGTH=014,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='MATURITY DATE:'
MATURI   DFHMDF POS=(07,020),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(08,002),LENGTH=009,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='CYCLE CD:'
CYCLEC   DFHMDF POS=(08,020),LENGTH=002,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(09,002),LENGTH=012,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='NOTICE DATE:'
NOTICE   DFHMDF POS=(09,020),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(10,002),LENGTH=012,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='CONTROL AMT:'
CONTRO1  DFHMDF POS=(10,020),LENGTH=016,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(11,002),LENGTH=013,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='AMOUNT 1 YTD:'
AMOUNT   DFHMDF POS=(11,020),LENGTH=016,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(12,002),LENGTH=014,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='LAST ACT DATE:'
LASTAC   DFHMDF POS=(12,020),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(13,002),LENGTH=012,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='EXPIRY DATE:'
EXPIRY   DFHMDF POS=(13,020),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(14,002),LENGTH=014,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='OVERRIDE FLAG:'
OVERRI   DFHMDF POS=(14,020),LENGTH=001,ATTRB=(UNPROT,NORM,FSET),      X
               COLOR=GREEN
         DFHMDF POS=(14,022),LENGTH=001,ATTRB=ASKIP
         DFHMDF POS=(15,002),LENGTH=014,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='LAST PAY DATE:'
LASTPA   DFHMDF POS=(15,020),LENGTH=010,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
         DFHMDF POS=(16,002),LENGTH=009,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,INITIAL='ITEM CNT:'
ITEMCN   DFHMDF POS=(16,020),LENGTH=007,ATTRB=(ASKIP,NORM),            X
               COLOR=TURQUOISE
MSG      DFHMDF POS=(23,001),LENGTH=079,ATTRB=(ASKIP,BRT),             X
               COLOR=YELLOW
         DFHMDF POS=(24,001),LENGTH=079,ATTRB=(ASKIP,NORM),            X
               COLOR=BLUE,                                             X
               INITIAL='ENTER=PROCESS  PF3=MENU  PF12=CANCEL'
         DFHMSD TYPE=FINAL
         END
