      *================================================================*
      * PROGRAM  : LNPAYAP                                             *
      * TYPE     : BATCH - EOD STEP 07                                 *
      * PURPOSE  : LOAN PAYMENT APPLICATION. READS TODAY'S POSTED      *
      *            TRANSACTIONS (TRANPOST) AND, FOR EVERY POSTED WLNP  *
      *            LOAN PAYMENT DEBIT WHOSE COUNTER ACCOUNT IS A LOAN  *
      *            NUMBER (INCLUDING AUTOPAY DEBITS GENERATED BY       *
      *            LNBILL ON THE PRIOR CYCLE), APPLIES THE PAYMENT TO  *
      *            THE LOAN THROUGH THE LNWATER WATERFALL, UPDATES     *
      *            LOANMST AND WRITES THE PAYMENT HISTORY UNLOAD       *
      *            (LOADED TO DB2 CBS.LOAN_PAYMENT_HIST) AND REPORT.   *
      *            A PAYMENT THAT SATISFIES THE PAYOFF AMOUNT CLOSES   *
      *            THE LOAN (STATUS P).                                *
      *            WHEN THE INSTALLMENT FOR THE NEXT DUE DATE IS PAID  *
      *            IN FULL THE NEXT DUE DATE ADVANCES ONE PERIOD.      *
      * INPUT    : TRANPOST (TRANREC), BANKCTL (VIA GETCTL)            *
      * I-O      : LOANMST                                             *
      * OUTPUT   : LNPAYHST (LNPHREC), LNPYRPT                         *
      * RC       : 0 OK, 4 ONE OR MORE PAYMENTS COULD NOT BE APPLIED   *
      *----------------------------------------------------------------*
      * CHANGE LOG                                                     *
      * 1991-05-06 RJT  ORIGINAL - TELLER LOAN PAYMENTS                *
      * 1998-11-02 MKL  Y2K - DATES EXPANDED TO CCYYMMDD               *
      * 2006-02-13 BHS  DUE TABLE / LNWATER - CHG0412                  *
      * 2008-10-14 DPS  PAYMENT HISTORY UNLOAD FOR DB2 (CB40)          *
      * 2016-04-25 AKW  SOURCE = TRANPOST WLNP (DEPOSIT DEBITS) -      *
      *                 REPLACES LOAN PAYMENT CARD INPUT               *
      * 2017-03-20 AKW  AUTOPAY DEBITS FROM LNAUTOPY - CHG2104         *
      *================================================================*
       IDENTIFICATION DIVISION.
       PROGRAM-ID. LNPAYAP.

       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT OPTIONAL TRAN-FILE ASSIGN TO "TRANPOST"
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS IS WS-TRAN-STATUS.
           SELECT LOAN-FILE ASSIGN TO "LOANMST"
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS LOAN-NUMBER
               ALTERNATE RECORD KEY IS LOAN-BORROWER-CUST-ID
                   WITH DUPLICATES
               FILE STATUS IS WS-LOAN-STATUS.
           SELECT HIST-FILE ASSIGN TO "LNPAYHST"
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS IS WS-HIST-STATUS.
           SELECT REPORT-FILE ASSIGN TO "LNPYRPT"
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS WS-RPT-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  TRAN-FILE.
       COPY TRANREC.
       FD  LOAN-FILE.
       COPY LOANREC.
       FD  HIST-FILE.
       COPY LNPHREC.
       FD  REPORT-FILE.
       01  REPORT-LINE                     PIC X(132).

       WORKING-STORAGE SECTION.
       01  WS-TRAN-STATUS                  PIC X(02).
       01  WS-LOAN-STATUS                  PIC X(02).
       01  WS-HIST-STATUS                  PIC X(02).
       01  WS-RPT-STATUS                   PIC X(02).
       01  WS-EOF-FLAG                     PIC X(01) VALUE 'N'.
           88  WS-EOF                                VALUE 'Y'.
       01  WS-COUNTERS.
           05  WS-TRAN-READ                PIC 9(07) VALUE 0.
           05  WS-PMT-SELECTED             PIC 9(07) VALUE 0.
           05  WS-PMT-APPLIED              PIC 9(07) VALUE 0.
           05  WS-PMT-EXCEPTIONS           PIC 9(07) VALUE 0.
           05  WS-PAYOFFS                  PIC 9(07) VALUE 0.
       01  WS-TOT-APPLIED                  PIC S9(13)V99 COMP-3
                                           VALUE 0.
       01  WS-WORK.
           05  WS-I                        PIC 9(02).
           05  WS-NEXT-DUE-BILLED          PIC X(01).
           05  WS-NEXT-DUE-STILL-OPEN      PIC X(01).
           05  WS-MONTHS                   PIC 9(02).
           05  WS-EXCEPTION-REASON         PIC X(40).

       01  WS-HDR-1.
           05  FILLER PIC X(40) VALUE
               'LNPAYAP  CBS LOAN PAYMENT APPLICATION   '.
           05  FILLER PIC X(16) VALUE '  BUSINESS DATE '.
           05  WS-HDR-DATE                 PIC 9(08).
       01  WS-HDR-2.
           05  FILLER PIC X(45) VALUE
               'LOAN NUMBER  FROM ACCT        PAYMENT WF     '.
           05  FILLER PIC X(15) VALUE
               '    FEES       '.
           05  FILLER PIC X(50) VALUE
               '     INTEREST      PRINCIPAL  EXTRA PRIN  SUSPENSE'.
           05  FILLER PIC X(22) VALUE
               '    PRIN BAL AFTER'.
       01  WS-DTL.
           05  WS-D-LOAN                   PIC X(12).
           05  FILLER                      PIC X(01) VALUE SPACE.
           05  WS-D-FROM                   PIC X(12).
           05  WS-D-PMT                    PIC ZZ,ZZZ,ZZ9.99.
           05  FILLER                      PIC X(01) VALUE SPACE.
           05  WS-D-WF                     PIC X(01).
           05  WS-D-FEES                   PIC ZZZ,ZZZ,ZZ9.99.
           05  WS-D-INT                    PIC ZZZ,ZZZ,ZZ9.99.
           05  WS-D-PRIN                   PIC ZZ,ZZZ,ZZ9.99.
           05  WS-D-EXTRA                  PIC ZZ,ZZZ,ZZ9.99.
           05  WS-D-SUSP                   PIC ZZZ,ZZ9.99.
           05  WS-D-BAL                    PIC ZZZ,ZZZ,ZZ9.99.
           05  FILLER                      PIC X(01) VALUE SPACE.
           05  WS-D-NOTE                   PIC X(20).
       01  WS-EXC.
           05  FILLER PIC X(12) VALUE '** EXCEPTION'.
           05  FILLER                      PIC X(01) VALUE SPACE.
           05  WS-E-TRAN                   PIC X(16).
           05  FILLER                      PIC X(01) VALUE SPACE.
           05  WS-E-LOAN                   PIC X(17).
           05  WS-E-PMT                    PIC ZZ,ZZZ,ZZ9.99.
           05  FILLER                      PIC X(01) VALUE SPACE.
           05  WS-E-REASON                 PIC X(40).
       01  WS-TRL.
           05  FILLER PIC X(18) VALUE 'LNPAYAP TOTALS TR='.
           05  WS-T-READ                   PIC ZZZ,ZZ9.
           05  FILLER PIC X(10) VALUE ' SELECTED='.
           05  WS-T-SEL                    PIC ZZZ,ZZ9.
           05  FILLER PIC X(09) VALUE ' APPLIED='.
           05  WS-T-APP                    PIC ZZZ,ZZ9.
           05  FILLER PIC X(12) VALUE ' EXCEPTIONS='.
           05  WS-T-EXC                    PIC ZZZ,ZZ9.
           05  FILLER PIC X(09) VALUE ' PAYOFFS='.
           05  WS-T-PAYOFF                 PIC ZZZ,ZZ9.
           05  FILLER PIC X(08) VALUE ' AMOUNT='.
           05  WS-T-AMT                    PIC ZZZ,ZZZ,ZZ9.99.

       COPY BANKCTL.
       COPY DATEPARM.
       COPY LNWPARM.
       COPY ABNDPARM.

       PROCEDURE DIVISION.
       0000-MAIN.
           PERFORM 1000-INITIALIZE
           PERFORM UNTIL WS-EOF
               READ TRAN-FILE
                   AT END SET WS-EOF TO TRUE
                   NOT AT END PERFORM 2000-PROCESS-TRAN
               END-READ
           END-PERFORM
           PERFORM 9000-TERMINATE
           STOP RUN.

       1000-INITIALIZE.
           CALL 'GETCTL' USING BANK-CONTROL-RECORD
           OPEN INPUT TRAN-FILE
           IF WS-TRAN-STATUS NOT = '00' AND WS-TRAN-STATUS NOT = '05'
               MOVE 'TRANPOST' TO ABND-FILE-NAME
               MOVE WS-TRAN-STATUS TO ABND-FILE-STATUS
               MOVE 'OPEN FAILED - POSTED TRANSACTIONS' TO ABND-MESSAGE
               PERFORM 9900-ABEND
           END-IF
           OPEN I-O LOAN-FILE
           IF WS-LOAN-STATUS NOT = '00'
               MOVE 'LOANMST' TO ABND-FILE-NAME
               MOVE WS-LOAN-STATUS TO ABND-FILE-STATUS
               MOVE 'OPEN FAILED - LOAN MASTER' TO ABND-MESSAGE
               PERFORM 9900-ABEND
           END-IF
           OPEN OUTPUT HIST-FILE REPORT-FILE
           IF WS-HIST-STATUS NOT = '00' OR WS-RPT-STATUS NOT = '00'
               MOVE 'LNPAYHST' TO ABND-FILE-NAME
               MOVE WS-HIST-STATUS TO ABND-FILE-STATUS
               MOVE 'OPEN FAILED - HISTORY / REPORT' TO ABND-MESSAGE
               PERFORM 9900-ABEND
           END-IF
           MOVE CTL-BUSINESS-DATE TO WS-HDR-DATE
           WRITE REPORT-LINE FROM WS-HDR-1
           WRITE REPORT-LINE FROM WS-HDR-2.

      *================================================================*
      * SELECT POSTED WLNP DEBITS WHOSE COUNTER ACCOUNT IS A LOAN      *
      *================================================================*
       2000-PROCESS-TRAN.
           ADD 1 TO WS-TRAN-READ
           IF TRAN-CODE NOT = 'WLNP'
              OR NOT TRAN-POSTED
              OR NOT TRAN-IS-DEBIT
              OR TRAN-COUNTER-ACCT(1:1) NOT = '3'
               EXIT PARAGRAPH
           END-IF
           ADD 1 TO WS-PMT-SELECTED
           MOVE TRAN-COUNTER-ACCT(1:12) TO LOAN-NUMBER
           READ LOAN-FILE
           IF WS-LOAN-STATUS NOT = '00'
               MOVE 'LOAN NOT ON FILE - SEND TO LOAN OPS'
                 TO WS-EXCEPTION-REASON
               PERFORM 8500-WRITE-EXCEPTION
               EXIT PARAGRAPH
           END-IF
           PERFORM 2100-APPLY-PAYMENT.

       2100-APPLY-PAYMENT.
      *    IS THE NEXT DUE INSTALLMENT BILLED AND OPEN BEFORE PAYMENT
           MOVE 'N' TO WS-NEXT-DUE-BILLED
           PERFORM VARYING WS-I FROM 1 BY 1
                   UNTIL WS-I > LOAN-DUE-COUNT
               IF LOAN-DUE-DATE(WS-I) = LOAN-NEXT-DUE-DATE
                   MOVE 'Y' TO WS-NEXT-DUE-BILLED
               END-IF
           END-PERFORM

           INITIALIZE WATERFALL-PARMS
           MOVE LOAN-PRODUCT-CODE    TO LNW-PRODUCT-CODE
           MOVE LOAN-STATUS          TO LNW-LOAN-STATUS
           MOVE LOAN-DAYS-PAST-DUE   TO LNW-DAYS-PAST-DUE
           MOVE TRAN-AMOUNT          TO LNW-PAYMENT-AMT
           MOVE LOAN-PRINCIPAL-BAL   TO LNW-PRINCIPAL-BAL
           MOVE LOAN-ACCRUED-INT     TO LNW-ACCRUED-INT
           MOVE LOAN-LATE-FEES-OUTST TO LNW-LATE-FEES
           MOVE LOAN-SUSPENSE-BAL    TO LNW-SUSPENSE-BAL
           MOVE LOAN-DUE-COUNT       TO LNW-DUE-COUNT
           PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 8
               MOVE LOAN-DUE-DATE(WS-I)     TO LNW-DUE-DATE(WS-I)
               MOVE LOAN-DUE-INT(WS-I)      TO LNW-DUE-INT(WS-I)
               MOVE LOAN-DUE-PRIN(WS-I)     TO LNW-DUE-PRIN(WS-I)
               MOVE LOAN-DUE-FEE-FLAG(WS-I) TO LNW-DUE-FEE-FLAG(WS-I)
           END-PERFORM
           CALL 'LNWATER' USING WATERFALL-PARMS
           IF NOT LNW-OK
               MOVE 'WATERFALL REJECTED PAYMENT'
                 TO WS-EXCEPTION-REASON
               PERFORM 8500-WRITE-EXCEPTION
               EXIT PARAGRAPH
           END-IF

           MOVE LNW-PRINCIPAL-BAL    TO LOAN-PRINCIPAL-BAL
           MOVE LNW-ACCRUED-INT      TO LOAN-ACCRUED-INT
           MOVE LNW-LATE-FEES        TO LOAN-LATE-FEES-OUTST
           MOVE LNW-SUSPENSE-BAL     TO LOAN-SUSPENSE-BAL
           MOVE LNW-DUE-COUNT        TO LOAN-DUE-COUNT
           PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 8
               MOVE LNW-DUE-DATE(WS-I)     TO LOAN-DUE-DATE(WS-I)
               MOVE LNW-DUE-INT(WS-I)      TO LOAN-DUE-INT(WS-I)
               MOVE LNW-DUE-PRIN(WS-I)     TO LOAN-DUE-PRIN(WS-I)
               MOVE LNW-DUE-FEE-FLAG(WS-I) TO LOAN-DUE-FEE-FLAG(WS-I)
           END-PERFORM
           ADD LNW-APPLIED-INT       TO LOAN-INT-PAID-YTD
           ADD LNW-APPLIED-RECOVERY  TO LOAN-RECOVERY-AMT
           MOVE CTL-BUSINESS-DATE    TO LOAN-LAST-PMT-DATE
           MOVE TRAN-AMOUNT          TO LOAN-LAST-PMT-AMT

           IF LNW-PAID-IN-FULL
               PERFORM 2200-PAYOFF
           ELSE
               PERFORM 2300-ADVANCE-NEXT-DUE
           END-IF
           PERFORM 2400-RECALC-PAST-DUE

           MOVE CTL-BUSINESS-DATE TO LOAN-LAST-MAINT-DATE
           MOVE 'LNPAYAP' TO LOAN-LAST-MAINT-USER
           REWRITE LOAN-RECORD
           IF WS-LOAN-STATUS NOT = '00'
               MOVE 'LOANMST' TO ABND-FILE-NAME
               MOVE WS-LOAN-STATUS TO ABND-FILE-STATUS
               MOVE 'REWRITE FAILED - LOAN MASTER' TO ABND-MESSAGE
               PERFORM 9900-ABEND
           END-IF
           ADD 1 TO WS-PMT-APPLIED
           ADD TRAN-AMOUNT TO WS-TOT-APPLIED
           PERFORM 8000-WRITE-HISTORY
           PERFORM 8100-WRITE-DETAIL.

       2200-PAYOFF.
           SET LOAN-PAID-OFF TO TRUE
           MOVE CTL-BUSINESS-DATE TO LOAN-STATUS-DATE
                                     LOAN-PAYOFF-DATE
           MOVE LNW-PAYOFF-AMT    TO LOAN-PAYOFF-AMT
           MOVE ZERO              TO LOAN-NEXT-DUE-DATE
                                     LOAN-DUE-COUNT
           MOVE 'N'               TO LOAN-AUTOPAY-FLAG
           ADD 1 TO WS-PAYOFFS.

      *----------------------------------------------------------------*
      * NEXT DUE DATE ADVANCES WHEN ITS INSTALLMENT IS PAID IN FULL    *
      *----------------------------------------------------------------*
       2300-ADVANCE-NEXT-DUE.
           IF WS-NEXT-DUE-BILLED NOT = 'Y'
               EXIT PARAGRAPH
           END-IF
           MOVE 'N' TO WS-NEXT-DUE-STILL-OPEN
           PERFORM VARYING WS-I FROM 1 BY 1
                   UNTIL WS-I > LOAN-DUE-COUNT
               IF LOAN-DUE-DATE(WS-I) = LOAN-NEXT-DUE-DATE
                   MOVE 'Y' TO WS-NEXT-DUE-STILL-OPEN
               END-IF
           END-PERFORM
           IF WS-NEXT-DUE-STILL-OPEN = 'N'
               IF LOAN-PAY-QUARTERLY
                   MOVE 3 TO WS-MONTHS
               ELSE
                   MOVE 1 TO WS-MONTHS
               END-IF
               INITIALIZE DATE-PARMS
               MOVE 'ADDM' TO DTU-FUNCTION
               MOVE LOAN-NEXT-DUE-DATE TO DTU-DATE-1
               MOVE WS-MONTHS TO DTU-NUMBER
               CALL 'DATEUTIL' USING DATE-PARMS
               IF DTU-OK
                   MOVE DTU-RESULT-DATE TO LOAN-NEXT-DUE-DATE
               END-IF
           END-IF.

      *----------------------------------------------------------------*
      * PAST DUE = INSTALLMENTS DUE BEFORE TODAY STILL IN THE TABLE    *
      *----------------------------------------------------------------*
       2400-RECALC-PAST-DUE.
           MOVE ZERO TO LOAN-PAST-DUE-PRIN LOAN-PAST-DUE-INT
                        LOAN-OLDEST-DUE-DATE
           PERFORM VARYING WS-I FROM 1 BY 1
                   UNTIL WS-I > LOAN-DUE-COUNT
               IF LOAN-DUE-DATE(WS-I) < CTL-BUSINESS-DATE
                   ADD LOAN-DUE-PRIN(WS-I) TO LOAN-PAST-DUE-PRIN
                   ADD LOAN-DUE-INT(WS-I)  TO LOAN-PAST-DUE-INT
                   IF LOAN-OLDEST-DUE-DATE = ZERO
                       MOVE LOAN-DUE-DATE(WS-I) TO LOAN-OLDEST-DUE-DATE
                   END-IF
               END-IF
           END-PERFORM
           MOVE LOAN-LATE-FEES-OUTST TO LOAN-PAST-DUE-FEES
           IF LOAN-OLDEST-DUE-DATE = ZERO
               MOVE ZERO TO LOAN-DAYS-PAST-DUE
           ELSE
               INITIALIZE DATE-PARMS
               MOVE 'DIFF' TO DTU-FUNCTION
               MOVE LOAN-OLDEST-DUE-DATE TO DTU-DATE-1
               MOVE CTL-BUSINESS-DATE    TO DTU-DATE-2
               CALL 'DATEUTIL' USING DATE-PARMS
               MOVE DTU-RESULT-NUMBER TO LOAN-DAYS-PAST-DUE
           END-IF.

      *================================================================*
       8000-WRITE-HISTORY.
           INITIALIZE LOAN-PAYMENT-HIST-RECORD
           MOVE LOAN-NUMBER          TO LPH-LOAN-NUMBER
           MOVE CTL-BUSINESS-DATE    TO LPH-PAYMENT-DATE
           MOVE TRAN-ID              TO LPH-TRAN-ID
           MOVE TRAN-ACCT-NUMBER     TO LPH-SOURCE-ACCT
           MOVE TRAN-AMOUNT          TO LPH-PAYMENT-AMT
           MOVE LNW-APPLIED-FEES     TO LPH-APPLIED-FEES
           MOVE LNW-APPLIED-INT      TO LPH-APPLIED-INT
           COMPUTE LPH-APPLIED-PRIN =
               LNW-APPLIED-PRIN + LNW-APPLIED-EXTRA-PRIN
           MOVE LNW-APPLIED-SUSPENSE TO LPH-APPLIED-SUSPENSE
           MOVE LOAN-PRINCIPAL-BAL   TO LPH-PRIN-BAL-AFTER
           MOVE LNW-WATERFALL-USED   TO LPH-WATERFALL
           MOVE LNW-PAYOFF-FLAG      TO LPH-PAYOFF-FLAG
           MOVE TRAN-CHANNEL         TO LPH-CHANNEL
           WRITE LOAN-PAYMENT-HIST-RECORD
           IF WS-HIST-STATUS NOT = '00'
               MOVE 'LNPAYHST' TO ABND-FILE-NAME
               MOVE WS-HIST-STATUS TO ABND-FILE-STATUS
               MOVE 'WRITE FAILED - PAYMENT HISTORY' TO ABND-MESSAGE
               PERFORM 9900-ABEND
           END-IF.

       8100-WRITE-DETAIL.
           MOVE SPACES               TO WS-D-NOTE
           MOVE LOAN-NUMBER          TO WS-D-LOAN
           MOVE TRAN-ACCT-NUMBER     TO WS-D-FROM
           MOVE TRAN-AMOUNT          TO WS-D-PMT
           MOVE LNW-WATERFALL-USED   TO WS-D-WF
           MOVE LNW-APPLIED-FEES     TO WS-D-FEES
           MOVE LNW-APPLIED-INT      TO WS-D-INT
           MOVE LNW-APPLIED-PRIN     TO WS-D-PRIN
           MOVE LNW-APPLIED-EXTRA-PRIN TO WS-D-EXTRA
           MOVE LNW-APPLIED-SUSPENSE TO WS-D-SUSP
           MOVE LOAN-PRINCIPAL-BAL   TO WS-D-BAL
           EVALUATE TRUE
               WHEN LNW-PAID-IN-FULL
                   MOVE 'PAID IN FULL' TO WS-D-NOTE
               WHEN LNW-WF-RECOVERY
                   MOVE 'CHARGE-OFF RECOVERY' TO WS-D-NOTE
               WHEN LOAN-DAYS-PAST-DUE > 0
                   MOVE 'PAST DUE' TO WS-D-NOTE
               WHEN OTHER
                   CONTINUE
           END-EVALUATE
           WRITE REPORT-LINE FROM WS-DTL.

       8500-WRITE-EXCEPTION.
           ADD 1 TO WS-PMT-EXCEPTIONS
           MOVE TRAN-ID            TO WS-E-TRAN
           MOVE TRAN-COUNTER-ACCT  TO WS-E-LOAN
           MOVE TRAN-AMOUNT        TO WS-E-PMT
           MOVE WS-EXCEPTION-REASON TO WS-E-REASON
           WRITE REPORT-LINE FROM WS-EXC.

       9000-TERMINATE.
           MOVE WS-TRAN-READ      TO WS-T-READ
           MOVE WS-PMT-SELECTED   TO WS-T-SEL
           MOVE WS-PMT-APPLIED    TO WS-T-APP
           MOVE WS-PMT-EXCEPTIONS TO WS-T-EXC
           MOVE WS-PAYOFFS        TO WS-T-PAYOFF
           MOVE WS-TOT-APPLIED    TO WS-T-AMT
           WRITE REPORT-LINE FROM WS-TRL
           CLOSE TRAN-FILE LOAN-FILE HIST-FILE REPORT-FILE
           DISPLAY 'LNPAYAP TRAN-READ=' WS-TRAN-READ
                   ' SELECTED=' WS-PMT-SELECTED
                   ' APPLIED=' WS-PMT-APPLIED
                   ' EXCEPTIONS=' WS-PMT-EXCEPTIONS
                   ' PAYOFFS=' WS-PAYOFFS
           IF WS-PMT-EXCEPTIONS > 0
               MOVE 4 TO RETURN-CODE
           ELSE
               MOVE 0 TO RETURN-CODE
           END-IF.

       9900-ABEND.
           MOVE 'LNPAYAP' TO ABND-PROGRAM
           MOVE '2100-APPLY-PAYMENT' TO ABND-PARAGRAPH
           MOVE 16 TO ABND-CODE
           CALL 'ABENDRTN' USING ABEND-PARMS.
