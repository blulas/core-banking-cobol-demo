      *================================================================*
      * PROGRAM  : UTACHVAL                                            *
      * TYPE     : UNIT TEST DRIVER                                    *
      * PURPOSE  : UNIT TESTS FOR ACHVALID                             *
      *================================================================*
       IDENTIFICATION DIVISION.
       PROGRAM-ID. UTACHVAL.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY TESTPARM.
       COPY AVLPARM.

       PROCEDURE DIVISION.
       0000-MAIN.
           MOVE 'INIT' TO TST-FUNCTION
           MOVE 'ACHVALID' TO TST-SUITE-NAME
           CALL 'TESTLIB' USING TEST-PARMS

           PERFORM 1000-TEST-ROUTING
           PERFORM 1100-TEST-CODES-AND-AMOUNTS
           PERFORM 1200-TEST-SEC

           MOVE 'SUMM' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS
           STOP RUN.

       1000-TEST-ROUTING.
           PERFORM 8000-RESET
           CALL 'ACHVALID' USING ACH-VALID-PARMS
           MOVE 'VALID PPD CREDIT TO OUR ABA 026000013 ACCEPTED'
             TO TST-CASE-NAME
           MOVE 'A' TO TST-EXPECTED
           MOVE AVL-RESULT TO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'COMPUTED CHECK DIGIT IS 3' TO TST-CASE-NAME
           MOVE 3 TO TST-EXP-NUM
           MOVE AVL-COMPUTED-CHECK-DIGIT TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8000-RESET
           MOVE '026000012' TO AVL-ROUTING
           CALL 'ACHVALID' USING ACH-VALID-PARMS
           MOVE 'BAD CHECK DIGIT REJECTED R28' TO TST-CASE-NAME
           MOVE 'R28' TO TST-EXPECTED
           MOVE AVL-RETURN-REASON TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE '500000007' TO AVL-ROUTING
           CALL 'ACHVALID' USING ACH-VALID-PARMS
           MOVE 'PREFIX 50 NOT A FED DISTRICT - RTPX' TO TST-CASE-NAME
           MOVE 'RTPX' TO TST-EXPECTED
           MOVE AVL-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ.

       1100-TEST-CODES-AND-AMOUNTS.
           PERFORM 8000-RESET
           MOVE '37' TO AVL-TRAN-CODE
           CALL 'ACHVALID' USING ACH-VALID-PARMS
           MOVE 'TC 37 IS A SAVINGS DEBIT' TO TST-CASE-NAME
           MOVE 'DS' TO TST-EXPECTED
           MOVE SPACES TO TST-ACTUAL
           STRING AVL-DR-CR AVL-ACCT-KIND DELIMITED BY SIZE
             INTO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE '24' TO AVL-TRAN-CODE
           CALL 'ACHVALID' USING ACH-VALID-PARMS
           MOVE 'TC 24 (ZERO DOLLAR REMITTANCE) NOT SUPPORTED'
             TO TST-CASE-NAME
           MOVE 'TCOD' TO TST-EXPECTED
           MOVE AVL-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE '23' TO AVL-TRAN-CODE
           MOVE ZERO TO AVL-AMOUNT
           CALL 'ACHVALID' USING ACH-VALID-PARMS
           MOVE 'ZERO DOLLAR PRENOTE ACCEPTED' TO TST-CASE-NAME
           MOVE 'Y' TO TST-EXPECTED
           MOVE AVL-PRENOTE-FLAG TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE '28' TO AVL-TRAN-CODE
           MOVE 1.00 TO AVL-AMOUNT
           CALL 'ACHVALID' USING ACH-VALID-PARMS
           MOVE 'PRENOTE WITH AMOUNT REJECTED' TO TST-CASE-NAME
           MOVE 'PREA' TO TST-EXPECTED
           MOVE AVL-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE ZERO TO AVL-AMOUNT
           CALL 'ACHVALID' USING ACH-VALID-PARMS
           MOVE 'LIVE ENTRY ZERO AMOUNT REJECTED' TO TST-CASE-NAME
           MOVE 'AMT0' TO TST-EXPECTED
           MOVE AVL-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ.

       1200-TEST-SEC.
           PERFORM 8000-RESET
           MOVE 'IAT' TO AVL-SEC-CODE
           CALL 'ACHVALID' USING ACH-VALID-PARMS
           MOVE 'IAT NOT SUPPORTED' TO TST-CASE-NAME
           MOVE 'IATX' TO TST-EXPECTED
           MOVE AVL-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'TEL' TO AVL-SEC-CODE
           CALL 'ACHVALID' USING ACH-VALID-PARMS
           MOVE 'TEL SEC CODE NOT SUPPORTED' TO TST-CASE-NAME
           MOVE 'SECU' TO TST-EXPECTED
           MOVE AVL-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'CCD' TO AVL-SEC-CODE
           MOVE '27'  TO AVL-TRAN-CODE
           MOVE 'I'   TO AVL-ACCT-TYPE
           CALL 'ACHVALID' USING ACH-VALID-PARMS
           MOVE 'CCD DEBIT TO CONSUMER ACCOUNT RETURNS R05'
             TO TST-CASE-NAME
           MOVE 'R05' TO TST-EXPECTED
           MOVE AVL-RETURN-REASON TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'CCD' TO AVL-SEC-CODE
           MOVE 'C'   TO AVL-ACCT-TYPE
           CALL 'ACHVALID' USING ACH-VALID-PARMS
           MOVE 'CCD CREDIT TO CORPORATE ACCOUNT ACCEPTED'
             TO TST-CASE-NAME
           MOVE 0 TO TST-EXP-NUM
           MOVE AVL-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8000-RESET
           MOVE 'WEB' TO AVL-SEC-CODE
           MOVE '27'  TO AVL-TRAN-CODE
           MOVE 'N'   TO AVL-AUTH-FLAG
           CALL 'ACHVALID' USING ACH-VALID-PARMS
           MOVE 'WEB DEBIT WITHOUT AUTHORIZATION R10' TO TST-CASE-NAME
           MOVE 'R10' TO TST-EXPECTED
           MOVE AVL-RETURN-REASON TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'WEB' TO AVL-SEC-CODE
           MOVE '27'  TO AVL-TRAN-CODE
           MOVE 'Y'   TO AVL-AUTH-FLAG
           CALL 'ACHVALID' USING ACH-VALID-PARMS
           MOVE 'WEB DEBIT WITH AUTHORIZATION ACCEPTED'
             TO TST-CASE-NAME
           MOVE 'A' TO TST-EXPECTED
           MOVE AVL-RESULT TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'C' TO AVL-ACCT-TYPE
           CALL 'ACHVALID' USING ACH-VALID-PARMS
           MOVE 'PPD TO CORPORATE ACCOUNT IS WARNING RC 04'
             TO TST-CASE-NAME
           MOVE 4 TO TST-EXP-NUM
           MOVE AVL-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       8000-RESET.
           INITIALIZE ACH-VALID-PARMS
           MOVE '026000013' TO AVL-ROUTING
           MOVE '22'  TO AVL-TRAN-CODE
           MOVE 4250.00 TO AVL-AMOUNT
           MOVE 'PPD' TO AVL-SEC-CODE
           MOVE 'I'   TO AVL-ACCT-TYPE
           MOVE 'Y'   TO AVL-AUTH-FLAG.

       9000-NEQ.
           MOVE 'NEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.

       9100-AEQ.
           MOVE 'AEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.
