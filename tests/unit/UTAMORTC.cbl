      *================================================================*
      * PROGRAM  : UTAMORTC                                            *
      * TYPE     : UNIT TEST DRIVER                                    *
      * PURPOSE  : UNIT TESTS FOR AMORTCLC                             *
      *================================================================*
       IDENTIFICATION DIVISION.
       PROGRAM-ID. UTAMORTC.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY TESTPARM.
       COPY AMRTPARM.

       PROCEDURE DIVISION.
       0000-MAIN.
           MOVE 'INIT' TO TST-FUNCTION
           MOVE 'AMORTCLC' TO TST-SUITE-NAME
           CALL 'TESTLIB' USING TEST-PARMS

           PERFORM 1000-CONSUMER-PAYMENT
           PERFORM 1100-SCHEDULE-LINE
           PERFORM 1200-COMMERCIAL-PAYMENTS
           PERFORM 1300-CRE-IO-BALLOON
           PERFORM 1400-MAX-PRINCIPAL
           PERFORM 1500-EDGE-CASES

           MOVE 'SUMM' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS
           STOP RUN.

       1000-CONSUMER-PAYMENT.
      *    15,000 AT 7.74% FOR 36 MONTHS: RAW 468.2437 ROUNDS UP
           PERFORM 8000-SET-ALEX
           MOVE 'PMT ' TO AMT-FUNCTION
           CALL 'AMORTCLC' USING AMORT-PARMS
           MOVE 'LPER 15000 7.74% 36M PAYMENT ROUNDED UP 468.25'
             TO TST-CASE-NAME
           MOVE 468.25 TO TST-EXP-NUM
           MOVE AMT-PAYMENT-AMT TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'LPER FINAL PAYMENT ADJUSTED DOWN TO 468.18'
             TO TST-CASE-NAME
           MOVE 468.18 TO TST-EXP-NUM
           MOVE AMT-FINAL-PAYMENT-AMT TO TST-ACT-NUM
           PERFORM 9000-NEQ

           INITIALIZE AMORT-PARMS
           MOVE 'PMT ' TO AMT-FUNCTION
           MOVE 8000.00 TO AMT-PRINCIPAL
           MOVE 19.99   TO AMT-ANNUAL-RATE
           MOVE '3'     TO AMT-ACCRUAL-BASIS
           MOVE 'M'     TO AMT-PAYMENT-FREQ
           MOVE 36      TO AMT-TERM-MONTHS
           CALL 'AMORTCLC' USING AMORT-PARMS
           MOVE 'LPER 8000 19.99% 36M PAYMENT 297.27' TO TST-CASE-NAME
           MOVE 297.27 TO TST-EXP-NUM
           MOVE AMT-PAYMENT-AMT TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1100-SCHEDULE-LINE.
      *    PERIOD 1: INTEREST 15000 X .00645 = 96.75
           PERFORM 8000-SET-ALEX
           MOVE 'LINE' TO AMT-FUNCTION
           MOVE 1 TO AMT-PERIOD-NUMBER
           CALL 'AMORTCLC' USING AMORT-PARMS
           MOVE 'LINE 1 INTEREST 96.75' TO TST-CASE-NAME
           MOVE 96.75 TO TST-EXP-NUM
           MOVE AMT-LINE-INTEREST TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'LINE 1 PRINCIPAL 371.50' TO TST-CASE-NAME
           MOVE 371.50 TO TST-EXP-NUM
           MOVE AMT-LINE-PRINCIPAL TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'LINE 1 ENDING BALANCE 14628.50' TO TST-CASE-NAME
           MOVE 14628.50 TO TST-EXP-NUM
           MOVE AMT-LINE-END-BAL TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8000-SET-ALEX
           MOVE 'LINE' TO AMT-FUNCTION
           MOVE 17 TO AMT-PERIOD-NUMBER
           CALL 'AMORTCLC' USING AMORT-PARMS
           MOVE 'LINE 17 ENDING BALANCE 8347.86 (SEED)'
             TO TST-CASE-NAME
           MOVE 8347.86 TO TST-EXP-NUM
           MOVE AMT-LINE-END-BAL TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8000-SET-ALEX
           MOVE 'LINE' TO AMT-FUNCTION
           MOVE 36 TO AMT-PERIOD-NUMBER
           CALL 'AMORTCLC' USING AMORT-PARMS
           MOVE 'LINE 36 IS FINAL, ENDS AT ZERO' TO TST-CASE-NAME
           MOVE 'F0' TO TST-EXPECTED
           MOVE SPACES TO TST-ACTUAL
           MOVE AMT-LINE-TYPE TO TST-ACTUAL(1:1)
           IF AMT-LINE-END-BAL = ZERO
               MOVE '0' TO TST-ACTUAL(2:1)
           END-IF
           PERFORM 9100-AEQ.

       1200-COMMERCIAL-PAYMENTS.
      *    ACTUAL/360 PERIODIC RATE GROSSED UP BY 365/360
           INITIALIZE AMORT-PARMS
           MOVE 'PMT ' TO AMT-FUNCTION
           MOVE 25000000.00 TO AMT-PRINCIPAL
           MOVE 6.05    TO AMT-ANNUAL-RATE
           MOVE 'A'     TO AMT-ACCRUAL-BASIS
           MOVE 'Q'     TO AMT-PAYMENT-FREQ
           MOVE 84      TO AMT-TERM-MONTHS
           CALL 'AMORTCLC' USING AMORT-PARMS
           MOVE 'ACT/360 QUARTERLY PERIODIC RATE .015335069444444'
             TO TST-CASE-NAME
           MOVE 0.015335069444444 TO TST-EXP-NUM
           MOVE AMT-PERIODIC-RATE TO TST-ACT-NUM
           COMPUTE TST-ACT-NUM ROUNDED = AMT-PERIODIC-RATE
           MOVE 0.015335 TO TST-EXP-NUM
           PERFORM 9000-NEQ
           MOVE 'LNTM 25MM 6.05% ACT/360 QUARTERLY 28 PMTS 1104946.94'
             TO TST-CASE-NAME
           MOVE 1104946.94 TO TST-EXP-NUM
           MOVE AMT-PAYMENT-AMT TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'LNTM QUARTERLY NUMBER OF PAYMENTS 28' TO TST-CASE-NAME
           MOVE 28 TO TST-EXP-NUM
           MOVE AMT-NUM-PAYMENTS TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1300-CRE-IO-BALLOON.
           PERFORM 8100-SET-CRE
           MOVE 'PMT ' TO AMT-FUNCTION
           CALL 'AMORTCLC' USING AMORT-PARMS
           MOVE 'LCRE IO PAYMENT 3.2MM X 6.75%/12 = 18000.00'
             TO TST-CASE-NAME
           MOVE 18000.00 TO TST-EXP-NUM
           MOVE AMT-IO-PAYMENT-AMT TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'LCRE P&I PAYMENT ON 25 YEAR AMORTIZATION 22109.17'
             TO TST-CASE-NAME
           MOVE 22109.17 TO TST-EXP-NUM
           MOVE AMT-PAYMENT-AMT TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'LCRE BALLOON AT MONTH 120 = 2700947.75'
             TO TST-CASE-NAME
           MOVE 2700947.75 TO TST-EXP-NUM
           MOVE AMT-BALLOON-AMT TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8100-SET-CRE
           MOVE 'LINE' TO AMT-FUNCTION
           MOVE 24 TO AMT-PERIOD-NUMBER
           CALL 'AMORTCLC' USING AMORT-PARMS
           MOVE 'LCRE PERIOD 24 IS INTEREST ONLY, NO PRINCIPAL'
             TO TST-CASE-NAME
           MOVE 'I' TO TST-EXPECTED
           MOVE AMT-LINE-TYPE TO TST-ACTUAL
           IF AMT-LINE-PRINCIPAL NOT = ZERO
               MOVE 'X' TO TST-ACTUAL
           END-IF
           PERFORM 9100-AEQ

           PERFORM 8100-SET-CRE
           MOVE 'LINE' TO AMT-FUNCTION
           MOVE 25 TO AMT-PERIOD-NUMBER
           CALL 'AMORTCLC' USING AMORT-PARMS
           MOVE 'LCRE PERIOD 25 FIRST AMORTIZING PRINCIPAL 4109.17'
             TO TST-CASE-NAME
           MOVE 4109.17 TO TST-EXP-NUM
           MOVE AMT-LINE-PRINCIPAL TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8100-SET-CRE
           MOVE 'LINE' TO AMT-FUNCTION
           MOVE 120 TO AMT-PERIOD-NUMBER
           CALL 'AMORTCLC' USING AMORT-PARMS
           MOVE 'LCRE PERIOD 120 LINE TYPE IS BALLOON' TO TST-CASE-NAME
           MOVE 'B' TO TST-EXPECTED
           MOVE AMT-LINE-TYPE TO TST-ACTUAL
           PERFORM 9100-AEQ.

       1400-MAX-PRINCIPAL.
           INITIALIZE AMORT-PARMS
           MOVE 'MAXP'  TO AMT-FUNCTION
           MOVE 468.25  TO AMT-PAYMENT-AMT
           MOVE 7.74    TO AMT-ANNUAL-RATE
           MOVE '3'     TO AMT-ACCRUAL-BASIS
           MOVE 'M'     TO AMT-PAYMENT-FREQ
           MOVE 36      TO AMT-TERM-MONTHS
           CALL 'AMORTCLC' USING AMORT-PARMS
           MOVE 'MAXP 468.25 / 7.74% / 36M = 15000.05 (TRUNCATED)'
             TO TST-CASE-NAME
           MOVE 15000.05 TO TST-EXP-NUM
           MOVE AMT-MAX-PRINCIPAL TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1500-EDGE-CASES.
           INITIALIZE AMORT-PARMS
           MOVE 'PMT ' TO AMT-FUNCTION
           MOVE 12000.00 TO AMT-PRINCIPAL
           MOVE ZERO    TO AMT-ANNUAL-RATE
           MOVE '3'     TO AMT-ACCRUAL-BASIS
           MOVE 'M'     TO AMT-PAYMENT-FREQ
           MOVE 12      TO AMT-TERM-MONTHS
           CALL 'AMORTCLC' USING AMORT-PARMS
           MOVE 'ZERO RATE 12000 / 12 = 1000.00' TO TST-CASE-NAME
           MOVE 1000.00 TO TST-EXP-NUM
           MOVE AMT-PAYMENT-AMT TO TST-ACT-NUM
           PERFORM 9000-NEQ

           INITIALIZE AMORT-PARMS
           MOVE 'PMT ' TO AMT-FUNCTION
           MOVE 12000.00 TO AMT-PRINCIPAL
           MOVE 5.00    TO AMT-ANNUAL-RATE
           MOVE 'M'     TO AMT-PAYMENT-FREQ
           MOVE ZERO    TO AMT-TERM-MONTHS
           CALL 'AMORTCLC' USING AMORT-PARMS
           MOVE 'ZERO TERM REJECTED RC 12' TO TST-CASE-NAME
           MOVE 12 TO TST-EXP-NUM
           MOVE AMT-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8100-SET-CRE
           MOVE 'LINE' TO AMT-FUNCTION
           MOVE 121 TO AMT-PERIOD-NUMBER
           CALL 'AMORTCLC' USING AMORT-PARMS
           MOVE 'PERIOD BEYOND MATURITY REJECTED RC 12'
             TO TST-CASE-NAME
           MOVE 12 TO TST-EXP-NUM
           MOVE AMT-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       8000-SET-ALEX.
           INITIALIZE AMORT-PARMS
           MOVE 15000.00 TO AMT-PRINCIPAL
           MOVE 7.74    TO AMT-ANNUAL-RATE
           MOVE '3'     TO AMT-ACCRUAL-BASIS
           MOVE 'M'     TO AMT-PAYMENT-FREQ
           MOVE 36      TO AMT-TERM-MONTHS.

       8100-SET-CRE.
           INITIALIZE AMORT-PARMS
           MOVE 3200000.00 TO AMT-PRINCIPAL
           MOVE 6.75    TO AMT-ANNUAL-RATE
           MOVE '0'     TO AMT-ACCRUAL-BASIS
           MOVE 'M'     TO AMT-PAYMENT-FREQ
           MOVE 120     TO AMT-TERM-MONTHS
           MOVE 300     TO AMT-AMORT-MONTHS
           MOVE 24      TO AMT-IO-MONTHS.

       9000-NEQ.
           MOVE 'NEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.

       9100-AEQ.
           MOVE 'AEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.
