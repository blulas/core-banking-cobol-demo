      *================================================================*
      * PROGRAM  : UTCDPENL                                            *
      * TYPE     : UNIT TEST DRIVER                                    *
      * PURPOSE  : UNIT TESTS FOR CDPENLTY (CD EARLY WITHDRAWAL)       *
      *================================================================*
       IDENTIFICATION DIVISION.
       PROGRAM-ID. UTCDPENL.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY TESTPARM.
       COPY CDPPARM.

       PROCEDURE DIVISION.
       0000-MAIN.
           MOVE 'INIT' TO TST-FUNCTION
           MOVE 'CDPENLTY' TO TST-SUITE-NAME
           CALL 'TESTLIB' USING TEST-PARMS

           PERFORM 1000-TEST-STANDARD-PENALTY
           PERFORM 2000-TEST-PRINCIPAL-INVASION
           PERFORM 3000-TEST-NO-PENALTY-CD
           PERFORM 4000-TEST-WAIVERS

           MOVE 'SUMM' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS
           STOP RUN.

       1000-TEST-STANDARD-PENALTY.
           PERFORM 8000-CD12-BASE
           CALL 'CDPENLTY' USING CDPENLTY-PARMS
           MOVE 'CD12 180 DAYS ON 50,000 @ 4.65 = 1,146.58'
             TO TST-CASE-NAME
           MOVE 1146.58 TO TST-EXP-NUM
           MOVE CDP-PENALTY-AMT TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'CD12 NET = PRINCIPAL + INTEREST - PENALTY'
             TO TST-CASE-NAME
           MOVE 50453.42 TO TST-EXP-NUM
           MOVE CDP-NET-PROCEEDS TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8000-CD12-BASE
           MOVE 10000.00 TO CDP-WITHDRAWAL-AMT
           CALL 'CDPENLTY' USING CDPENLTY-PARMS
           MOVE 'PARTIAL 10,000 PENALTY 229.32 FROM INTEREST'
             TO TST-CASE-NAME
           MOVE 229.32 TO TST-EXP-NUM
           MOVE CDP-PENALTY-FROM-INT TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'PARTIAL WITHDRAWAL NET PROCEEDS 10,000'
             TO TST-CASE-NAME
           MOVE 10000.00 TO TST-EXP-NUM
           MOVE CDP-NET-PROCEEDS TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8000-CD12-BASE
           MOVE 60000.00 TO CDP-WITHDRAWAL-AMT
           CALL 'CDPENLTY' USING CDPENLTY-PARMS
           MOVE 'WITHDRAWAL OVER PRINCIPAL RC 08' TO TST-CASE-NAME
           MOVE 8 TO TST-EXP-NUM
           MOVE CDP-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       2000-TEST-PRINCIPAL-INVASION.
      *    CD06 MAY NOT INVADE PRINCIPAL - CAPPED AT EARNED INTEREST
           INITIALIZE CDPENLTY-PARMS
           MOVE 'CD06' TO CDP-PRODUCT-CODE
           MOVE 90 TO CDP-PENALTY-DAYS
           MOVE 25000.00 TO CDP-PRINCIPAL
           MOVE 4.400000 TO CDP-INT-RATE
           MOVE 20260515 TO CDP-FUNDING-DATE
           MOVE 20261115 TO CDP-MATURITY-DATE
           MOVE 20260930 TO CDP-WITHDRAWAL-DATE
           MOVE 50.000000 TO CDP-ACCRUED-INT
           MOVE 'N' TO CDP-OWNER-DECEASED
           CALL 'CDPENLTY' USING CDPENLTY-PARMS
           MOVE 'CD06 PENALTY CAPPED AT EARNED INTEREST 50.00'
             TO TST-CASE-NAME
           MOVE 50.00 TO TST-EXP-NUM
           MOVE CDP-PENALTY-AMT TO TST-ACT-NUM
           PERFORM 9000-NEQ

      *    CD36 INVADES PRINCIPAL
           INITIALIZE CDPENLTY-PARMS
           MOVE 'CD36' TO CDP-PRODUCT-CODE
           MOVE 365 TO CDP-PENALTY-DAYS
           MOVE 500000.00 TO CDP-PRINCIPAL
           MOVE 4.250000 TO CDP-INT-RATE
           MOVE 20250115 TO CDP-FUNDING-DATE
           MOVE 20280115 TO CDP-MATURITY-DATE
           MOVE 20260930 TO CDP-WITHDRAWAL-DATE
           MOVE 1000.000000 TO CDP-ACCRUED-INT
           MOVE 'N' TO CDP-OWNER-DECEASED
           CALL 'CDPENLTY' USING CDPENLTY-PARMS
           MOVE 'CD36 365 DAYS ON 500,000 = 21,250.00'
             TO TST-CASE-NAME
           MOVE 21250.00 TO TST-EXP-NUM
           MOVE CDP-PENALTY-AMT TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'CD36 PENALTY INVADES PRINCIPAL 20,250.00'
             TO TST-CASE-NAME
           MOVE 20250.00 TO TST-EXP-NUM
           MOVE CDP-PENALTY-FROM-PRIN TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       3000-TEST-NO-PENALTY-CD.
           PERFORM 8100-CDNP-BASE
           MOVE 20260930 TO CDP-WITHDRAWAL-DATE
           CALL 'CDPENLTY' USING CDPENLTY-PARMS
           MOVE 'CDNP AFTER 7 DAYS NO PENALTY (NP)' TO TST-CASE-NAME
           MOVE 'NP' TO TST-EXPECTED
           MOVE CDP-WAIVER-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8100-CDNP-BASE
           MOVE 20260526 TO CDP-WITHDRAWAL-DATE
           CALL 'CDPENLTY' USING CDPENLTY-PARMS
           MOVE 'CDNP DAY 6 REG D 7 DAYS INTEREST = 76.71'
             TO TST-CASE-NAME
           MOVE 76.71 TO TST-EXP-NUM
           MOVE CDP-PENALTY-AMT TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'REG D PENALTY MAY INVADE PRINCIPAL 11.71'
             TO TST-CASE-NAME
           MOVE 11.71 TO TST-EXP-NUM
           MOVE CDP-PENALTY-FROM-PRIN TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8100-CDNP-BASE
           MOVE 20260527 TO CDP-WITHDRAWAL-DATE
           CALL 'CDPENLTY' USING CDPENLTY-PARMS
           MOVE 'CDNP DAY 7 NO PENALTY RC 04' TO TST-CASE-NAME
           MOVE 4 TO TST-EXP-NUM
           MOVE CDP-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       4000-TEST-WAIVERS.
           PERFORM 8000-CD12-BASE
           MOVE 20260930 TO CDP-WITHDRAWAL-DATE
           CALL 'CDPENLTY' USING CDPENLTY-PARMS
           MOVE 'WITHDRAWAL ON MATURITY DATE WAIVED MT'
             TO TST-CASE-NAME
           MOVE 'MT' TO TST-EXPECTED
           MOVE CDP-WAIVER-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ

      *    RENEWED CD: NEW MATURITY 2027-09-30, GRACE TO 2026-10-10
           PERFORM 8000-CD12-BASE
           MOVE 20270930 TO CDP-MATURITY-DATE
           MOVE 20261010 TO CDP-GRACE-END-DATE
           MOVE 20261010 TO CDP-WITHDRAWAL-DATE
           MOVE 30.000000 TO CDP-ACCRUED-INT
           CALL 'CDPENLTY' USING CDPENLTY-PARMS
           MOVE 'DAY 10 OF GRACE PERIOD WAIVED GP' TO TST-CASE-NAME
           MOVE 'GP' TO TST-EXPECTED
           MOVE CDP-WAIVER-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ

           MOVE 20261011 TO CDP-WITHDRAWAL-DATE
           CALL 'CDPENLTY' USING CDPENLTY-PARMS
           MOVE 'DAY 11 AFTER RENEWAL PENALTY APPLIES (30.00)'
             TO TST-CASE-NAME
           MOVE 30.00 TO TST-EXP-NUM
           MOVE CDP-PENALTY-AMT TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8000-CD12-BASE
           MOVE 'Y' TO CDP-OWNER-DECEASED
           CALL 'CDPENLTY' USING CDPENLTY-PARMS
           MOVE 'DEATH OF OWNER WAIVED DC' TO TST-CASE-NAME
           MOVE 'DC' TO TST-EXPECTED
           MOVE CDP-WAIVER-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'DEATH OF OWNER PENALTY ZERO' TO TST-CASE-NAME
           MOVE 0 TO TST-EXP-NUM
           MOVE CDP-PENALTY-AMT TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       8000-CD12-BASE.
           INITIALIZE CDPENLTY-PARMS
           MOVE 'CD12' TO CDP-PRODUCT-CODE
           MOVE 180 TO CDP-PENALTY-DAYS
           MOVE 50000.00 TO CDP-PRINCIPAL
           MOVE 4.650000 TO CDP-INT-RATE
           MOVE 20250930 TO CDP-FUNDING-DATE
           MOVE 20260930 TO CDP-MATURITY-DATE
           MOVE 20260601 TO CDP-WITHDRAWAL-DATE
           MOVE 1600.000000 TO CDP-ACCRUED-INT
           MOVE 'N' TO CDP-OWNER-DECEASED.

       8100-CDNP-BASE.
           INITIALIZE CDPENLTY-PARMS
           MOVE 'CDNP' TO CDP-PRODUCT-CODE
           MOVE 0 TO CDP-PENALTY-DAYS
           MOVE 100000.00 TO CDP-PRINCIPAL
           MOVE 4.000000 TO CDP-INT-RATE
           MOVE 20260520 TO CDP-FUNDING-DATE
           MOVE 20270420 TO CDP-MATURITY-DATE
           MOVE 65.000000 TO CDP-ACCRUED-INT
           MOVE 'N' TO CDP-OWNER-DECEASED.

       9000-NEQ.
           MOVE 'NEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.

       9100-AEQ.
           MOVE 'AEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.
