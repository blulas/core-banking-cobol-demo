      *================================================================*
      * PROGRAM  : UTDATEUT                                            *
      * TYPE     : UNIT TEST DRIVER                                    *
      * PURPOSE  : UNIT TESTS FOR DATEUTIL                             *
      *================================================================*
       IDENTIFICATION DIVISION.
       PROGRAM-ID. UTDATEUT.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY TESTPARM.
       COPY DATEPARM.

       PROCEDURE DIVISION.
       0000-MAIN.
           MOVE 'INIT' TO TST-FUNCTION
           MOVE 'DATEUTIL' TO TST-SUITE-NAME
           CALL 'TESTLIB' USING TEST-PARMS

           PERFORM 1000-TEST-ADD-DAYS
           PERFORM 1100-TEST-BUSINESS-DAYS
           PERFORM 1200-TEST-DIFF
           PERFORM 1300-TEST-30-360
           PERFORM 1400-TEST-MONTH-FUNCTIONS
           PERFORM 1500-TEST-VALIDATION

           MOVE 'SUMM' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS
           STOP RUN.

       1000-TEST-ADD-DAYS.
           INITIALIZE DATE-PARMS
           SET DTU-ADD-DAYS TO TRUE
           MOVE 20261230 TO DTU-DATE-1
           MOVE 5        TO DTU-NUMBER
           CALL 'DATEUTIL' USING DATE-PARMS
           MOVE 'ADDD CROSSES YEAR END' TO TST-CASE-NAME
           MOVE 20270104 TO TST-EXP-NUM
           MOVE DTU-RESULT-DATE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1100-TEST-BUSINESS-DAYS.
      *    FRI 2026-09-04 + 1 BUS DAY SKIPS WEEKEND AND LABOR DAY
           INITIALIZE DATE-PARMS
           SET DTU-ADD-BUS-DAYS TO TRUE
           MOVE 20260904 TO DTU-DATE-1
           MOVE 1        TO DTU-NUMBER
           CALL 'DATEUTIL' USING DATE-PARMS
           MOVE 'ADDB SKIPS WEEKEND AND LABOR DAY' TO TST-CASE-NAME
           MOVE 20260908 TO TST-EXP-NUM
           MOVE DTU-RESULT-DATE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           INITIALIZE DATE-PARMS
           SET DTU-ADD-BUS-DAYS TO TRUE
           MOVE 20261003 TO DTU-DATE-1
           MOVE 0        TO DTU-NUMBER
           CALL 'DATEUTIL' USING DATE-PARMS
           MOVE 'ADDB ZERO ROLLS SATURDAY TO MONDAY'
             TO TST-CASE-NAME
           MOVE 20261005 TO TST-EXP-NUM
           MOVE DTU-RESULT-DATE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           INITIALIZE DATE-PARMS
           SET DTU-IS-BUS-DAY TO TRUE
           MOVE 20260703 TO DTU-DATE-1
           CALL 'DATEUTIL' USING DATE-PARMS
           MOVE 'ISBD JUL 3 2026 IS A BUSINESS DAY (SAT HOLIDAY)'
             TO TST-CASE-NAME
           MOVE 'Y' TO TST-EXPECTED
           MOVE DTU-RESULT-FLAG TO TST-ACTUAL
           PERFORM 9100-AEQ

           INITIALIZE DATE-PARMS
           SET DTU-DAY-OF-WEEK TO TRUE
           MOVE 20260930 TO DTU-DATE-1
           CALL 'DATEUTIL' USING DATE-PARMS
           MOVE 'DOWK 2026-09-30 IS WEDNESDAY' TO TST-CASE-NAME
           MOVE 3 TO TST-EXP-NUM
           MOVE DTU-RESULT-NUMBER TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1200-TEST-DIFF.
           INITIALIZE DATE-PARMS
           SET DTU-DAYS-BETWEEN TO TRUE
           MOVE 20240201 TO DTU-DATE-1
           MOVE 20240301 TO DTU-DATE-2
           CALL 'DATEUTIL' USING DATE-PARMS
           MOVE 'DIFF FEB IN LEAP YEAR = 29' TO TST-CASE-NAME
           MOVE 29 TO TST-EXP-NUM
           MOVE DTU-RESULT-NUMBER TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1300-TEST-30-360.
           INITIALIZE DATE-PARMS
           SET DTU-DAYS-30-360 TO TRUE
           MOVE 20260131 TO DTU-DATE-1
           MOVE 20260331 TO DTU-DATE-2
           CALL 'DATEUTIL' USING DATE-PARMS
           MOVE 'D360 JAN31 TO MAR31 = 60' TO TST-CASE-NAME
           MOVE 60 TO TST-EXP-NUM
           MOVE DTU-RESULT-NUMBER TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1400-TEST-MONTH-FUNCTIONS.
           INITIALIZE DATE-PARMS
           SET DTU-ADD-MONTHS TO TRUE
           MOVE 20260131 TO DTU-DATE-1
           MOVE 1        TO DTU-NUMBER
           CALL 'DATEUTIL' USING DATE-PARMS
           MOVE 'ADDM JAN 31 + 1 CLAMPS TO FEB 28' TO TST-CASE-NAME
           MOVE 20260228 TO TST-EXP-NUM
           MOVE DTU-RESULT-DATE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           INITIALIZE DATE-PARMS
           SET DTU-ADD-MONTHS TO TRUE
           MOVE 20261115 TO DTU-DATE-1
           MOVE 12       TO DTU-NUMBER
           CALL 'DATEUTIL' USING DATE-PARMS
           MOVE 'ADDM + 12 MONTHS' TO TST-CASE-NAME
           MOVE 20271115 TO TST-EXP-NUM
           MOVE DTU-RESULT-DATE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           INITIALIZE DATE-PARMS
           SET DTU-LAST-BUS-DAY-MONTH TO TRUE
           MOVE 20261015 TO DTU-DATE-1
           CALL 'DATEUTIL' USING DATE-PARMS
           MOVE 'LBDM OCT 2026 = FRI OCT 30' TO TST-CASE-NAME
           MOVE 20261030 TO TST-EXP-NUM
           MOVE DTU-RESULT-DATE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           INITIALIZE DATE-PARMS
           SET DTU-DAYS-IN-YEAR TO TRUE
           MOVE 20280601 TO DTU-DATE-1
           CALL 'DATEUTIL' USING DATE-PARMS
           MOVE 'DIYR 2028 = 366' TO TST-CASE-NAME
           MOVE 366 TO TST-EXP-NUM
           MOVE DTU-RESULT-NUMBER TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1500-TEST-VALIDATION.
           INITIALIZE DATE-PARMS
           SET DTU-VALIDATE TO TRUE
           MOVE 20260230 TO DTU-DATE-1
           CALL 'DATEUTIL' USING DATE-PARMS
           MOVE 'VALD REJECTS FEB 30' TO TST-CASE-NAME
           MOVE 'N' TO TST-EXPECTED
           MOVE DTU-RESULT-FLAG TO TST-ACTUAL
           PERFORM 9100-AEQ

           INITIALIZE DATE-PARMS
           SET DTU-ADD-DAYS TO TRUE
           MOVE 20261301 TO DTU-DATE-1
           CALL 'DATEUTIL' USING DATE-PARMS
           MOVE 'INVALID DATE RETURNS RC 08' TO TST-CASE-NAME
           MOVE 8 TO TST-EXP-NUM
           MOVE DTU-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       9000-NEQ.
           MOVE 'NEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.

       9100-AEQ.
           MOVE 'AEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.
