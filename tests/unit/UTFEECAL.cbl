      *================================================================*
      * PROGRAM  : UTFEECAL                                            *
      * TYPE     : UNIT TEST DRIVER                                    *
      * PURPOSE  : UNIT TESTS FOR FEECALC (SERVICE FEE AMOUNTS)        *
      *================================================================*
       IDENTIFICATION DIVISION.
       PROGRAM-ID. UTFEECAL.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY TESTPARM.
       COPY FEEPARM.

       PROCEDURE DIVISION.
       0000-MAIN.
           MOVE 'INIT' TO TST-FUNCTION
           MOVE 'FEECALC' TO TST-SUITE-NAME
           CALL 'TESTLIB' USING TEST-PARMS

           PERFORM 1000-TEST-MAINTENANCE
           PERFORM 2000-TEST-WIRES
           PERFORM 3000-TEST-OTHER

           MOVE 'SUMM' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS
           STOP RUN.

       1000-TEST-MAINTENANCE.
           PERFORM 8000-RESET
           MOVE 'MNTH' TO FEE-TYPE
           MOVE 'DDAP' TO FEE-PRODUCT-CODE
           CALL 'FEECALC' USING FEECALC-PARMS
           MOVE 'DDAP MAINTENANCE FEE 12.00' TO TST-CASE-NAME
           MOVE 12.00 TO TST-EXP-NUM
           MOVE FEE-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'MAINTENANCE FEE POSTS AS WFMN' TO TST-CASE-NAME
           MOVE 'WFMN' TO TST-EXPECTED
           MOVE FEE-TRAN-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ

           MOVE 'DDPR' TO FEE-PRODUCT-CODE
           CALL 'FEECALC' USING FEECALC-PARMS
           MOVE 'DDPR MAINTENANCE FEE 25.00' TO TST-CASE-NAME
           MOVE 25.00 TO TST-EXP-NUM
           MOVE FEE-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ

           MOVE 'MMKT' TO FEE-PRODUCT-CODE
           CALL 'FEECALC' USING FEECALC-PARMS
           MOVE 'MMKT MAINTENANCE FEE 15.00' TO TST-CASE-NAME
           MOVE 15.00 TO TST-EXP-NUM
           MOVE FEE-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ

           MOVE 'SVST' TO FEE-PRODUCT-CODE
           MOVE 3 TO FEE-ITEM-COUNT
           CALL 'FEECALC' USING FEECALC-PARMS
           MOVE 'SVST FEE 5.00 (ITEM COUNT IGNORED)' TO TST-CASE-NAME
           MOVE 5.00 TO TST-EXP-NUM
           MOVE FEE-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ

           MOVE 'HYSV' TO FEE-PRODUCT-CODE
           CALL 'FEECALC' USING FEECALC-PARMS
           MOVE 'HYSV HAS NO MAINTENANCE FEE RC 04' TO TST-CASE-NAME
           MOVE 4 TO TST-EXP-NUM
           MOVE FEE-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       2000-TEST-WIRES.
           PERFORM 8000-RESET
           MOVE 'WDOM' TO FEE-TYPE
           CALL 'FEECALC' USING FEECALC-PARMS
           MOVE 'OUTGOING DOMESTIC WIRE 25.00' TO TST-CASE-NAME
           MOVE 25.00 TO TST-EXP-NUM
           MOVE FEE-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'WIRE FEE POSTS AS WFWR' TO TST-CASE-NAME
           MOVE 'WFWR' TO TST-EXPECTED
           MOVE FEE-TRAN-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ

           MOVE 'WINT' TO FEE-TYPE
           CALL 'FEECALC' USING FEECALC-PARMS
           MOVE 'OUTGOING INTERNATIONAL WIRE 45.00' TO TST-CASE-NAME
           MOVE 45.00 TO TST-EXP-NUM
           MOVE FEE-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ

           MOVE 'WINC' TO FEE-TYPE
           MOVE 2 TO FEE-ITEM-COUNT
           CALL 'FEECALC' USING FEECALC-PARMS
           MOVE 'TWO INCOMING WIRES 30.00' TO TST-CASE-NAME
           MOVE 30.00 TO TST-EXP-NUM
           MOVE FEE-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ

           MOVE 'PW' TO FEE-CUST-SEGMENT
           MOVE 'WDOM' TO FEE-TYPE
           CALL 'FEECALC' USING FEECALC-PARMS
           MOVE 'PRIVATE WEALTH PAYS NO WIRE FEE' TO TST-CASE-NAME
           MOVE 0 TO TST-EXP-NUM
           MOVE FEE-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ

           MOVE 'CB' TO FEE-CUST-SEGMENT
           CALL 'FEECALC' USING FEECALC-PARMS
           MOVE 'CORPORATE WIRE FEE BILLED BY ANALYSIS RC 04'
             TO TST-CASE-NAME
           MOVE 4 TO TST-EXP-NUM
           MOVE FEE-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       3000-TEST-OTHER.
           PERFORM 8000-RESET
           MOVE 'PSTM' TO FEE-TYPE
           MOVE 'N' TO FEE-ESTMT-FLAG
           CALL 'FEECALC' USING FEECALC-PARMS
           MOVE 'PAPER STATEMENT FEE 2.00' TO TST-CASE-NAME
           MOVE 2.00 TO TST-EXP-NUM
           MOVE FEE-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ

           MOVE 'Y' TO FEE-ESTMT-FLAG
           CALL 'FEECALC' USING FEECALC-PARMS
           MOVE 'E-STATEMENT CUSTOMER NO PAPER FEE' TO TST-CASE-NAME
           MOVE 0 TO TST-EXP-NUM
           MOVE FEE-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8000-RESET
           MOVE 'STOP' TO FEE-TYPE
           CALL 'FEECALC' USING FEECALC-PARMS
           MOVE 'STOP PAYMENT 30.00' TO TST-CASE-NAME
           MOVE 30.00 TO TST-EXP-NUM
           MOVE FEE-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ

           MOVE 'ABCD' TO FEE-TYPE
           CALL 'FEECALC' USING FEECALC-PARMS
           MOVE 'UNKNOWN FEE TYPE RC 12' TO TST-CASE-NAME
           MOVE 12 TO TST-EXP-NUM
           MOVE FEE-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       8000-RESET.
           INITIALIZE FEECALC-PARMS
           MOVE 'DDAP' TO FEE-PRODUCT-CODE
           MOVE 'RT' TO FEE-CUST-SEGMENT
           MOVE 'Y' TO FEE-ESTMT-FLAG.

       9000-NEQ.
           MOVE 'NEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.

       9100-AEQ.
           MOVE 'AEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.
