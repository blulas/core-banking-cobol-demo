      *================================================================*
      * PROGRAM  : UTGLDERI                                            *
      * TYPE     : UNIT TEST DRIVER                                    *
      * PURPOSE  : UNIT TESTS FOR GLDERIVE - GL ACCOUNT DERIVATION     *
      *================================================================*
       IDENTIFICATION DIVISION.
       PROGRAM-ID. UTGLDERI.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY TESTPARM.
       COPY GLDPARM.

       PROCEDURE DIVISION.
       0000-MAIN.
           MOVE 'INIT' TO TST-FUNCTION
           MOVE 'GLDERIVE' TO TST-SUITE-NAME
           CALL 'TESTLIB' USING TEST-PARMS

           PERFORM 1000-TEST-SETTLEMENT
           PERFORM 2000-TEST-FEES-INTEREST
           PERFORM 3000-TEST-PAYABLES
           PERFORM 4000-TEST-SUSPENSE
           PERFORM 5000-TEST-CATEGORY

           MOVE 'SUMM' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS
           STOP RUN.

       1000-TEST-SETTLEMENT.
           PERFORM 8000-RESET
           MOVE 'DCSH' TO GLD-TRAN-CODE
           MOVE 'C'    TO GLD-DR-CR
           MOVE 'DD'   TO GLD-ACCT-CATEGORY
           MOVE 'S'    TO GLD-OWNERSHIP-TYPE
           CALL 'GLDERIVE' USING GL-DERIVE-PARMS
           MOVE 'CASH DEPOSIT DEBITS 1010 CASH' TO TST-CASE-NAME
           MOVE '1010' TO TST-EXPECTED
           MOVE GLD-DEBIT-GL TO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'CASH DEPOSIT CREDITS 2010 CONSUMER DDA'
             TO TST-CASE-NAME
           MOVE '2010' TO TST-EXPECTED
           MOVE GLD-CREDIT-GL TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'WWIR' TO GLD-TRAN-CODE
           MOVE 'D'    TO GLD-DR-CR
           MOVE 'DD'   TO GLD-ACCT-CATEGORY
           MOVE 'C'    TO GLD-OWNERSHIP-TYPE
           MOVE '20010' TO GLD-COST-CENTER
           CALL 'GLDERIVE' USING GL-DERIVE-PARMS
           MOVE 'OUTGOING WIRE CORPORATE DR 2020' TO TST-CASE-NAME
           MOVE '2020' TO TST-EXPECTED
           MOVE GLD-DEBIT-GL TO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'OUTGOING WIRE CR 1160 FEDWIRE SETTLEMENT'
             TO TST-CASE-NAME
           MOVE '1160' TO TST-EXPECTED
           MOVE GLD-CREDIT-GL TO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'SETTLEMENT OFFSET BOOKED TO CENTRAL CC 90000'
             TO TST-CASE-NAME
           MOVE '90000' TO TST-EXPECTED
           MOVE GLD-CREDIT-CC TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'DACH' TO GLD-TRAN-CODE
           MOVE 'C'    TO GLD-DR-CR
           MOVE 'SV'   TO GLD-ACCT-CATEGORY
           CALL 'GLDERIVE' USING GL-DERIVE-PARMS
           MOVE 'ACH CREDIT TO SAVINGS DR 1150' TO TST-CASE-NAME
           MOVE '1150' TO TST-EXPECTED
           MOVE GLD-DEBIT-GL TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'WSWP' TO GLD-TRAN-CODE
           MOVE 'D'    TO GLD-DR-CR
           MOVE 'DD'   TO GLD-ACCT-CATEGORY
           MOVE 'C'    TO GLD-OWNERSHIP-TYPE
           CALL 'GLDERIVE' USING GL-DERIVE-PARMS
           MOVE 'SWEEP OUT CR 1190 INTERNAL CLEARING' TO TST-CASE-NAME
           MOVE '1190' TO TST-EXPECTED
           MOVE GLD-CREDIT-GL TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'DXFR' TO GLD-TRAN-CODE
           MOVE 'C'    TO GLD-DR-CR
           MOVE 'DD'   TO GLD-ACCT-CATEGORY
           MOVE 'S'    TO GLD-OWNERSHIP-TYPE
           CALL 'GLDERIVE' USING GL-DERIVE-PARMS
           MOVE 'BOOK TRANSFER IN TO CONSUMER DDA CR 2010'
             TO TST-CASE-NAME
           MOVE '2010' TO TST-EXPECTED
           MOVE GLD-CREDIT-GL TO TST-ACTUAL
           PERFORM 9100-AEQ.

       2000-TEST-FEES-INTEREST.
           PERFORM 8000-RESET
           MOVE 'WFAN' TO GLD-TRAN-CODE
           MOVE 'D'    TO GLD-DR-CR
           MOVE 'DD'   TO GLD-ACCT-CATEGORY
           MOVE 'C'    TO GLD-OWNERSHIP-TYPE
           MOVE '20060' TO GLD-COST-CENTER
           CALL 'GLDERIVE' USING GL-DERIVE-PARMS
           MOVE 'ANALYSIS FEE CR 4150' TO TST-CASE-NAME
           MOVE '4150' TO TST-EXPECTED
           MOVE GLD-CREDIT-GL TO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'FEE INCOME STAYS WITH ACCOUNT COST CENTER'
             TO TST-CASE-NAME
           MOVE '20060' TO TST-EXPECTED
           MOVE GLD-CREDIT-CC TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'WFOD' TO GLD-TRAN-CODE
           MOVE 'D'    TO GLD-DR-CR
           MOVE 'DD'   TO GLD-ACCT-CATEGORY
           CALL 'GLDERIVE' USING GL-DERIVE-PARMS
           MOVE 'OVERDRAFT FEE CR 4110' TO TST-CASE-NAME
           MOVE '4110' TO TST-EXPECTED
           MOVE GLD-CREDIT-GL TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'DINT' TO GLD-TRAN-CODE
           MOVE 'C'    TO GLD-DR-CR
           MOVE 'SV'   TO GLD-ACCT-CATEGORY
           MOVE 'J'    TO GLD-OWNERSHIP-TYPE
           CALL 'GLDERIVE' USING GL-DERIVE-PARMS
           MOVE 'SAVINGS INTEREST DR 5020' TO TST-CASE-NAME
           MOVE '5020' TO TST-EXPECTED
           MOVE GLD-DEBIT-GL TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'DINT' TO GLD-TRAN-CODE
           MOVE 'C'    TO GLD-DR-CR
           MOVE 'DD'   TO GLD-ACCT-CATEGORY
           MOVE 'C'    TO GLD-OWNERSHIP-TYPE
           CALL 'GLDERIVE' USING GL-DERIVE-PARMS
           MOVE 'COMMERCIAL / POOL INTEREST DR 5050' TO TST-CASE-NAME
           MOVE '5050' TO TST-EXPECTED
           MOVE GLD-DEBIT-GL TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'DCOF' TO GLD-TRAN-CODE
           MOVE 'C'    TO GLD-DR-CR
           MOVE 'DD'   TO GLD-ACCT-CATEGORY
           CALL 'GLDERIVE' USING GL-DERIVE-PARMS
           MOVE 'OVERDRAFT CHARGE-OFF DR 5510 LOSS' TO TST-CASE-NAME
           MOVE '5510' TO TST-EXPECTED
           MOVE GLD-DEBIT-GL TO TST-ACTUAL
           PERFORM 9100-AEQ.

       3000-TEST-PAYABLES.
           PERFORM 8000-RESET
           MOVE 'WESC' TO GLD-TRAN-CODE
           MOVE 'D'    TO GLD-DR-CR
           MOVE 'DD'   TO GLD-ACCT-CATEGORY
           CALL 'GLDERIVE' USING GL-DERIVE-PARMS
           MOVE 'ESCHEAT TO STATE CR 2310 PAYABLE' TO TST-CASE-NAME
           MOVE '2310' TO TST-EXPECTED
           MOVE GLD-CREDIT-GL TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'WBWH' TO GLD-TRAN-CODE
           MOVE 'D'    TO GLD-DR-CR
           MOVE 'SV'   TO GLD-ACCT-CATEGORY
           CALL 'GLDERIVE' USING GL-DERIVE-PARMS
           MOVE 'BACKUP WITHHOLDING CR 2320 PAYABLE' TO TST-CASE-NAME
           MOVE '2320' TO TST-EXPECTED
           MOVE GLD-CREDIT-GL TO TST-ACTUAL
           PERFORM 9100-AEQ.

       4000-TEST-SUSPENSE.
           PERFORM 8000-RESET
           MOVE 'ZZZZ' TO GLD-TRAN-CODE
           MOVE 'D'    TO GLD-DR-CR
           MOVE 'DD'   TO GLD-ACCT-CATEGORY
           CALL 'GLDERIVE' USING GL-DERIVE-PARMS
           MOVE 'UNKNOWN TRAN CODE TO SUSPENSE 2999 RC 04'
             TO TST-CASE-NAME
           MOVE 'N' TO TST-CONDITION
           IF GLD-CREDIT-GL = '2999' AND GLD-TO-SUSPENSE
              AND GLD-RETURN-CODE = 04
               MOVE 'Y' TO TST-CONDITION
           END-IF
           PERFORM 9200-TRUE

           PERFORM 8000-RESET
           MOVE 'ADJD' TO GLD-TRAN-CODE
           MOVE 'D'    TO GLD-DR-CR
           MOVE 'DD'   TO GLD-ACCT-CATEGORY
           MOVE 'C'    TO GLD-OWNERSHIP-TYPE
           MOVE '4020' TO GLD-OVERRIDE-GL
           CALL 'GLDERIVE' USING GL-DERIVE-PARMS
           MOVE 'ADJD WITH OVERRIDE 4020 NOT IN SUSPENSE'
             TO TST-CASE-NAME
           MOVE 'N' TO TST-CONDITION
           IF GLD-CREDIT-GL = '4020' AND NOT GLD-TO-SUSPENSE
               MOVE 'Y' TO TST-CONDITION
           END-IF
           PERFORM 9200-TRUE

           PERFORM 8000-RESET
           MOVE 'ADJC' TO GLD-TRAN-CODE
           MOVE 'C'    TO GLD-DR-CR
           MOVE 'DD'   TO GLD-ACCT-CATEGORY
           MOVE '9999' TO GLD-OVERRIDE-GL
           CALL 'GLDERIVE' USING GL-DERIVE-PARMS
           MOVE 'OVERRIDE NOT ON CHART - SUSPENSE REASON SOVR'
             TO TST-CASE-NAME
           MOVE 'SOVR' TO TST-EXPECTED
           MOVE GLD-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'WLNP' TO GLD-TRAN-CODE
           MOVE 'D'    TO GLD-DR-CR
           MOVE 'LN'   TO GLD-ACCT-CATEGORY
           CALL 'GLDERIVE' USING GL-DERIVE-PARMS
           MOVE 'NON-DEPOSIT CATEGORY CUSTOMER SIDE TO SUSPENSE'
             TO TST-CASE-NAME
           MOVE 'SCAT' TO TST-EXPECTED
           MOVE GLD-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ.

       5000-TEST-CATEGORY.
           PERFORM 8000-RESET
           MOVE 'C'  TO GLD-FUNCTION
           MOVE 'MM' TO GLD-ACCT-CATEGORY
           MOVE 'C'  TO GLD-OWNERSHIP-TYPE
           CALL 'GLDERIVE' USING GL-DERIVE-PARMS
           MOVE 'CATEGORY MAP MONEY MARKET 2120' TO TST-CASE-NAME
           MOVE '2120' TO TST-EXPECTED
           MOVE GLD-CUST-GL TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'C'  TO GLD-FUNCTION
           MOVE 'DD' TO GLD-ACCT-CATEGORY
           MOVE 'C'  TO GLD-OWNERSHIP-TYPE
           CALL 'GLDERIVE' USING GL-DERIVE-PARMS
           MOVE 'CATEGORY MAP CORPORATE DDA 2020' TO TST-CASE-NAME
           MOVE '2020' TO TST-EXPECTED
           MOVE GLD-CUST-GL TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'C'  TO GLD-FUNCTION
           MOVE 'TD' TO GLD-ACCT-CATEGORY
           CALL 'GLDERIVE' USING GL-DERIVE-PARMS
           MOVE 'CATEGORY MAP TIME DEPOSIT 2130' TO TST-CASE-NAME
           MOVE '2130' TO TST-EXPECTED
           MOVE GLD-CUST-GL TO TST-ACTUAL
           PERFORM 9100-AEQ.

       8000-RESET.
           INITIALIZE GL-DERIVE-PARMS
           MOVE 'T'     TO GLD-FUNCTION
           MOVE 'S'     TO GLD-OWNERSHIP-TYPE
           MOVE '10010' TO GLD-COST-CENTER
           MOVE SPACES  TO GLD-OVERRIDE-GL.

       9100-AEQ.
           MOVE 'AEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.

       9200-TRUE.
           MOVE 'TRUE' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.
