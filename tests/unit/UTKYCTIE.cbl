      *================================================================*
      * PROGRAM  : UTKYCTIE                                            *
      * TYPE     : UNIT TEST DRIVER                                    *
      * PURPOSE  : UNIT TESTS FOR KYCTIER - KYC TIER / EDD / REVIEW    *
      *----------------------------------------------------------------*
      * CHANGE LOG                                                     *
      * 2018-05-14 AKW  ORIGINAL                                       *
      * 2021-03-22 JLM  INCOME CEILING BOUNDARY CASES (CHG2077)        *
      *================================================================*
       IDENTIFICATION DIVISION.
       PROGRAM-ID. UTKYCTIE.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY TESTPARM.
       COPY KYCTPARM.

       PROCEDURE DIVISION.
       0000-MAIN.
           MOVE 'INIT' TO TST-FUNCTION
           MOVE 'KYCTIER' TO TST-SUITE-NAME
           CALL 'TESTLIB' USING TEST-PARMS

           PERFORM 1000-TEST-STANDARD
           PERFORM 1100-TEST-PEP
           PERFORM 1200-TEST-MSB
           PERFORM 1300-TEST-SIMPLIFIED-BOUNDARY
           PERFORM 1400-TEST-TRUST-PW
           PERFORM 1500-TEST-GOVERNMENT
           PERFORM 1600-TEST-HIGH-RISK-COUNTRY
           PERFORM 1700-TEST-OFAC
           PERFORM 1800-TEST-LEAP-DAY
           PERFORM 1900-TEST-INVALID

           MOVE 'SUMM' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS
           STOP RUN.

      *    BASELINE: RETAIL INDIVIDUAL, LOW RISK, 88K INCOME, US
       0100-RESET.
           INITIALIZE KYCTIER-PARMS
           MOVE 'I'       TO KYT-CUST-TYPE
           MOVE 'N'       TO KYT-PEP-FLAG KYT-MSB-FLAG
           MOVE 'L'       TO KYT-RISK-RATING
           MOVE 'US'      TO KYT-COUNTRY
           MOVE 'RT'      TO KYT-SEGMENT
           MOVE 88000.00  TO KYT-ANNUAL-INCOME
           MOVE '541511'  TO KYT-INDUSTRY-CODE
           MOVE 'C'       TO KYT-OFAC-STATUS
           MOVE 20260930  TO KYT-AS-OF-DATE.

       1000-TEST-STANDARD.
           PERFORM 0100-RESET
           CALL 'KYCTIER' USING KYCTIER-PARMS
           MOVE 'STANDARD RETAIL CUSTOMER IS TIER 2' TO TST-CASE-NAME
           MOVE '2' TO TST-EXPECTED
           MOVE KYT-RESULT-TIER TO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'TIER 2 REVIEW IN 24 MONTHS' TO TST-CASE-NAME
           MOVE 20280930 TO TST-EXP-NUM
           MOVE KYT-NEXT-REVIEW-DATE TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'TIER 2 NO EDD' TO TST-CASE-NAME
           MOVE 'N' TO TST-EXPECTED
           MOVE KYT-EDD-REQUIRED TO TST-ACTUAL
           PERFORM 9100-AEQ.

       1100-TEST-PEP.
           PERFORM 0100-RESET
           MOVE 'Y' TO KYT-PEP-FLAG
           CALL 'KYCTIER' USING KYCTIER-PARMS
           MOVE 'PEP IS TIER 3' TO TST-CASE-NAME
           MOVE '3' TO TST-EXPECTED
           MOVE KYT-RESULT-TIER TO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'PEP REQUIRES EDD' TO TST-CASE-NAME
           MOVE 'Y' TO TST-EXPECTED
           MOVE KYT-EDD-REQUIRED TO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'PEP REVIEWED ANNUALLY' TO TST-CASE-NAME
           MOVE 20270930 TO TST-EXP-NUM
           MOVE KYT-NEXT-REVIEW-DATE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1200-TEST-MSB.
           PERFORM 0100-RESET
           MOVE 'C'      TO KYT-CUST-TYPE
           MOVE 'CB'     TO KYT-SEGMENT
           MOVE 'Y'      TO KYT-MSB-FLAG
           CALL 'KYCTIER' USING KYCTIER-PARMS
           MOVE 'MSB IS TIER 3 WITH EDD (REASON MSBX)' TO TST-CASE-NAME
           MOVE 'MSBX' TO TST-EXPECTED
           MOVE KYT-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-RESET
           MOVE 'C'      TO KYT-CUST-TYPE
           MOVE 'CB'     TO KYT-SEGMENT
           MOVE '722511' TO KYT-INDUSTRY-CODE
           CALL 'KYCTIER' USING KYCTIER-PARMS
           MOVE 'CASH-INTENSIVE CORPORATE IS TIER 3 NO EDD'
             TO TST-CASE-NAME
           MOVE '3N' TO TST-EXPECTED
           MOVE KYT-RESULT-TIER  TO TST-ACTUAL(1:1)
           MOVE KYT-EDD-REQUIRED TO TST-ACTUAL(2:1)
           PERFORM 9100-AEQ
           PERFORM 0100-RESET
           MOVE '722511' TO KYT-INDUSTRY-CODE
           CALL 'KYCTIER' USING KYCTIER-PARMS
           MOVE 'CASH-INTENSIVE OCCUPATION INDIVIDUAL STAYS TIER 2'
             TO TST-CASE-NAME
           MOVE '2' TO TST-EXPECTED
           MOVE KYT-RESULT-TIER TO TST-ACTUAL
           PERFORM 9100-AEQ.

       1300-TEST-SIMPLIFIED-BOUNDARY.
           PERFORM 0100-RESET
           MOVE 29999.99 TO KYT-ANNUAL-INCOME
           CALL 'KYCTIER' USING KYCTIER-PARMS
           MOVE 'INCOME 29999.99 LOW RISK RETAIL IS TIER 1'
             TO TST-CASE-NAME
           MOVE '1' TO TST-EXPECTED
           MOVE KYT-RESULT-TIER TO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'TIER 1 REVIEW IN 36 MONTHS' TO TST-CASE-NAME
           MOVE 20290930 TO TST-EXP-NUM
           MOVE KYT-NEXT-REVIEW-DATE TO TST-ACT-NUM
           PERFORM 9000-NEQ
           PERFORM 0100-RESET
           MOVE 30000.00 TO KYT-ANNUAL-INCOME
           CALL 'KYCTIER' USING KYCTIER-PARMS
           MOVE 'INCOME EXACTLY 30000.00 IS TIER 2' TO TST-CASE-NAME
           MOVE '2' TO TST-EXPECTED
           MOVE KYT-RESULT-TIER TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-RESET
           MOVE 24000.00 TO KYT-ANNUAL-INCOME
           MOVE 'M'      TO KYT-RISK-RATING
           CALL 'KYCTIER' USING KYCTIER-PARMS
           MOVE 'LOW INCOME BUT MEDIUM RISK IS TIER 2' TO TST-CASE-NAME
           MOVE '2' TO TST-EXPECTED
           MOVE KYT-RESULT-TIER TO TST-ACTUAL
           PERFORM 9100-AEQ.

       1400-TEST-TRUST-PW.
           PERFORM 0100-RESET
           MOVE 'T' TO KYT-CUST-TYPE
           MOVE 'PW' TO KYT-SEGMENT
           CALL 'KYCTIER' USING KYCTIER-PARMS
           MOVE 'TRUST IS TIER 3 REASON TRST' TO TST-CASE-NAME
           MOVE '3TRSTN' TO TST-EXPECTED
           MOVE KYT-RESULT-TIER  TO TST-ACTUAL(1:1)
           MOVE KYT-REASON-CODE  TO TST-ACTUAL(2:4)
           MOVE KYT-EDD-REQUIRED TO TST-ACTUAL(6:1)
           PERFORM 9100-AEQ
           PERFORM 0100-RESET
           MOVE 'PW' TO KYT-SEGMENT
           CALL 'KYCTIER' USING KYCTIER-PARMS
           MOVE 'PRIVATE WEALTH INDIVIDUAL IS TIER 3 12 MONTHS'
             TO TST-CASE-NAME
           MOVE 12 TO TST-EXP-NUM
           MOVE KYT-REVIEW-MONTHS TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1500-TEST-GOVERNMENT.
           PERFORM 0100-RESET
           MOVE 'C'      TO KYT-CUST-TYPE
           MOVE 'IN'     TO KYT-SEGMENT
           MOVE '921190' TO KYT-INDUSTRY-CODE
           CALL 'KYCTIER' USING KYCTIER-PARMS
           MOVE 'GOVERNMENT ENTITY IS TIER 1 (GOVT)' TO TST-CASE-NAME
           MOVE '1GOVT' TO TST-EXPECTED
           MOVE KYT-RESULT-TIER TO TST-ACTUAL(1:1)
           MOVE KYT-REASON-CODE TO TST-ACTUAL(2:4)
           PERFORM 9100-AEQ.

       1600-TEST-HIGH-RISK-COUNTRY.
           PERFORM 0100-RESET
           MOVE 'IR' TO KYT-COUNTRY
           CALL 'KYCTIER' USING KYCTIER-PARMS
           MOVE 'HIGH-RISK COUNTRY IS TIER 3 EDD (CNTY)'
             TO TST-CASE-NAME
           MOVE '3YCNTY' TO TST-EXPECTED
           MOVE KYT-RESULT-TIER  TO TST-ACTUAL(1:1)
           MOVE KYT-EDD-REQUIRED TO TST-ACTUAL(2:1)
           MOVE KYT-REASON-CODE  TO TST-ACTUAL(3:4)
           PERFORM 9100-AEQ
           PERFORM 0100-RESET
           MOVE 'GB' TO KYT-COUNTRY
           CALL 'KYCTIER' USING KYCTIER-PARMS
           MOVE 'NON-US LOW-RISK COUNTRY INDIVIDUAL IS TIER 3 NO EDD'
             TO TST-CASE-NAME
           MOVE '3NFRGN' TO TST-EXPECTED
           MOVE KYT-RESULT-TIER  TO TST-ACTUAL(1:1)
           MOVE KYT-EDD-REQUIRED TO TST-ACTUAL(2:1)
           MOVE KYT-REASON-CODE  TO TST-ACTUAL(3:4)
           PERFORM 9100-AEQ.

       1700-TEST-OFAC.
           PERFORM 0100-RESET
           MOVE 'H' TO KYT-OFAC-STATUS
           CALL 'KYCTIER' USING KYCTIER-PARMS
           MOVE 'OFAC POTENTIAL HIT FORCES EDD RC 00' TO TST-CASE-NAME
           MOVE 'Y00' TO TST-EXPECTED
           MOVE KYT-EDD-REQUIRED TO TST-ACTUAL(1:1)
           MOVE KYT-RETURN-CODE  TO TST-ACTUAL(2:2)
           PERFORM 9100-AEQ
           PERFORM 0100-RESET
           MOVE 'R' TO KYT-OFAC-STATUS
           CALL 'KYCTIER' USING KYCTIER-PARMS
           MOVE 'CONFIRMED OFAC MATCH RETURNS RC 08' TO TST-CASE-NAME
           MOVE 8 TO TST-EXP-NUM
           MOVE KYT-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1800-TEST-LEAP-DAY.
           PERFORM 0100-RESET
           MOVE 'H' TO KYT-RISK-RATING
           MOVE 20280229 TO KYT-AS-OF-DATE
           CALL 'KYCTIER' USING KYCTIER-PARMS
           MOVE 'HIGH RISK FROM LEAP DAY REVIEW CLAMPS TO FEB 28'
             TO TST-CASE-NAME
           MOVE 20290228 TO TST-EXP-NUM
           MOVE KYT-NEXT-REVIEW-DATE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1900-TEST-INVALID.
           PERFORM 0100-RESET
           MOVE 'X' TO KYT-CUST-TYPE
           CALL 'KYCTIER' USING KYCTIER-PARMS
           MOVE 'INVALID CUSTOMER TYPE RC 12' TO TST-CASE-NAME
           MOVE 12 TO TST-EXP-NUM
           MOVE KYT-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ
           PERFORM 0100-RESET
           MOVE 20261301 TO KYT-AS-OF-DATE
           CALL 'KYCTIER' USING KYCTIER-PARMS
           MOVE 'INVALID AS-OF DATE RC 12' TO TST-CASE-NAME
           MOVE 12 TO TST-EXP-NUM
           MOVE KYT-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       9000-NEQ.
           MOVE 'NEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.

       9100-AEQ.
           MOVE 'AEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS
           MOVE SPACES TO TST-EXPECTED TST-ACTUAL.
