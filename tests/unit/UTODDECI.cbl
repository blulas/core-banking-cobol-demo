      *================================================================*
      * PROGRAM  : UTODDECI                                            *
      * TYPE     : UNIT TEST DRIVER                                    *
      * PURPOSE  : UNIT TESTS FOR ODDECIDE - OVERDRAFT PAY / RETURN    *
      *----------------------------------------------------------------*
      * CHANGE LOG                                                     *
      * 2017-04-03 AKW  ORIGINAL - DE MINIMIS CASES (CHG1894)          *
      * 2019-03-25 AKW  POOLED ACCOUNT CASE                            *
      *================================================================*
       IDENTIFICATION DIVISION.
       PROGRAM-ID. UTODDECI.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY TESTPARM.
       COPY ODDPARM.

       PROCEDURE DIVISION.
       0000-MAIN.
           MOVE 'INIT' TO TST-FUNCTION
           MOVE 'ODDECIDE' TO TST-SUITE-NAME
           CALL 'TESTLIB' USING TEST-PARMS

           PERFORM 1000-SUFFICIENT-FUNDS
           PERFORM 1100-POS-NOT-OPTED-IN
           PERFORM 1200-POS-OPTED-IN-PAID
           PERFORM 1300-ACH-OVER-LIMIT
           PERFORM 1400-CHECK-NOT-OPTED-IN-PAID
           PERFORM 1500-NEW-ACCOUNT
           PERFORM 1600-DAYS-OVERDRAWN
           PERFORM 1700-NSF-COUNT
           PERFORM 1800-PROTECTION-TRANSFER
           PERFORM 1850-PROTECTION-PW
           PERFORM 1900-FEE-CAP
           PERFORM 2000-DE-MINIMIS-ITEM
           PERFORM 2100-DE-MINIMIS-OD
           PERFORM 2200-PRIVATE-WEALTH
           PERFORM 2300-EMPLOYEE
           PERFORM 2400-FORCE-POST-FEE
           PERFORM 2500-POOLED
           PERFORM 2600-AT-LIMIT
           PERFORM 2700-WIRE

           MOVE 'SUMM' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS
           STOP RUN.

      *----------------------------------------------------------------*
      * BASELINE: RETAIL CHECKING, OPTED IN, OD LIMIT 300, AGED ACCT   *
      *----------------------------------------------------------------*
       0100-BASELINE.
           INITIALIZE ODDECIDE-PARMS
           MOVE 'WCHK'   TO ODD-TRAN-CODE
           MOVE 'BAT'    TO ODD-CHANNEL
           MOVE 100.00   TO ODD-AMOUNT
           MOVE 45.12    TO ODD-AVAIL-BAL
           MOVE 300.00   TO ODD-OD-LIMIT
           MOVE 'Y'      TO ODD-OD-OPT-IN
           MOVE 'Y'      TO ODD-PROD-OD-ALLOWED
           MOVE 'N'      TO ODD-POOL-FLAG
           MOVE 3        TO ODD-NSF-COUNT-12M
           MOVE 0        TO ODD-DAYS-OVERDRAWN
           MOVE 20230118 TO ODD-ACCT-OPEN-DATE
           MOVE 20260930 TO ODD-BUSINESS-DATE
           MOVE 'N'      TO ODD-PROTECT-FLAG
           MOVE 'RT'     TO ODD-CUST-SEGMENT
           MOVE 'N'      TO ODD-EMPLOYEE-FLAG
           MOVE 0        TO ODD-FEES-TODAY.

       1000-SUFFICIENT-FUNDS.
           PERFORM 0100-BASELINE
           MOVE 40.00 TO ODD-AMOUNT
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE 'SUFFICIENT FUNDS - PAY, NO FEE' TO TST-CASE-NAME
           MOVE 'P' TO TST-EXPECTED
           MOVE ODD-DECISION TO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'SUFFICIENT FUNDS - RC 00' TO TST-CASE-NAME
           MOVE 0 TO TST-EXP-NUM
           MOVE ODD-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1100-POS-NOT-OPTED-IN.
           PERFORM 0100-BASELINE
           MOVE 'WPOS' TO ODD-TRAN-CODE
           MOVE 'POS'  TO ODD-CHANNEL
           MOVE 'N'    TO ODD-OD-OPT-IN
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE 'REG E - POS NOT OPTED IN IS RETURNED' TO TST-CASE-NAME
           MOVE 'R' TO TST-EXPECTED
           MOVE ODD-DECISION TO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'REG E - DECLINE REASON REGE' TO TST-CASE-NAME
           MOVE 'REGE' TO TST-EXPECTED
           MOVE ODD-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'REG E - DECLINE CARRIES NO FEE' TO TST-CASE-NAME
           MOVE 0 TO TST-EXP-NUM
           MOVE ODD-FEE-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1200-POS-OPTED-IN-PAID.
           PERFORM 0100-BASELINE
           MOVE 'WPOS' TO ODD-TRAN-CODE
           MOVE 'POS'  TO ODD-CHANNEL
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE 'POS OPTED IN - PAID INTO OD' TO TST-CASE-NAME
           MOVE 'PY' TO TST-EXPECTED
           STRING ODD-DECISION ODD-PAID-INTO-OD DELIMITED BY SIZE
             INTO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'POS OPTED IN - OD FEE 34.00 WFOD' TO TST-CASE-NAME
           MOVE 34.00 TO TST-EXP-NUM
           MOVE ODD-FEE-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'POS OPTED IN - FEE COUNT INCREMENTED' TO TST-CASE-NAME
           MOVE 1 TO TST-EXP-NUM
           MOVE ODD-FEES-TODAY TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'POS OPTED IN - RESULT AVAIL -88.88' TO TST-CASE-NAME
           MOVE -88.88 TO TST-EXP-NUM
           MOVE ODD-RESULT-AVAIL TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1300-ACH-OVER-LIMIT.
           PERFORM 0100-BASELINE
           MOVE 'WACH' TO ODD-TRAN-CODE
           MOVE 'ACH'  TO ODD-CHANNEL
           MOVE 450.00 TO ODD-AMOUNT
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE 'ACH EXCEEDING OD LIMIT RETURNED - OLIM'
             TO TST-CASE-NAME
           MOVE 'ROLIMWFNS' TO TST-EXPECTED
           STRING ODD-DECISION ODD-REASON-CODE ODD-FEE-CODE
                  DELIMITED BY SIZE INTO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'RETURNED ITEM NSF FEE 34.00' TO TST-CASE-NAME
           MOVE 34.00 TO TST-EXP-NUM
           MOVE ODD-FEE-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'RETURNED ITEM RC 08' TO TST-CASE-NAME
           MOVE 8 TO TST-EXP-NUM
           MOVE ODD-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1400-CHECK-NOT-OPTED-IN-PAID.
           PERFORM 0100-BASELINE
           MOVE 'N' TO ODD-OD-OPT-IN
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE 'CHECK PAID INTO OD WITHOUT OPT-IN (NOT REG E)'
             TO TST-CASE-NAME
           MOVE 'PODPD' TO TST-EXPECTED
           STRING ODD-DECISION ODD-REASON-CODE DELIMITED BY SIZE
             INTO TST-ACTUAL
           PERFORM 9100-AEQ.

       1500-NEW-ACCOUNT.
           PERFORM 0100-BASELINE
           MOVE 20260915 TO ODD-ACCT-OPEN-DATE
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE 'ACCOUNT OPEN 15 DAYS - RETURNED NEWA' TO TST-CASE-NAME
           MOVE 'RNEWA' TO TST-EXPECTED
           STRING ODD-DECISION ODD-REASON-CODE DELIMITED BY SIZE
             INTO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 20260831 TO ODD-ACCT-OPEN-DATE
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE 'ACCOUNT OPEN EXACTLY 30 DAYS - PAID' TO TST-CASE-NAME
           MOVE 'P' TO TST-EXPECTED
           MOVE ODD-DECISION TO TST-ACTUAL
           PERFORM 9100-AEQ.

       1600-DAYS-OVERDRAWN.
           PERFORM 0100-BASELINE
           MOVE 31 TO ODD-DAYS-OVERDRAWN
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE 'OVERDRAWN 31 DAYS - RETURNED ODAG' TO TST-CASE-NAME
           MOVE 'RODAG' TO TST-EXPECTED
           STRING ODD-DECISION ODD-REASON-CODE DELIMITED BY SIZE
             INTO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 30 TO ODD-DAYS-OVERDRAWN
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE 'OVERDRAWN 30 DAYS - STILL PAID' TO TST-CASE-NAME
           MOVE 'P' TO TST-EXPECTED
           MOVE ODD-DECISION TO TST-ACTUAL
           PERFORM 9100-AEQ.

       1700-NSF-COUNT.
           PERFORM 0100-BASELINE
           MOVE 6 TO ODD-NSF-COUNT-12M
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE '6 NSF IN 12 MONTHS - RETURNED NSFX' TO TST-CASE-NAME
           MOVE 'RNSFX' TO TST-EXPECTED
           STRING ODD-DECISION ODD-REASON-CODE DELIMITED BY SIZE
             INTO TST-ACTUAL
           PERFORM 9100-AEQ.

       1800-PROTECTION-TRANSFER.
      *    3293.80 AVAILABLE, CHECK 4180.00, LINKED SAVINGS 25400.00
           PERFORM 0100-BASELINE
           MOVE 4180.00  TO ODD-AMOUNT
           MOVE 3293.80  TO ODD-AVAIL-BAL
           MOVE 500.00   TO ODD-OD-LIMIT
           MOVE 'Y'      TO ODD-PROTECT-FLAG
           MOVE 25400.00 TO ODD-PROTECT-AVAIL-BAL
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE 'OD PROTECTION - PAY WITH TRANSFER' TO TST-CASE-NAME
           MOVE 'X' TO TST-EXPECTED
           MOVE ODD-DECISION TO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'OD PROTECTION - 886.20 ROUNDED UP TO 900'
             TO TST-CASE-NAME
           MOVE 900.00 TO TST-EXP-NUM
           MOVE ODD-XFER-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'OD PROTECTION - TRANSFER FEE 10.00' TO TST-CASE-NAME
           MOVE 10.00 TO TST-EXP-NUM
           MOVE ODD-XFER-FEE TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'OD PROTECTION - NO OD FEE' TO TST-CASE-NAME
           MOVE 0 TO TST-EXP-NUM
           MOVE ODD-FEE-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ
      *    PROTECTING ACCOUNT TOO SMALL - TAKES ALL, REST INTO OD
           PERFORM 0100-BASELINE
           MOVE 'Y'      TO ODD-PROTECT-FLAG
           MOVE 12.50    TO ODD-PROTECT-AVAIL-BAL
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE 'PARTIAL PROTECTION - TRANSFER ALL 12.50'
             TO TST-CASE-NAME
           MOVE 12.50 TO TST-EXP-NUM
           MOVE ODD-XFER-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'PARTIAL PROTECTION - X + OD FEE' TO TST-CASE-NAME
           MOVE 'XYWFOD' TO TST-EXPECTED
           STRING ODD-DECISION ODD-PAID-INTO-OD ODD-FEE-CODE
                  DELIMITED BY SIZE INTO TST-ACTUAL
           PERFORM 9100-AEQ.

       1850-PROTECTION-PW.
           PERFORM 0100-BASELINE
           MOVE 'PW'     TO ODD-CUST-SEGMENT
           MOVE 'Y'      TO ODD-PROTECT-FLAG
           MOVE 5000.00  TO ODD-PROTECT-AVAIL-BAL
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE 'PW PROTECTION TRANSFER - NO TRANSFER FEE'
             TO TST-CASE-NAME
           MOVE 0 TO TST-EXP-NUM
           MOVE ODD-XFER-FEE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1900-FEE-CAP.
           PERFORM 0100-BASELINE
           MOVE 3 TO ODD-FEES-TODAY
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE 'OD FEE CAPPED AT 3 PER DAY' TO TST-CASE-NAME
           MOVE 'FCAP' TO TST-EXPECTED
           MOVE ODD-FEE-WAIVE-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'FEE CAP - COUNT STAYS 3' TO TST-CASE-NAME
           MOVE 3 TO TST-EXP-NUM
           MOVE ODD-FEES-TODAY TO TST-ACT-NUM
           PERFORM 9000-NEQ
           PERFORM 0100-BASELINE
           MOVE 2 TO ODD-FEES-TODAY
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE 'THIRD FEE OF THE DAY IS CHARGED' TO TST-CASE-NAME
           MOVE 34.00 TO TST-EXP-NUM
           MOVE ODD-FEE-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       2000-DE-MINIMIS-ITEM.
           PERFORM 0100-BASELINE
           MOVE 0.00 TO ODD-AVAIL-BAL
           MOVE 5.00 TO ODD-AMOUNT
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE 'ITEM OF 5.00 PAID - NO FEE (DMIN)' TO TST-CASE-NAME
           MOVE 'PDMIN' TO TST-EXPECTED
           STRING ODD-DECISION ODD-FEE-WAIVE-CODE DELIMITED BY SIZE
             INTO TST-ACTUAL
           PERFORM 9100-AEQ.

       2100-DE-MINIMIS-OD.
           PERFORM 0100-BASELINE
           MOVE 32.82 TO ODD-AVAIL-BAL
           MOVE 33.00 TO ODD-AMOUNT
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE 'RESULTING OD 0.18 - NO FEE (DMOD)' TO TST-CASE-NAME
           MOVE 'DMOD' TO TST-EXPECTED
           MOVE ODD-FEE-WAIVE-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 32.82 TO ODD-AVAIL-BAL
           MOVE 37.83 TO ODD-AMOUNT
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE 'RESULTING OD 5.01 - FEE CHARGED' TO TST-CASE-NAME
           MOVE 34.00 TO TST-EXP-NUM
           MOVE ODD-FEE-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       2200-PRIVATE-WEALTH.
           PERFORM 0100-BASELINE
           MOVE 'PW' TO ODD-CUST-SEGMENT
           MOVE 'WACH' TO ODD-TRAN-CODE
           MOVE 450.00 TO ODD-AMOUNT
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE 'PW RETURNED ITEM - NSF FEE WAIVED' TO TST-CASE-NAME
           MOVE 'RPWWV' TO TST-EXPECTED
           STRING ODD-DECISION ODD-FEE-WAIVE-CODE DELIMITED BY SIZE
             INTO TST-ACTUAL
           PERFORM 9100-AEQ.

       2300-EMPLOYEE.
           PERFORM 0100-BASELINE
           MOVE 'Y' TO ODD-EMPLOYEE-FLAG
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE 'EMPLOYEE OD FEE 50 PCT = 17.00' TO TST-CASE-NAME
           MOVE 17.00 TO TST-EXP-NUM
           MOVE ODD-FEE-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       2400-FORCE-POST-FEE.
           PERFORM 0100-BASELINE
           MOVE 'WFMN' TO ODD-TRAN-CODE
           MOVE 12.00  TO ODD-AMOUNT
           MOVE 0      TO ODD-AVAIL-BAL
           MOVE 'N'    TO ODD-PROD-OD-ALLOWED
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE 'FEE FORCE POSTED INTO OD - NO FEE ON FEE'
             TO TST-CASE-NAME
           MOVE 'PFRCDY' TO TST-EXPECTED
           STRING ODD-DECISION ODD-REASON-CODE ODD-PAID-INTO-OD
                  DELIMITED BY SIZE INTO TST-ACTUAL
           PERFORM 9100-AEQ.

       2500-POOLED.
           PERFORM 0100-BASELINE
           MOVE 'WACH'      TO ODD-TRAN-CODE
           MOVE 15000.00    TO ODD-AMOUNT
           MOVE -420000.00  TO ODD-AVAIL-BAL
           MOVE 0           TO ODD-OD-LIMIT
           MOVE 'N'         TO ODD-PROD-OD-ALLOWED
           MOVE 'Y'         TO ODD-POOL-FLAG
           MOVE 'CB'        TO ODD-CUST-SEGMENT
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE 'POOLED CORPORATE ACCOUNT PAID VIA POOL'
             TO TST-CASE-NAME
           MOVE 'PPOOL' TO TST-EXPECTED
           STRING ODD-DECISION ODD-REASON-CODE DELIMITED BY SIZE
             INTO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 'WACH'      TO ODD-TRAN-CODE
           MOVE 82410.55    TO ODD-AMOUNT
           MOVE 0           TO ODD-AVAIL-BAL ODD-OD-LIMIT
           MOVE 'N'         TO ODD-PROD-OD-ALLOWED
           MOVE 'Z'         TO ODD-POOL-FLAG
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE 'ZBA SUB-ACCOUNT PAID - FUNDED BY SWEEP'
             TO TST-CASE-NAME
           MOVE 'PZBAF' TO TST-EXPECTED
           STRING ODD-DECISION ODD-REASON-CODE DELIMITED BY SIZE
             INTO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 'N'         TO ODD-PROD-OD-ALLOWED
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE 'PRODUCT WITHOUT OD - RETURNED NOOD' TO TST-CASE-NAME
           MOVE 'RNOOD' TO TST-EXPECTED
           STRING ODD-DECISION ODD-REASON-CODE DELIMITED BY SIZE
             INTO TST-ACTUAL
           PERFORM 9100-AEQ.

       2600-AT-LIMIT.
           PERFORM 0100-BASELINE
           MOVE 345.12 TO ODD-AMOUNT
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE 'OVERDRAFT EXACTLY AT LIMIT 300 - PAID' TO TST-CASE-NAME
           MOVE 'P' TO TST-EXPECTED
           MOVE ODD-DECISION TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 345.13 TO ODD-AMOUNT
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE 'OVERDRAFT 300.01 - RETURNED' TO TST-CASE-NAME
           MOVE 'R' TO TST-EXPECTED
           MOVE ODD-DECISION TO TST-ACTUAL
           PERFORM 9100-AEQ.

       2700-WIRE.
           PERFORM 0100-BASELINE
           MOVE 'WWIR' TO ODD-TRAN-CODE
           MOVE 'WIR'  TO ODD-CHANNEL
           CALL 'ODDECIDE' USING ODDECIDE-PARMS
           MOVE 'OUTGOING WIRE NEVER PAID INTO OD' TO TST-CASE-NAME
           MOVE 'RWIRE' TO TST-EXPECTED
           STRING ODD-DECISION ODD-REASON-CODE DELIMITED BY SIZE
             INTO TST-ACTUAL
           PERFORM 9100-AEQ.

       9000-NEQ.
           MOVE 'NEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.

       9100-AEQ.
           MOVE 'AEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS
           MOVE SPACES TO TST-ACTUAL TST-EXPECTED.
