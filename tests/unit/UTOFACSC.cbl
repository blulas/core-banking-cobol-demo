      *================================================================*
      * PROGRAM  : UTOFACSC                                            *
      * TYPE     : UNIT TEST DRIVER                                    *
      * PURPOSE  : UNIT TESTS FOR OFACSCRN USING A SMALL BUILT-IN      *
      *            FICTIONAL SDN TABLE                                 *
      *================================================================*
       IDENTIFICATION DIVISION.
       PROGRAM-ID. UTOFACSC.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY TESTPARM.
       COPY OFSPARM.
       COPY SDNTBL.

       PROCEDURE DIVISION.
       0000-MAIN.
           MOVE 'INIT' TO TST-FUNCTION
           MOVE 'OFACSCRN' TO TST-SUITE-NAME
           CALL 'TESTLIB' USING TEST-PARMS

           PERFORM 0100-LOAD-TABLE
           PERFORM 1000-TEST-EXACT-AND-NOISE
           PERFORM 1100-TEST-INDIVIDUAL-RULES
           PERFORM 1200-TEST-COUNTRY
           PERFORM 1300-TEST-ERRORS

           MOVE 'SUMM' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS
           STOP RUN.

       0100-LOAD-TABLE.
           INITIALIZE SDN-TABLE
           MOVE 500 TO SDNT-MAX-ENTRIES
           MOVE 4 TO SDNT-COUNT
           MOVE 900101 TO SDNT-ENT-NUM(1)
           MOVE 'E' TO SDNT-TYPE(1)
           MOVE 'ZORVAK TRADING LLC' TO SDNT-NAME(1)
           MOVE 'AE' TO SDNT-COUNTRY(1)
           MOVE 'SDGT' TO SDNT-PROGRAM(1)
           MOVE 900102 TO SDNT-ENT-NUM(2)
           MOVE 'I' TO SDNT-TYPE(2)
           MOVE 'IVANOV, PYOTR ALEKSANDROVICH' TO SDNT-NAME(2)
           MOVE 'RU' TO SDNT-COUNTRY(2)
           MOVE 'RUSSIA-EO' TO SDNT-PROGRAM(2)
           MOVE 900103 TO SDNT-ENT-NUM(3)
           MOVE 'I' TO SDNT-TYPE(3)
           MOVE 'KASHRANI, TAVIK' TO SDNT-NAME(3)
           MOVE 'XK' TO SDNT-COUNTRY(3)
           MOVE 'SDNTK' TO SDNT-PROGRAM(3)
           MOVE 900104 TO SDNT-ENT-NUM(4)
           MOVE 'E' TO SDNT-TYPE(4)
           MOVE 'GOLDEN CRESCENT MARITIME HOLDINGS' TO SDNT-NAME(4)
           MOVE 'IR' TO SDNT-COUNTRY(4)
           MOVE 'IRAN' TO SDNT-PROGRAM(4)
           MOVE 'N' TO SDNT-PREPARED-FLAG.

       1000-TEST-EXACT-AND-NOISE.
           PERFORM 8000-RESET
           MOVE 'ZORVAK TRADING LLC' TO OFS-FULL-NAME
           PERFORM 8100-CALL
           MOVE 'EXACT ENTITY NAME SCORES 100' TO TST-CASE-NAME
           MOVE 100 TO TST-EXP-NUM
           MOVE OFS-SCORE TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'TABLE IS PREPARED AFTER FIRST CALL' TO TST-CASE-NAME
           MOVE 'Y' TO TST-EXPECTED
           MOVE SDNT-PREPARED-FLAG TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'The Zorvak Trading Co., Ltd.' TO OFS-FULL-NAME
           PERFORM 8100-CALL
           MOVE 'NOISE WORDS + PUNCTUATION REMOVED - HIT'
             TO TST-CASE-NAME
           MOVE 'H' TO TST-EXPECTED
           MOVE OFS-RESULT TO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'NORMALISED NAME IS ZORVAK TRADING' TO TST-CASE-NAME
           MOVE 'ZORVAK TRADING' TO TST-EXPECTED
           MOVE OFS-NORM-NAME TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'MARITIME GOLDEN CRESCENT HOLDINGS' TO OFS-FULL-NAME
           PERFORM 8100-CALL
           MOVE 'SAME TOKENS ANY ORDER SCORES 95 (TSET)'
             TO TST-CASE-NAME
           MOVE 'TSET' TO TST-EXPECTED
           MOVE OFS-MATCH-RULE TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'GOLDEN CRESCENT SHIPPING' TO OFS-FULL-NAME
           MOVE 'E' TO OFS-PARTY-TYPE
           PERFORM 8100-CALL
           MOVE 'PARTIAL TOKEN OVERLAP DICE 57 IS CLEAR'
             TO TST-CASE-NAME
           MOVE 57 TO TST-EXP-NUM
           MOVE OFS-SCORE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1100-TEST-INDIVIDUAL-RULES.
           PERFORM 8000-RESET
           MOVE 'PIOTR A IVANOV' TO OFS-FULL-NAME
           MOVE 'IVANOV' TO OFS-LAST-NAME
           MOVE 'PIOTR'  TO OFS-FIRST-NAME
           MOVE 'I' TO OFS-PARTY-TYPE
           MOVE 'US' TO OFS-COUNTRY
           PERFORM 8100-CALL
           MOVE 'PIOTR IVANOV VS PYOTR - SOUNDEX 85 POTENTIAL'
             TO TST-CASE-NAME
           MOVE 85 TO TST-EXP-NUM
           MOVE OFS-SCORE TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'PIOTR IVANOV RESULT P RC 04' TO TST-CASE-NAME
           MOVE 4 TO TST-EXP-NUM
           MOVE OFS-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8000-RESET
           MOVE 'PYOTR IVANOV' TO OFS-FULL-NAME
           PERFORM 8100-CALL
           MOVE 'SURNAME + GIVEN EXACT SCORES 90 HIT' TO TST-CASE-NAME
           MOVE 'SNFN' TO TST-EXPECTED
           MOVE OFS-MATCH-RULE TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'PAVEL IVANOV' TO OFS-FULL-NAME
           PERFORM 8100-CALL
           MOVE 'SURNAME + FIRST INITIAL SCORES 80' TO TST-CASE-NAME
           MOVE 80 TO TST-EXP-NUM
           MOVE OFS-SCORE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8000-RESET
           MOVE 'KASHRANY, TOMAS' TO OFS-FULL-NAME
           PERFORM 8100-CALL
           MOVE 'SURNAME SOUNDEX + INITIAL SCORES 75 (SXFI)'
             TO TST-CASE-NAME
           MOVE 'SXFI' TO TST-EXPECTED
           MOVE OFS-MATCH-RULE TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'ALEX J MORGAN' TO OFS-FULL-NAME
           PERFORM 8100-CALL
           MOVE 'UNRELATED NAME IS CLEAR RC 00' TO TST-CASE-NAME
           MOVE 'C' TO TST-EXPECTED
           MOVE OFS-RESULT TO TST-ACTUAL
           PERFORM 9100-AEQ.

       1200-TEST-COUNTRY.
           PERFORM 8000-RESET
           MOVE 'PIOTR IVANOV' TO OFS-FULL-NAME
           MOVE 'RU' TO OFS-COUNTRY
           PERFORM 8100-CALL
           MOVE 'COUNTRY MATCH BOOSTS 85 TO 95 HIT' TO TST-CASE-NAME
           MOVE 95 TO TST-EXP-NUM
           MOVE OFS-SCORE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8000-RESET
           MOVE 'HAVANA CIGAR IMPORTS' TO OFS-FULL-NAME
           MOVE 'CU' TO OFS-COUNTRY
           PERFORM 8100-CALL
           MOVE 'EMBARGOED COUNTRY CU BLOCKS REGARDLESS OF NAME'
             TO TST-CASE-NAME
           MOVE 'EMBG' TO TST-EXPECTED
           MOVE OFS-MATCH-RULE TO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'EMBARGO RESULT IS HIT RC 08' TO TST-CASE-NAME
           MOVE 8 TO TST-EXP-NUM
           MOVE OFS-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1300-TEST-ERRORS.
           PERFORM 8000-RESET
           PERFORM 8100-CALL
           MOVE 'BLANK NAME RC 12' TO TST-CASE-NAME
           MOVE 12 TO TST-EXP-NUM
           MOVE OFS-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8000-RESET
           MOVE 'PYOTR IVANOV' TO OFS-FULL-NAME
           MOVE ZERO TO SDNT-COUNT
           PERFORM 8100-CALL
           MOVE 'EMPTY SDN TABLE RC 12' TO TST-CASE-NAME
           MOVE 12 TO TST-EXP-NUM
           MOVE OFS-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 4 TO SDNT-COUNT.

       8000-RESET.
           INITIALIZE OFAC-SCREEN-PARMS.

       8100-CALL.
           CALL 'OFACSCRN' USING OFAC-SCREEN-PARMS SDN-TABLE.

       9000-NEQ.
           MOVE 'NEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.

       9100-AEQ.
           MOVE 'AEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.
