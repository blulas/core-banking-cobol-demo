      *================================================================*
      * PROGRAM  : UTPAYLIM                                            *
      * TYPE     : UNIT TEST DRIVER                                    *
      * PURPOSE  : UNIT TESTS FOR PAYLIMIT                             *
      *================================================================*
       IDENTIFICATION DIVISION.
       PROGRAM-ID. UTPAYLIM.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY TESTPARM.
       COPY PLMPARM.

       PROCEDURE DIVISION.
       0000-MAIN.
           MOVE 'INIT' TO TST-FUNCTION
           MOVE 'PAYLIMIT' TO TST-SUITE-NAME
           CALL 'TESTLIB' USING TEST-PARMS

           PERFORM 1000-TEST-RETAIL
           PERFORM 1100-TEST-SEGMENTS
           PERFORM 1200-TEST-CORPORATE
           PERFORM 1300-TEST-SPECIAL

           MOVE 'SUMM' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS
           STOP RUN.

       1000-TEST-RETAIL.
           PERFORM 8000-RESET
           MOVE 'A' TO PLM-PAY-TYPE
           MOVE 2450.00 TO PLM-AMOUNT
           CALL 'PAYLIMIT' USING PAY-LIMIT-PARMS
           MOVE 'RT ACH RENT 2,450 APPROVED' TO TST-CASE-NAME
           MOVE 'A' TO TST-EXPECTED
           MOVE PLM-DECISION TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'A' TO PLM-PAY-TYPE
           MOVE 9000.00 TO PLM-AMOUNT
           MOVE 18000.00 TO PLM-ACH-USED-TODAY
           CALL 'PAYLIMIT' USING PAY-LIMIT-PARMS
           MOVE 'RT ACH OVER 25,000 DAILY AGGREGATE DECLINED'
             TO TST-CASE-NAME
           MOVE 'LDAY' TO TST-EXPECTED
           MOVE PLM-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'S' TO PLM-PAY-TYPE
           MOVE 12000.00 TO PLM-AMOUNT
           CALL 'PAYLIMIT' USING PAY-LIMIT-PARMS
           MOVE 'RT SDACH OVER 10,000 PER TXN DECLINED'
             TO TST-CASE-NAME
           MOVE 'LTXN' TO TST-EXPECTED
           MOVE PLM-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'W' TO PLM-PAY-TYPE
           MOVE 50000.00 TO PLM-AMOUNT
           CALL 'PAYLIMIT' USING PAY-LIMIT-PARMS
           MOVE 'RT WIRE EXACTLY 50,000 NEEDS DUAL APPROVAL'
             TO TST-CASE-NAME
           MOVE 'DUAL' TO TST-EXPECTED
           MOVE PLM-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'NEEDS APPROVAL RC 04' TO TST-CASE-NAME
           MOVE 4 TO TST-EXP-NUM
           MOVE PLM-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8000-RESET
           MOVE 'W' TO PLM-PAY-TYPE
           MOVE 49999.99 TO PLM-AMOUNT
           CALL 'PAYLIMIT' USING PAY-LIMIT-PARMS
           MOVE 'RT WIRE 49,999.99 APPROVED SINGLE' TO TST-CASE-NAME
           MOVE 'A' TO TST-EXPECTED
           MOVE PLM-DECISION TO TST-ACTUAL
           PERFORM 9100-AEQ.

       1100-TEST-SEGMENTS.
           PERFORM 8000-RESET
           MOVE 'MA' TO PLM-SEGMENT
           MOVE 'W' TO PLM-PAY-TYPE
           MOVE 150000.00 TO PLM-AMOUNT
           CALL 'PAYLIMIT' USING PAY-LIMIT-PARMS
           MOVE 'MA WIRE DAILY LIMIT IS 200,000 (X2)' TO TST-CASE-NAME
           MOVE 200000.00 TO TST-EXP-NUM
           MOVE PLM-DAILY-LIMIT TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8000-RESET
           MOVE 'PW' TO PLM-SEGMENT
           MOVE 'A' TO PLM-PAY-TYPE
           MOVE 240000.00 TO PLM-AMOUNT
           CALL 'PAYLIMIT' USING PAY-LIMIT-PARMS
           MOVE 'PW ACH 240,000 OVER 100,000 PER TXN (X10)'
             TO TST-CASE-NAME
           MOVE 'LTXN' TO TST-EXPECTED
           MOVE PLM-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'PW' TO PLM-SEGMENT
           MOVE 'I' TO PLM-PAY-TYPE
           MOVE 150000.00 TO PLM-AMOUNT
           MOVE 'GB' TO PLM-BENE-COUNTRY
           CALL 'PAYLIMIT' USING PAY-LIMIT-PARMS
           MOVE 'PW INTL WIRE 150,000 TO GB NEEDS DUAL'
             TO TST-CASE-NAME
           MOVE 'DUAL' TO TST-EXPECTED
           MOVE PLM-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ.

       1200-TEST-CORPORATE.
           PERFORM 8000-RESET
           MOVE 'CB' TO PLM-SEGMENT
           MOVE 'W' TO PLM-PAY-TYPE
           MOVE 999999.99 TO PLM-AMOUNT
           CALL 'PAYLIMIT' USING PAY-LIMIT-PARMS
           MOVE 'CB WIRE UNDER 1MM NO DUAL APPROVAL' TO TST-CASE-NAME
           MOVE 'A' TO TST-EXPECTED
           MOVE PLM-DECISION TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'CB' TO PLM-SEGMENT
           MOVE 'W' TO PLM-PAY-TYPE
           MOVE 1000000.00 TO PLM-AMOUNT
           CALL 'PAYLIMIT' USING PAY-LIMIT-PARMS
           MOVE 'CB WIRE AT 1MM NEEDS DUAL APPROVAL' TO TST-CASE-NAME
           MOVE 'Y' TO TST-EXPECTED
           MOVE PLM-DUAL-APPROVAL-FLAG TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'CB' TO PLM-SEGMENT
           MOVE 'A' TO PLM-PAY-TYPE
           MOVE 1000000.00 TO PLM-ACCT-ACH-LIMIT
           MOVE 600000.00 TO PLM-ACH-USED-TODAY
           MOVE 500000.00 TO PLM-AMOUNT
           CALL 'PAYLIMIT' USING PAY-LIMIT-PARMS
           MOVE 'CB OVER ACCOUNT ACH LIMIT IS OVERRIDE NOT DECLINE'
             TO TST-CASE-NAME
           MOVE 'LOVR' TO TST-EXPECTED
           MOVE PLM-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ.

       1300-TEST-SPECIAL.
           PERFORM 8000-RESET
           MOVE 20260915 TO PLM-ACCT-OPEN-DATE
           MOVE 'A' TO PLM-PAY-TYPE
           MOVE 3000.00 TO PLM-AMOUNT
           CALL 'PAYLIMIT' USING PAY-LIMIT-PARMS
           MOVE 'NEW ACCOUNT ACH 3,000 DECLINED (2,500/DAY)'
             TO TST-CASE-NAME
           MOVE 'LNEW' TO TST-EXPECTED
           MOVE PLM-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 20260901 TO PLM-ACCT-OPEN-DATE
           MOVE 'A' TO PLM-PAY-TYPE
           MOVE 3000.00 TO PLM-AMOUNT
           CALL 'PAYLIMIT' USING PAY-LIMIT-PARMS
           MOVE 'ACCOUNT 29 DAYS OLD IS STILL NEW' TO TST-CASE-NAME
           MOVE 'Y' TO TST-EXPECTED
           MOVE PLM-NEW-ACCT-FLAG TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'CB' TO PLM-SEGMENT
           MOVE 'I' TO PLM-PAY-TYPE
           MOVE 275000.00 TO PLM-AMOUNT
           MOVE 'PH' TO PLM-BENE-COUNTRY
           CALL 'PAYLIMIT' USING PAY-LIMIT-PARMS
           MOVE 'INTL WIRE TO HIGH-RISK PH NEEDS COMPLIANCE'
             TO TST-CASE-NAME
           MOVE 'Y' TO TST-EXPECTED
           MOVE PLM-COMPLIANCE-FLAG TO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'HIGH-RISK REASON HRCY' TO TST-CASE-NAME
           MOVE 'HRCY' TO TST-EXPECTED
           MOVE PLM-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'B' TO PLM-PAY-TYPE
           MOVE ZERO TO PLM-AMOUNT
           CALL 'PAYLIMIT' USING PAY-LIMIT-PARMS
           MOVE 'ZERO AMOUNT DECLINED RC 08' TO TST-CASE-NAME
           MOVE 8 TO TST-EXP-NUM
           MOVE PLM-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       8000-RESET.
           INITIALIZE PAY-LIMIT-PARMS
           MOVE 'RT' TO PLM-SEGMENT
           MOVE 20220310 TO PLM-ACCT-OPEN-DATE
           MOVE 20260930 TO PLM-BUSINESS-DATE
           MOVE 'US' TO PLM-BENE-COUNTRY.

       9000-NEQ.
           MOVE 'NEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.

       9100-AEQ.
           MOVE 'AEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.
