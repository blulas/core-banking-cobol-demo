      *================================================================*
      * PROGRAM  : UTPAYROU                                            *
      * TYPE     : UNIT TEST DRIVER                                    *
      * PURPOSE  : UNIT TESTS FOR PAYROUTE                             *
      *================================================================*
       IDENTIFICATION DIVISION.
       PROGRAM-ID. UTPAYROU.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY TESTPARM.
       COPY PRTPARM.

       PROCEDURE DIVISION.
       0000-MAIN.
           MOVE 'INIT' TO TST-FUNCTION
           MOVE 'PAYROUTE' TO TST-SUITE-NAME
           CALL 'TESTLIB' USING TEST-PARMS

           PERFORM 1000-TEST-FASTEST
           PERFORM 1100-TEST-CHEAPEST

           MOVE 'SUMM' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS
           STOP RUN.

       1000-TEST-FASTEST.
           PERFORM 8000-RESET
           MOVE '026000013' TO PRT-BENE-ROUTING
           CALL 'PAYROUTE' USING PAY-ROUTE-PARMS
           MOVE 'OUR OWN ABA ROUTES TO BOOK' TO TST-CASE-NAME
           MOVE 'B' TO TST-EXPECTED
           MOVE PRT-RAIL TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'GB' TO PRT-BENE-COUNTRY
           CALL 'PAYROUTE' USING PAY-ROUTE-PARMS
           MOVE 'NON-US BENEFICIARY ROUTES TO INTL WIRE'
             TO TST-CASE-NAME
           MOVE 'I' TO TST-EXPECTED
           MOVE PRT-RAIL TO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'INTL WIRE FEE 45.00' TO TST-CASE-NAME
           MOVE 45.00 TO TST-EXP-NUM
           MOVE PRT-FEE-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8000-RESET
           MOVE 1000000.00 TO PRT-AMOUNT
           MOVE 'Y' TO PRT-URGENT-FLAG
           CALL 'PAYROUTE' USING PAY-ROUTE-PARMS
           MOVE 'URGENT 1,000,000 ROUTES TO WIRE' TO TST-CASE-NAME
           MOVE 'W' TO TST-EXPECTED
           MOVE PRT-RAIL TO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'DOMESTIC WIRE FEE QUOTED 30.00' TO TST-CASE-NAME
           MOVE 30.00 TO TST-EXP-NUM
           MOVE PRT-FEE-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8000-RESET
           MOVE 'Y' TO PRT-URGENT-FLAG
           MOVE 1430 TO PRT-REQUEST-TIME
           CALL 'PAYROUTE' USING PAY-ROUTE-PARMS
           MOVE 'URGENT AT 14:30 ROUTES TO SDACH' TO TST-CASE-NAME
           MOVE 'S' TO TST-EXPECTED
           MOVE PRT-RAIL TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'Y' TO PRT-URGENT-FLAG
           MOVE 1431 TO PRT-REQUEST-TIME
           CALL 'PAYROUTE' USING PAY-ROUTE-PARMS
           MOVE 'URGENT AFTER SDACH CUTOFF ROUTES TO WIRE'
             TO TST-CASE-NAME
           MOVE 'SDLT' TO TST-EXPECTED
           MOVE PRT-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           CALL 'PAYROUTE' USING PAY-ROUTE-PARMS
           MOVE 'NOT URGENT ROUTES TO STANDARD ACH' TO TST-CASE-NAME
           MOVE 'A' TO TST-EXPECTED
           MOVE PRT-RAIL TO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'STANDARD ACH SETTLES IN 1 DAY' TO TST-CASE-NAME
           MOVE 1 TO TST-EXP-NUM
           MOVE PRT-EST-SETTLE-DAYS TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1100-TEST-CHEAPEST.
           PERFORM 8000-RESET
           MOVE 'C' TO PRT-PREFERENCE
           MOVE 2500000.00 TO PRT-AMOUNT
           CALL 'PAYROUTE' USING PAY-ROUTE-PARMS
           MOVE 'CHEAPEST LARGE NON-URGENT USES ACH' TO TST-CASE-NAME
           MOVE 'A' TO TST-EXPECTED
           MOVE PRT-RAIL TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'C' TO PRT-PREFERENCE
           MOVE 'Y' TO PRT-URGENT-FLAG
           CALL 'PAYROUTE' USING PAY-ROUTE-PARMS
           MOVE 'CHEAPEST URGENT BEFORE CUTOFF USES SDACH FEE 5'
             TO TST-CASE-NAME
           MOVE 5.00 TO TST-EXP-NUM
           MOVE PRT-FEE-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8000-RESET
           MOVE 'X' TO PRT-PREFERENCE
           CALL 'PAYROUTE' USING PAY-ROUTE-PARMS
           MOVE 'INVALID PREFERENCE RC 12' TO TST-CASE-NAME
           MOVE 12 TO TST-EXP-NUM
           MOVE PRT-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       8000-RESET.
           INITIALIZE PAY-ROUTE-PARMS
           MOVE 'F' TO PRT-PREFERENCE
           MOVE 5000.00 TO PRT-AMOUNT
           MOVE '021900011' TO PRT-BENE-ROUTING
           MOVE 'US' TO PRT-BENE-COUNTRY
           MOVE 'N' TO PRT-INTERNAL-FLAG PRT-URGENT-FLAG
           MOVE 1000 TO PRT-REQUEST-TIME
           MOVE 1430 TO PRT-SDACH-CUTOFF.

       9000-NEQ.
           MOVE 'NEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.

       9100-AEQ.
           MOVE 'AEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.
