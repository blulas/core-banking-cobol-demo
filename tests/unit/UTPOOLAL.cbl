      *================================================================*
      * PROGRAM  : UTPOOLAL                                            *
      * TYPE     : UNIT TEST DRIVER                                    *
      * PURPOSE  : UNIT TESTS FOR POOLALOC - NOTIONAL POOL INTEREST    *
      *            POSITION, RATES, ALLOCATION AND LIMIT CHECK         *
      *================================================================*
       IDENTIFICATION DIVISION.
       PROGRAM-ID. UTPOOLAL.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY TESTPARM.
       COPY POOLPARM.
       01  WS-SUM                          PIC S9(11)V99 COMP-3.

       PROCEDURE DIVISION.
       0000-MAIN.
           MOVE 'INIT' TO TST-FUNCTION
           MOVE 'POOLALOC' TO TST-SUITE-NAME
           CALL 'TESTLIB' USING TEST-PARMS

           PERFORM 1000-TEST-NET-CREDIT-POOL
           PERFORM 2000-TEST-HEADER-METHOD
           PERFORM 3000-TEST-NET-DEBIT-POOL
           PERFORM 4000-TEST-EDGE-CASES

           MOVE 'SUMM' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS
           STOP RUN.

      *    NORTHWIND: HEADER 6.2MM, RETAIL 1.35MM, MFG -420K
       1000-TEST-NET-CREDIT-POOL.
           PERFORM 8000-NORTHWIND
           CALL 'POOLALOC' USING POOL-ALLOC-PARMS
           MOVE 'NET POOL POSITION 7,130,000' TO TST-CASE-NAME
           MOVE 7130000 TO TST-EXP-NUM
           MOVE PLA-NET-POSITION TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'CREDIT RATE = FED FUNDS 4.33 - 1.00' TO TST-CASE-NAME
           MOVE 3.33 TO TST-EXP-NUM
           MOVE PLA-CREDIT-RATE TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'DEBIT RATE = PRIME 7.50 + 2.00' TO TST-CASE-NAME
           MOVE 9.50 TO TST-EXP-NUM
           MOVE PLA-DEBIT-RATE TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'POOL CREDIT INTEREST NET x 3.33% x 30/360'
             TO TST-CASE-NAME
           MOVE 19785.75 TO TST-EXP-NUM
           MOVE PLA-TOTAL-CREDIT-INT TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'HEADER SHARE PRO RATA 6.2/7.55' TO TST-CASE-NAME
           MOVE 16247.90 TO TST-EXP-NUM
           MOVE PLA-MBR-CREDIT-INT(1) TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'RETAIL SHARE PRO RATA 1.35/7.55' TO TST-CASE-NAME
           MOVE 3537.85 TO TST-EXP-NUM
           MOVE PLA-MBR-CREDIT-INT(2) TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'OFFSET DEBIT MEMBER PAYS NO DEBIT INTEREST'
             TO TST-CASE-NAME
           MOVE ZERO TO TST-EXP-NUM
           MOVE PLA-MBR-DEBIT-INT(3) TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'GROSS DEBIT 420K OVER 400K LIMIT - BREACH RC 04'
             TO TST-CASE-NAME
           MOVE 'N' TO TST-CONDITION
           IF PLA-LIMIT-BREACHED AND PLA-RETURN-CODE = 04
               MOVE 'Y' TO TST-CONDITION
           END-IF
           PERFORM 9200-TRUE.

       2000-TEST-HEADER-METHOD.
           PERFORM 8000-NORTHWIND
           MOVE 'H' TO PLA-ALLOC-METHOD
           MOVE 500000 TO PLA-POOL-LIMIT
           CALL 'POOLALOC' USING POOL-ALLOC-PARMS
           MOVE 'METHOD H - ALL CREDIT INTEREST TO HEADER'
             TO TST-CASE-NAME
           MOVE 19785.75 TO TST-EXP-NUM
           MOVE PLA-MBR-CREDIT-INT(1) TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'METHOD H - MEMBER RECEIVES NOTHING' TO TST-CASE-NAME
           MOVE ZERO TO TST-EXP-NUM
           MOVE PLA-MBR-CREDIT-INT(2) TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'WITHIN 500K LIMIT - NO BREACH' TO TST-CASE-NAME
           MOVE 'N' TO TST-EXPECTED
           MOVE PLA-LIMIT-BREACH-FLAG TO TST-ACTUAL
           PERFORM 9100-AEQ.

       3000-TEST-NET-DEBIT-POOL.
      *    +100K, -300K, -100K = NET -300K
           PERFORM 8100-RESET
           MOVE 3 TO PLA-MEMBER-COUNT
           MOVE 'Y'     TO PLA-MBR-HEADER-FLAG(1)
           MOVE 100000  TO PLA-MBR-AVG-BAL(1)
           MOVE -300000 TO PLA-MBR-AVG-BAL(2)
           MOVE -100000 TO PLA-MBR-AVG-BAL(3)
           CALL 'POOLALOC' USING POOL-ALLOC-PARMS
           MOVE 'NET DEBIT POOL - INTEREST 300K x 9.50% x 30/360'
             TO TST-CASE-NAME
           MOVE 2375.00 TO TST-EXP-NUM
           MOVE PLA-TOTAL-DEBIT-INT TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'NET DEBIT - LARGER DEBTOR PAYS 3/4' TO TST-CASE-NAME
           MOVE 1781.25 TO TST-EXP-NUM
           MOVE PLA-MBR-DEBIT-INT(2) TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'NET DEBIT - SMALLER DEBTOR PAYS 1/4' TO TST-CASE-NAME
           MOVE 593.75 TO TST-EXP-NUM
           MOVE PLA-MBR-DEBIT-INT(3) TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'NET DEBIT - NO CREDIT INTEREST TO POSITIVE MEMBER'
             TO TST-CASE-NAME
           MOVE ZERO TO TST-EXP-NUM
           MOVE PLA-MBR-CREDIT-INT(1) TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       4000-TEST-EDGE-CASES.
      *    CREDIT RATE FLOORED AT ZERO
           PERFORM 8000-NORTHWIND
           MOVE 0.50 TO PLA-REF-CREDIT-RATE
           CALL 'POOLALOC' USING POOL-ALLOC-PARMS
           MOVE 'FED FUNDS BELOW SPREAD - CREDIT RATE FLOOR 0'
             TO TST-CASE-NAME
           MOVE ZERO TO TST-EXP-NUM
           MOVE PLA-TOTAL-CREDIT-INT TO TST-ACT-NUM
           PERFORM 9000-NEQ

      *    ROUNDING - 3 EQUAL MEMBERS, REMAINDER TO FIRST LARGEST
           PERFORM 8100-RESET
           MOVE 3 TO PLA-MEMBER-COUNT
           MOVE 'Y' TO PLA-MBR-HEADER-FLAG(1)
           MOVE 1000000 TO PLA-MBR-AVG-BAL(1) PLA-MBR-AVG-BAL(2)
                           PLA-MBR-AVG-BAL(3)
           CALL 'POOLALOC' USING POOL-ALLOC-PARMS
           COMPUTE WS-SUM = PLA-MBR-CREDIT-INT(1)
                          + PLA-MBR-CREDIT-INT(2)
                          + PLA-MBR-CREDIT-INT(3)
           MOVE 'ALLOCATIONS SUM EXACTLY TO POOL INTEREST'
             TO TST-CASE-NAME
           MOVE PLA-TOTAL-CREDIT-INT TO TST-EXP-NUM
           MOVE WS-SUM TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8100-RESET
           MOVE 'X' TO PLA-ALLOC-METHOD
           MOVE 1 TO PLA-MEMBER-COUNT
           CALL 'POOLALOC' USING POOL-ALLOC-PARMS
           MOVE 'INVALID ALLOCATION METHOD RC 12' TO TST-CASE-NAME
           MOVE 12 TO TST-EXP-NUM
           MOVE PLA-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8100-RESET
           MOVE 'H' TO PLA-ALLOC-METHOD
           MOVE 1 TO PLA-MEMBER-COUNT
           MOVE 'N' TO PLA-MBR-HEADER-FLAG(1)
           CALL 'POOLALOC' USING POOL-ALLOC-PARMS
           MOVE 'METHOD H WITHOUT HEADER RC 12' TO TST-CASE-NAME
           MOVE 12 TO TST-EXP-NUM
           MOVE PLA-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       8000-NORTHWIND.
           PERFORM 8100-RESET
           MOVE 3 TO PLA-MEMBER-COUNT
           MOVE '200000000005' TO PLA-MBR-ACCT(1)
           MOVE 'Y'            TO PLA-MBR-HEADER-FLAG(1)
           MOVE 6200000        TO PLA-MBR-AVG-BAL(1)
           MOVE '200000000006' TO PLA-MBR-ACCT(2)
           MOVE 1350000        TO PLA-MBR-AVG-BAL(2)
           MOVE '200000000007' TO PLA-MBR-ACCT(3)
           MOVE -420000        TO PLA-MBR-AVG-BAL(3).

       8100-RESET.
           INITIALIZE POOL-ALLOC-PARMS
           MOVE 'P'    TO PLA-ALLOC-METHOD
           MOVE 4.33   TO PLA-REF-CREDIT-RATE
           MOVE 7.50   TO PLA-REF-DEBIT-RATE
           MOVE 1.00   TO PLA-CREDIT-SPREAD
           MOVE 2.00   TO PLA-DEBIT-SPREAD
           MOVE 400000 TO PLA-POOL-LIMIT
           MOVE 30     TO PLA-DAYS.

       9000-NEQ.
           MOVE 'NEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.

       9100-AEQ.
           MOVE 'AEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.

       9200-TRUE.
           MOVE 'TRUE' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.
