      *================================================================*
      * PROGRAM  : UTRATETI                                            *
      * TYPE     : UNIT TEST DRIVER                                    *
      * PURPOSE  : UNIT TESTS FOR RATETIER (RATE TIER / BONUS / APY)   *
      *================================================================*
       IDENTIFICATION DIVISION.
       PROGRAM-ID. UTRATETI.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY TESTPARM.
       COPY RTTPARM.
       COPY BANKCTL.
       01  WS-EXP-RATE                     PIC S9(03)V9(06).

       PROCEDURE DIVISION.
       0000-MAIN.
           MOVE 'INIT' TO TST-FUNCTION
           MOVE 'RATETIER' TO TST-SUITE-NAME
           CALL 'TESTLIB' USING TEST-PARMS

           PERFORM 1000-TEST-HYSV
           PERFORM 2000-TEST-PROMO
           PERFORM 3000-TEST-MMKT-TIERS
           PERFORM 4000-TEST-BONUSES
           PERFORM 5000-TEST-CDS
           PERFORM 6000-TEST-OTHER

           MOVE 'SUMM' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS
           STOP RUN.

       1000-TEST-HYSV.
           PERFORM 8000-RESET
           MOVE 'HYSV' TO RTT-PRODUCT-CODE
           MOVE 25400.00 TO RTT-BALANCE
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'HYSV 25,400 RETAIL EARNS 4.10' TO TST-CASE-NAME
           MOVE 4.100000 TO TST-EXP-NUM
           MOVE RTT-RESULT-RATE TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'HYSV DAILY COMPOUNDED APY 4.184971' TO TST-CASE-NAME
           MOVE 4.184971 TO TST-EXP-NUM
           MOVE RTT-RESULT-APY TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'HYSV 25,400 USES TIER T002' TO TST-CASE-NAME
           MOVE 'T002' TO TST-EXPECTED
           MOVE RTT-TIER-ID TO TST-ACTUAL
           PERFORM 9100-AEQ

           PERFORM 8000-RESET
           MOVE 'HYSV' TO RTT-PRODUCT-CODE
           MOVE 9999.99 TO RTT-BALANCE
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'HYSV 9,999.99 USES TIER T001' TO TST-CASE-NAME
           MOVE 'T001' TO TST-EXPECTED
           MOVE RTT-TIER-ID TO TST-ACTUAL
           PERFORM 9100-AEQ.

       2000-TEST-PROMO.
           PERFORM 8000-RESET
           MOVE 'HYSV' TO RTT-PRODUCT-CODE
           MOVE 1000.00 TO RTT-BALANCE
           MOVE 5.000000 TO RTT-PROMO-RATE
           MOVE 20261215 TO RTT-PROMO-EXP-DATE
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'ACTIVE PROMO 5.00 WINS OVER TABLE' TO TST-CASE-NAME
           MOVE 5.000000 TO TST-EXP-NUM
           MOVE RTT-RESULT-RATE TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'PROMO TIER ID IS PRMO' TO TST-CASE-NAME
           MOVE 'PRMO' TO TST-EXPECTED
           MOVE RTT-TIER-ID TO TST-ACTUAL
           PERFORM 9100-AEQ

           MOVE 20261215 TO RTT-AS-OF-DATE
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'PROMO VALID ON EXPIRY DATE ITSELF' TO TST-CASE-NAME
           MOVE 5.000000 TO TST-EXP-NUM
           MOVE RTT-RESULT-RATE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           MOVE 20261216 TO RTT-AS-OF-DATE
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'EXPIRED PROMO FALLS BACK TO 4.10' TO TST-CASE-NAME
           MOVE 4.100000 TO TST-EXP-NUM
           MOVE RTT-RESULT-RATE TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'EXPIRED PROMO RETURNS RC 04' TO TST-CASE-NAME
           MOVE 4 TO TST-EXP-NUM
           MOVE RTT-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8000-RESET
           MOVE 'HYSV' TO RTT-PRODUCT-CODE
           MOVE 1000.00 TO RTT-BALANCE
           MOVE 'Y' TO RTT-EMPLOYEE-FLAG
           MOVE 5.000000 TO RTT-PROMO-RATE
           MOVE 20261215 TO RTT-PROMO-EXP-DATE
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'NO EMPLOYEE BONUS ON TOP OF PROMO' TO TST-CASE-NAME
           MOVE 5.000000 TO TST-EXP-NUM
           MOVE RTT-RESULT-RATE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           MOVE 5.500000 TO RTT-PROMO-RATE
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'PROMO 5.50 CAPPED AT 5.25' TO TST-CASE-NAME
           MOVE 5.250000 TO TST-EXP-NUM
           MOVE RTT-RESULT-RATE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       3000-TEST-MMKT-TIERS.
           PERFORM 8000-RESET
           MOVE 'MMKT' TO RTT-PRODUCT-CODE
           MOVE 2400.00 TO RTT-BALANCE
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'MMKT 2,400 BELOW 2,500 EARNS 0.10' TO TST-CASE-NAME
           MOVE 0.100000 TO TST-EXP-NUM
           MOVE RTT-RESULT-RATE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           MOVE 2500.00 TO RTT-BALANCE
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'MMKT EXACTLY 2,500 EARNS 2.50' TO TST-CASE-NAME
           MOVE 2.500000 TO TST-EXP-NUM
           MOVE RTT-RESULT-RATE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           MOVE 99999.99 TO RTT-BALANCE
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'MMKT 99,999.99 EARNS 3.25' TO TST-CASE-NAME
           MOVE 3.250000 TO TST-EXP-NUM
           MOVE RTT-RESULT-RATE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           MOVE 1000000.00 TO RTT-BALANCE
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'MMKT 1,000,000 JUMBO EARNS 3.85' TO TST-CASE-NAME
           MOVE 3.850000 TO TST-EXP-NUM
           MOVE RTT-RESULT-RATE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8000-RESET
           MOVE 'DDPR' TO RTT-PRODUCT-CODE
           MOVE 24999.99 TO RTT-BALANCE
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'DDPR 24,999.99 EARNS 0.05' TO TST-CASE-NAME
           MOVE 0.050000 TO TST-EXP-NUM
           MOVE RTT-RESULT-RATE TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 25000.00 TO RTT-BALANCE
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'DDPR 25,000 EARNS 0.25' TO TST-CASE-NAME
           MOVE 0.250000 TO TST-EXP-NUM
           MOVE RTT-RESULT-RATE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       4000-TEST-BONUSES.
           PERFORM 8000-RESET
           MOVE 'MMKT' TO RTT-PRODUCT-CODE
           MOVE 1250000.00 TO RTT-BALANCE
           MOVE 4745000.00 TO RTT-REL-BALANCE
           MOVE 'PW' TO RTT-CUST-SEGMENT
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'MMKT PW RELATIONSHIP BONUS +0.15 = 4.00'
             TO TST-CASE-NAME
           MOVE 4.000000 TO TST-EXP-NUM
           MOVE RTT-RESULT-RATE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           MOVE 410000.00 TO RTT-BALANCE
           MOVE 250000.00 TO RTT-REL-BALANCE
           MOVE 'RT' TO RTT-CUST-SEGMENT
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'MMKT REL BAL EXACTLY 250,000 +0.10 = 3.70'
             TO TST-CASE-NAME
           MOVE 3.700000 TO TST-EXP-NUM
           MOVE RTT-RESULT-RATE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           MOVE 249999.99 TO RTT-REL-BALANCE
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'MMKT REL BAL 249,999.99 NO BONUS' TO TST-CASE-NAME
           MOVE 3.600000 TO TST-EXP-NUM
           MOVE RTT-RESULT-RATE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8000-RESET
           MOVE 'HYSV' TO RTT-PRODUCT-CODE
           MOVE 8000.00 TO RTT-BALANCE
           MOVE 'Y' TO RTT-EMPLOYEE-FLAG
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'HYSV EMPLOYEE BONUS +0.25 = 4.35' TO TST-CASE-NAME
           MOVE 4.350000 TO TST-EXP-NUM
           MOVE RTT-RESULT-RATE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           MOVE 300000.00 TO RTT-REL-BALANCE
           MOVE 'PW' TO RTT-CUST-SEGMENT
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'HYSV EMPLOYEE + PW BONUS STACK = 4.50'
             TO TST-CASE-NAME
           MOVE 4.500000 TO TST-EXP-NUM
           MOVE RTT-RESULT-RATE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8000-RESET
           MOVE 'MMKT' TO RTT-PRODUCT-CODE
           MOVE 410000.00 TO RTT-BALANCE
           MOVE 'Y' TO RTT-EMPLOYEE-FLAG
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'EMPLOYEE BONUS NOT PAID ON MMKT' TO TST-CASE-NAME
           MOVE 3.600000 TO TST-EXP-NUM
           MOVE RTT-RESULT-RATE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       5000-TEST-CDS.
           PERFORM 8000-RESET
           MOVE 'CD12' TO RTT-PRODUCT-CODE
           MOVE 50000.00 TO RTT-BALANCE
           MOVE 12 TO RTT-TERM-MONTHS
           MOVE 1000000.00 TO RTT-REL-BALANCE
           MOVE 'PW' TO RTT-CUST-SEGMENT
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'CD12 4.65 - NO RELATIONSHIP BONUS ON CDS'
             TO TST-CASE-NAME
           MOVE 4.650000 TO TST-EXP-NUM
           MOVE RTT-RESULT-RATE TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'CD12 APY 4.759498' TO TST-CASE-NAME
           MOVE 4.759498 TO TST-EXP-NUM
           MOVE RTT-RESULT-APY TO TST-ACT-NUM
           PERFORM 9000-NEQ

           MOVE 24 TO RTT-TERM-MONTHS
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'CD 24 MONTHS USES NEAREST SHORTER (12M) 4.65'
             TO TST-CASE-NAME
           MOVE 4.650000 TO TST-EXP-NUM
           MOVE RTT-RESULT-RATE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           MOVE 3 TO RTT-TERM-MONTHS
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'CD 3 MONTHS BELOW TABLE USES 6M 4.40'
             TO TST-CASE-NAME
           MOVE 4.400000 TO TST-EXP-NUM
           MOVE RTT-RESULT-RATE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           MOVE 'CD36' TO RTT-PRODUCT-CODE
           MOVE 36 TO RTT-TERM-MONTHS
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'CD36 EARNS 4.25' TO TST-CASE-NAME
           MOVE 4.250000 TO TST-EXP-NUM
           MOVE RTT-RESULT-RATE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           MOVE 'CDNP' TO RTT-PRODUCT-CODE
           MOVE 11 TO RTT-TERM-MONTHS
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'CDNP EARNS 4.00' TO TST-CASE-NAME
           MOVE 4.000000 TO TST-EXP-NUM
           MOVE RTT-RESULT-RATE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       6000-TEST-OTHER.
           PERFORM 8000-RESET
           MOVE 'DDAP' TO RTT-PRODUCT-CODE
           MOVE 3250.00 TO RTT-BALANCE
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'DDAP NOT INTEREST BEARING RC 08' TO TST-CASE-NAME
           MOVE 8 TO TST-EXP-NUM
           MOVE RTT-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           MOVE 'ZZZZ' TO RTT-PRODUCT-CODE
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'UNKNOWN PRODUCT RC 12' TO TST-CASE-NAME
           MOVE 12 TO TST-EXP-NUM
           MOVE RTT-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8000-RESET
           MOVE 'SVST' TO RTT-PRODUCT-CODE
           MOVE 3412.18 TO RTT-BALANCE
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'SVST MONTHLY COMPOUNDED APY 0.050011'
             TO TST-CASE-NAME
           MOVE 0.050011 TO TST-EXP-NUM
           MOVE RTT-RESULT-APY TO TST-ACT-NUM
           PERFORM 9000-NEQ

      *    CMM1 IS PRICED OFF THE CONTROL RECORD FED FUNDS RATE
           CALL 'GETCTL' USING BANK-CONTROL-RECORD
           COMPUTE WS-EXP-RATE = CTL-FED-FUNDS-RATE - 0.28
           IF WS-EXP-RATE < 0.50
               MOVE 0.50 TO WS-EXP-RATE
           END-IF
           PERFORM 8000-RESET
           MOVE 'CMMI' TO RTT-PRODUCT-CODE
           MOVE 40000000.00 TO RTT-BALANCE
           CALL 'RATETIER' USING RATETIER-PARMS
           MOVE 'CMMI = FED FUNDS - 0.28, FLOOR 0.50' TO TST-CASE-NAME
           MOVE WS-EXP-RATE TO TST-EXP-NUM
           MOVE RTT-RESULT-RATE TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'CMMI TIER ID IS IDX' TO TST-CASE-NAME
           MOVE 'IDX' TO TST-EXPECTED
           MOVE RTT-TIER-ID TO TST-ACTUAL
           PERFORM 9100-AEQ.

       8000-RESET.
           INITIALIZE RATETIER-PARMS
           MOVE 'RT' TO RTT-CUST-SEGMENT
           MOVE 'N'  TO RTT-EMPLOYEE-FLAG
           MOVE 20260930 TO RTT-AS-OF-DATE.

       9000-NEQ.
           MOVE 'NEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.

       9100-AEQ.
           MOVE 'AEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.
