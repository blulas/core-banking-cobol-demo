      *================================================================*
      * PROGRAM  : UTREGCCH                                            *
      * TYPE     : UNIT TEST DRIVER                                    *
      * PURPOSE  : UNIT TESTS FOR REGCCHLD - REG CC FUNDS AVAILABILITY *
      *            BUSINESS DATE WED 2026-09-30. +1 = 10-01, +2 =      *
      *            10-02, +7 = 10-09 (COLUMBUS DAY 10-12 NOT REACHED)  *
      *----------------------------------------------------------------*
      * CHANGE LOG                                                     *
      * 2011-07-21 DPS  ORIGINAL                                       *
      * 2025-07-01 AKW  REG-2025-CC AMOUNTS                            *
      *================================================================*
       IDENTIFICATION DIVISION.
       PROGRAM-ID. UTREGCCH.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY TESTPARM.
       COPY RCCPARM.

       PROCEDURE DIVISION.
       0000-MAIN.
           MOVE 'INIT' TO TST-FUNCTION
           MOVE 'REGCCHLD' TO TST-SUITE-NAME
           CALL 'TESTLIB' USING TEST-PARMS

           PERFORM 1000-NON-CHECK-NO-HOLD
           PERFORM 1100-SMALL-CHECK
           PERFORM 1200-STANDARD-CHECK
           PERFORM 1300-LARGE-DEPOSIT
           PERFORM 1400-NEW-ACCOUNT
           PERFORM 1500-REPEATED-OD
           PERFORM 1600-PRIVATE-WEALTH
           PERFORM 1700-SECOND-DEPOSIT-SAME-DAY
           PERFORM 1800-HOLIDAY-ROLL

           MOVE 'SUMM' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS
           STOP RUN.

       0100-BASELINE.
           INITIALIZE REGCCHLD-PARMS
           MOVE 'DCHK'   TO RCC-TRAN-CODE
           MOVE 'BRN'    TO RCC-CHANNEL
           MOVE 1000.00  TO RCC-AMOUNT
           MOVE 0        TO RCC-DEPOSITS-TODAY
           MOVE 20260930 TO RCC-BUSINESS-DATE
           MOVE 20180611 TO RCC-ACCT-OPEN-DATE
           MOVE 0        TO RCC-NSF-COUNT-12M
           MOVE 'MA'     TO RCC-CUST-SEGMENT.

       1000-NON-CHECK-NO-HOLD.
           PERFORM 0100-BASELINE
           MOVE 'DCSH' TO RCC-TRAN-CODE
           CALL 'REGCCHLD' USING REGCCHLD-PARMS
           MOVE 'CASH DEPOSIT - NO HOLD' TO TST-CASE-NAME
           MOVE 0 TO TST-EXP-NUM
           MOVE RCC-HOLD-COUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ
           PERFORM 0100-BASELINE
           MOVE 'DACH' TO RCC-TRAN-CODE
           CALL 'REGCCHLD' USING REGCCHLD-PARMS
           MOVE 'ACH CREDIT - NO HOLD, RC 00' TO TST-CASE-NAME
           MOVE 0 TO TST-EXP-NUM
           MOVE RCC-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ
           PERFORM 0100-BASELINE
           MOVE 'DXFR' TO RCC-TRAN-CODE
           CALL 'REGCCHLD' USING REGCCHLD-PARMS
           MOVE 'INTERNAL TRANSFER - NO HOLD' TO TST-CASE-NAME
           MOVE 0 TO TST-EXP-NUM
           MOVE RCC-TOTAL-HOLD-AMT TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1100-SMALL-CHECK.
           PERFORM 0100-BASELINE
           MOVE 200.00 TO RCC-AMOUNT
           CALL 'REGCCHLD' USING REGCCHLD-PARMS
           MOVE 'CHECK 200 - ONE NEXT-DAY TIER' TO TST-CASE-NAME
           MOVE 1 TO TST-EXP-NUM
           MOVE RCC-HOLD-COUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'CHECK 200 - RELEASE 2026-10-01' TO TST-CASE-NAME
           MOVE 20261001 TO TST-EXP-NUM
           MOVE RCC-RELEASE-DATE(1) TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1200-STANDARD-CHECK.
           PERFORM 0100-BASELINE
           CALL 'REGCCHLD' USING REGCCHLD-PARMS
           MOVE 'CHECK 1000 - FIRST 275 NEXT DAY' TO TST-CASE-NAME
           MOVE 275.00 TO TST-EXP-NUM
           MOVE RCC-HOLD-AMT(1) TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'CHECK 1000 - 725 ON 2ND BUSINESS DAY' TO TST-CASE-NAME
           MOVE 725.00 TO TST-EXP-NUM
           MOVE RCC-HOLD-AMT(2) TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'CHECK 1000 - 2ND TIER RELEASE 2026-10-02'
             TO TST-CASE-NAME
           MOVE 20261002 TO TST-EXP-NUM
           MOVE RCC-RELEASE-DATE(2) TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'CHECK 1000 - RC 04 HOLDS PLACED' TO TST-CASE-NAME
           MOVE 4 TO TST-EXP-NUM
           MOVE RCC-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1300-LARGE-DEPOSIT.
           PERFORM 0100-BASELINE
           MOVE 9500.00 TO RCC-AMOUNT
           CALL 'REGCCHLD' USING REGCCHLD-PARMS
           MOVE 'LARGE 9500 - 2ND DAY TIER 6450' TO TST-CASE-NAME
           MOVE 6450.00 TO TST-EXP-NUM
           MOVE RCC-HOLD-AMT(2) TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'LARGE 9500 - EXCESS OVER 6725 = 2775 CX'
             TO TST-CASE-NAME
           MOVE 2775.00 TO TST-EXP-NUM
           MOVE RCC-HOLD-AMT(3) TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'LARGE 9500 - EXCESS RELEASE 7TH BUS DAY 10-09'
             TO TST-CASE-NAME
           MOVE 20261009 TO TST-EXP-NUM
           MOVE RCC-RELEASE-DATE(3) TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'LARGE 9500 - EXCEPTION CODE LRGD' TO TST-CASE-NAME
           MOVE 'LRGDCX' TO TST-EXPECTED
           STRING RCC-EXCEPTION-CODE RCC-HOLD-TYPE(3)
                  DELIMITED BY SIZE INTO TST-ACTUAL
           PERFORM 9100-AEQ.

       1400-NEW-ACCOUNT.
           PERFORM 0100-BASELINE
           MOVE 12000.00 TO RCC-AMOUNT
           MOVE 20260915 TO RCC-ACCT-OPEN-DATE
           CALL 'REGCCHLD' USING REGCCHLD-PARMS
           MOVE 'NEW ACCOUNT - 2 TIERS, NEWA' TO TST-CASE-NAME
           MOVE '2NEWA' TO TST-EXPECTED
           STRING RCC-HOLD-COUNT RCC-EXCEPTION-CODE
                  DELIMITED BY SIZE INTO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'NEW ACCOUNT - 11725 HELD TO 7TH BUS DAY'
             TO TST-CASE-NAME
           MOVE 11725.00 TO TST-EXP-NUM
           MOVE RCC-HOLD-AMT(2) TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'NEW ACCOUNT - MAX HOLD DAYS 7' TO TST-CASE-NAME
           MOVE 7 TO TST-EXP-NUM
           MOVE RCC-MAX-HOLD-DAYS TO TST-ACT-NUM
           PERFORM 9000-NEQ
           PERFORM 0100-BASELINE
           MOVE 20260831 TO RCC-ACCT-OPEN-DATE
           CALL 'REGCCHLD' USING REGCCHLD-PARMS
           MOVE 'ACCOUNT 30 DAYS OLD - NOT NEW, STANDARD'
             TO TST-CASE-NAME
           MOVE SPACES TO TST-EXPECTED
           MOVE RCC-EXCEPTION-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ.

       1500-REPEATED-OD.
           PERFORM 0100-BASELINE
           MOVE 6 TO RCC-NSF-COUNT-12M
           CALL 'REGCCHLD' USING REGCCHLD-PARMS
           MOVE 'REPEATED OD (6 NSF) - RPOD 725 TO 10-09'
             TO TST-CASE-NAME
           MOVE 'RPOD20261009' TO TST-EXPECTED
           STRING RCC-EXCEPTION-CODE RCC-RELEASE-DATE(2)
                  DELIMITED BY SIZE INTO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 5 TO RCC-NSF-COUNT-12M
           CALL 'REGCCHLD' USING REGCCHLD-PARMS
           MOVE '5 NSF - NO EXCEPTION' TO TST-CASE-NAME
           MOVE 20261002 TO TST-EXP-NUM
           MOVE RCC-RELEASE-DATE(2) TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1600-PRIVATE-WEALTH.
           PERFORM 0100-BASELINE
           MOVE 'PW' TO RCC-CUST-SEGMENT
           MOVE 50000.00 TO RCC-AMOUNT
           CALL 'REGCCHLD' USING REGCCHLD-PARMS
           MOVE 'PRIVATE WEALTH - NO HOLD ON 50000 CHECK'
             TO TST-CASE-NAME
           MOVE 0 TO TST-EXP-NUM
           MOVE RCC-TOTAL-HOLD-AMT TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1700-SECOND-DEPOSIT-SAME-DAY.
      *    7000 ALREADY DEPOSITED TODAY - NEXT-DAY AND STANDARD ROOM
      *    BOTH USED UP, ENTIRE 1000 IS LARGE-DEPOSIT EXCESS
           PERFORM 0100-BASELINE
           MOVE 7000.00 TO RCC-DEPOSITS-TODAY
           CALL 'REGCCHLD' USING REGCCHLD-PARMS
           MOVE 'AGGREGATE OVER 6725 - ALL 1000 IS CX' TO TST-CASE-NAME
           MOVE 'CX' TO TST-EXPECTED
           MOVE RCC-HOLD-TYPE(1) TO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'AGGREGATE - SINGLE TIER OF 1000' TO TST-CASE-NAME
           MOVE 1000.00 TO TST-EXP-NUM
           MOVE RCC-HOLD-AMT(1) TO TST-ACT-NUM
           PERFORM 9000-NEQ
           PERFORM 0100-BASELINE
           MOVE 200.00 TO RCC-DEPOSITS-TODAY
           CALL 'REGCCHLD' USING REGCCHLD-PARMS
           MOVE 'SECOND DEPOSIT - ONLY 75 LEFT OF NEXT-DAY'
             TO TST-CASE-NAME
           MOVE 75.00 TO TST-EXP-NUM
           MOVE RCC-HOLD-AMT(1) TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1800-HOLIDAY-ROLL.
      *    FRI 2026-10-09 + 1 BUSINESS DAY SKIPS COLUMBUS DAY -> 10-13
           PERFORM 0100-BASELINE
           MOVE 20261009 TO RCC-BUSINESS-DATE
           CALL 'REGCCHLD' USING REGCCHLD-PARMS
           MOVE 'NEXT DAY FROM FRI 10-09 IS TUE 10-13' TO TST-CASE-NAME
           MOVE 20261013 TO TST-EXP-NUM
           MOVE RCC-RELEASE-DATE(1) TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       9000-NEQ.
           MOVE 'NEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.

       9100-AEQ.
           MOVE 'AEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS
           MOVE SPACES TO TST-ACTUAL TST-EXPECTED.
