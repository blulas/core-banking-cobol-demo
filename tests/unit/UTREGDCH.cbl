      *================================================================*
      * PROGRAM  : UTREGDCH                                            *
      * TYPE     : UNIT TEST DRIVER                                    *
      * PURPOSE  : UNIT TESTS FOR REGDCHK - CONVENIENT WITHDRAWAL LIMIT*
      *----------------------------------------------------------------*
      * CHANGE LOG                                                     *
      * 2020-05-01 AKW  ORIGINAL - CHG3301                             *
      *================================================================*
       IDENTIFICATION DIVISION.
       PROGRAM-ID. UTREGDCH.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY TESTPARM.
       COPY RGDPARM.

       PROCEDURE DIVISION.
       0000-MAIN.
           MOVE 'INIT' TO TST-FUNCTION
           MOVE 'REGDCHK' TO TST-SUITE-NAME
           CALL 'TESTLIB' USING TEST-PARMS

           PERFORM 1000-WITHIN-LIMIT
           PERFORM 1100-SIXTH-NO-FEE
           PERFORM 1200-SEVENTH-FEE
           PERFORM 1300-EIGHTH-NO-NEW-VIOLATION
           PERFORM 1400-CONVERT-RECOMMEND
           PERFORM 1500-BRANCH-EXCLUDED
           PERFORM 1600-ATM-EXCLUDED
           PERFORM 1700-NON-REGD-CODE
           PERFORM 1800-CHECKING-NOT-APPLICABLE
           PERFORM 1900-CMMI-NOT-APPLICABLE

           MOVE 'SUMM' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS
           STOP RUN.

       0100-BASELINE.
           INITIALIZE REGDCHK-PARMS
           MOVE 'MM'   TO RGD-ACCT-CATEGORY
           MOVE 'Y'    TO RGD-PROD-REGD-FLAG
           MOVE 'WXFR' TO RGD-TRAN-CODE
           MOVE 'Y'    TO RGD-TRAN-REGD-FLAG
           MOVE 'ONL'  TO RGD-CHANNEL
           MOVE 2      TO RGD-WD-COUNT
           MOVE 0      TO RGD-VIOLATIONS-12M.

       1000-WITHIN-LIMIT.
           PERFORM 0100-BASELINE
           CALL 'REGDCHK' USING REGDCHK-PARMS
           MOVE 'THIRD WITHDRAWAL COUNTED - NO FEE' TO TST-CASE-NAME
           MOVE 'CNTDY' TO TST-EXPECTED
           STRING RGD-REASON-CODE RGD-COUNTED-FLAG DELIMITED BY SIZE
             INTO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'COUNT INCREMENTED TO 3' TO TST-CASE-NAME
           MOVE 3 TO TST-EXP-NUM
           MOVE RGD-WD-COUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1100-SIXTH-NO-FEE.
           PERFORM 0100-BASELINE
           MOVE 5 TO RGD-WD-COUNT
           CALL 'REGDCHK' USING REGDCHK-PARMS
           MOVE 'SIXTH WITHDRAWAL - NO FEE' TO TST-CASE-NAME
           MOVE 0 TO TST-EXP-NUM
           MOVE RGD-FEE-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1200-SEVENTH-FEE.
           PERFORM 0100-BASELINE
           MOVE 6 TO RGD-WD-COUNT
           CALL 'REGDCHK' USING REGDCHK-PARMS
           MOVE 'SEVENTH WITHDRAWAL - WFRD FEE 10.00' TO TST-CASE-NAME
           MOVE 10.00 TO TST-EXP-NUM
           MOVE RGD-FEE-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'SEVENTH WITHDRAWAL - VIOLATION RECORDED'
             TO TST-CASE-NAME
           MOVE 1 TO TST-EXP-NUM
           MOVE RGD-VIOLATIONS-12M TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'SEVENTH WITHDRAWAL - RC 04' TO TST-CASE-NAME
           MOVE 4 TO TST-EXP-NUM
           MOVE RGD-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1300-EIGHTH-NO-NEW-VIOLATION.
           PERFORM 0100-BASELINE
           MOVE 7 TO RGD-WD-COUNT
           MOVE 1 TO RGD-VIOLATIONS-12M
           CALL 'REGDCHK' USING REGDCHK-PARMS
           MOVE 'EIGHTH - FEE BUT ONE VIOLATION PER CYCLE'
             TO TST-CASE-NAME
           MOVE 'WFRD1' TO TST-EXPECTED
           STRING RGD-FEE-CODE RGD-VIOLATIONS-12M(2:1)
                  DELIMITED BY SIZE INTO TST-ACTUAL
           PERFORM 9100-AEQ.

       1400-CONVERT-RECOMMEND.
           PERFORM 0100-BASELINE
           MOVE 6 TO RGD-WD-COUNT
           MOVE 2 TO RGD-VIOLATIONS-12M
           CALL 'REGDCHK' USING REGDCHK-PARMS
           MOVE 'THIRD VIOLATION IN 12M - RECOMMEND CONVERT'
             TO TST-CASE-NAME
           MOVE 'Y' TO TST-EXPECTED
           MOVE RGD-CONVERT-FLAG TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 6 TO RGD-WD-COUNT
           MOVE 1 TO RGD-VIOLATIONS-12M
           CALL 'REGDCHK' USING REGDCHK-PARMS
           MOVE 'SECOND VIOLATION - NO CONVERT' TO TST-CASE-NAME
           MOVE 'N' TO TST-EXPECTED
           MOVE RGD-CONVERT-FLAG TO TST-ACTUAL
           PERFORM 9100-AEQ.

       1500-BRANCH-EXCLUDED.
           PERFORM 0100-BASELINE
           MOVE 7 TO RGD-WD-COUNT
           MOVE 'BRN' TO RGD-CHANNEL
           CALL 'REGDCHK' USING REGDCHK-PARMS
           MOVE 'BRANCH TRANSFER EXCLUDED - INPR' TO TST-CASE-NAME
           MOVE 'INPR' TO TST-EXPECTED
           MOVE RGD-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'BRANCH TRANSFER - COUNT UNCHANGED' TO TST-CASE-NAME
           MOVE 7 TO TST-EXP-NUM
           MOVE RGD-WD-COUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1600-ATM-EXCLUDED.
           PERFORM 0100-BASELINE
           MOVE 'ATM' TO RGD-CHANNEL
           MOVE 9 TO RGD-WD-COUNT
           CALL 'REGDCHK' USING REGDCHK-PARMS
           MOVE 'ATM EXCLUDED - NO FEE' TO TST-CASE-NAME
           MOVE 0 TO TST-EXP-NUM
           MOVE RGD-FEE-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       1700-NON-REGD-CODE.
           PERFORM 0100-BASELINE
           MOVE 'WFMN' TO RGD-TRAN-CODE
           MOVE 'N'    TO RGD-TRAN-REGD-FLAG
           MOVE 8      TO RGD-WD-COUNT
           CALL 'REGDCHK' USING REGDCHK-PARMS
           MOVE 'FEE DEBIT NOT A CONVENIENT WD - NCNT' TO TST-CASE-NAME
           MOVE 'NCNT' TO TST-EXPECTED
           MOVE RGD-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ.

       1800-CHECKING-NOT-APPLICABLE.
           PERFORM 0100-BASELINE
           MOVE 'DD' TO RGD-ACCT-CATEGORY
           MOVE 'N'  TO RGD-PROD-REGD-FLAG
           MOVE 12   TO RGD-WD-COUNT
           CALL 'REGDCHK' USING REGDCHK-PARMS
           MOVE 'CHECKING ACCOUNT NOT LIMITED - NAPP' TO TST-CASE-NAME
           MOVE 'NAPPN' TO TST-EXPECTED
           STRING RGD-REASON-CODE RGD-EXCESS-FLAG DELIMITED BY SIZE
             INTO TST-ACTUAL
           PERFORM 9100-AEQ.

       1900-CMMI-NOT-APPLICABLE.
           PERFORM 0100-BASELINE
           MOVE 'N' TO RGD-PROD-REGD-FLAG
           MOVE 10  TO RGD-WD-COUNT
           CALL 'REGDCHK' USING REGDCHK-PARMS
           MOVE 'INSTITUTIONAL MM (REGD FLAG N) - NO FEE'
             TO TST-CASE-NAME
           MOVE 0 TO TST-EXP-NUM
           MOVE RGD-FEE-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       9000-NEQ.
           MOVE 'NEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.

       9100-AEQ.
           MOVE 'AEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS
           MOVE SPACES TO TST-ACTUAL TST-EXPECTED.
