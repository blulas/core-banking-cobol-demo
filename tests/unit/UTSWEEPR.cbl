      *================================================================*
      * PROGRAM  : UTSWEEPR                                            *
      * TYPE     : UNIT TEST DRIVER                                    *
      * PURPOSE  : UNIT TESTS FOR SWEEPRUL - ZBA, TARGET AND RANGE     *
      *            SWEEP AMOUNT / DIRECTION RULES                      *
      *================================================================*
       IDENTIFICATION DIVISION.
       PROGRAM-ID. UTSWEEPR.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY TESTPARM.
       COPY SWRPARM.

       PROCEDURE DIVISION.
       0000-MAIN.
           MOVE 'INIT' TO TST-FUNCTION
           MOVE 'SWEEPRUL' TO TST-SUITE-NAME
           CALL 'TESTLIB' USING TEST-PARMS

           PERFORM 1000-TEST-ZBA
           PERFORM 2000-TEST-TARGET
           PERFORM 3000-TEST-RANGE
           PERFORM 4000-TEST-VALIDATION

           MOVE 'SUMM' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS
           STOP RUN.

       1000-TEST-ZBA.
      *    POSITIVE ZBA BALANCE CONCENTRATED TO PARENT TO THE CENT
           PERFORM 8000-RESET
           SET SWR-TYPE-ZBA TO TRUE
           MOVE 125000.37 TO SWR-SRC-LEDGER-BAL SWR-SRC-AVAIL-BAL
           MOVE 18500000  TO SWR-TGT-AVAIL-BAL
           CALL 'SWEEPRUL' USING SWEEP-RULE-PARMS
           MOVE 'ZBA POSITIVE SWEPT OUT EXACTLY (NO INCREMENT)'
             TO TST-CASE-NAME
           MOVE 125000.37 TO TST-EXP-NUM
           MOVE SWR-SWEEP-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'ZBA POSITIVE DIRECTION IS OUT' TO TST-CASE-NAME
           MOVE 'O' TO TST-EXPECTED
           MOVE SWR-DIRECTION TO TST-ACTUAL
           PERFORM 9100-AEQ

      *    NEGATIVE ZBA FUNDED FROM PARENT
           PERFORM 8000-RESET
           SET SWR-TYPE-ZBA TO TRUE
           MOVE -1327410.55 TO SWR-SRC-LEDGER-BAL SWR-SRC-AVAIL-BAL
           MOVE 20250000    TO SWR-TGT-AVAIL-BAL
           CALL 'SWEEPRUL' USING SWEEP-RULE-PARMS
           MOVE 'ZBA NEGATIVE FUNDED FROM PARENT' TO TST-CASE-NAME
           MOVE 1327410.55 TO TST-EXP-NUM
           MOVE SWR-SWEEP-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'ZBA FUNDING REASON ZFND' TO TST-CASE-NAME
           MOVE 'ZFND' TO TST-EXPECTED
           MOVE SWR-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ

      *    PARENT SHORT - PARTIAL FUNDING + ALERT
           PERFORM 8000-RESET
           SET SWR-TYPE-ZBA TO TRUE
           MOVE -500000 TO SWR-SRC-LEDGER-BAL SWR-SRC-AVAIL-BAL
           MOVE 200000  TO SWR-TGT-AVAIL-BAL
           CALL 'SWEEPRUL' USING SWEEP-RULE-PARMS
           MOVE 'ZBA PARENT SHORT - FUNDS ONLY PARENT AVAILABLE'
             TO TST-CASE-NAME
           MOVE 200000 TO TST-EXP-NUM
           MOVE SWR-SWEEP-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'ZBA PARTIAL FUNDING RAISES ALERT, RC 04'
             TO TST-CASE-NAME
           MOVE 'N' TO TST-CONDITION
           IF SWR-RAISE-ALERT AND SWR-PARTIAL
              AND SWR-RETURN-CODE = 04
               MOVE 'Y' TO TST-CONDITION
           END-IF
           PERFORM 9200-TRUE

      *    PARENT EMPTY - NOTHING MOVES
           PERFORM 8000-RESET
           SET SWR-TYPE-ZBA TO TRUE
           MOVE -75000  TO SWR-SRC-LEDGER-BAL SWR-SRC-AVAIL-BAL
           MOVE -10     TO SWR-TGT-AVAIL-BAL
           CALL 'SWEEPRUL' USING SWEEP-RULE-PARMS
           MOVE 'ZBA PARENT OVERDRAWN - NO FUNDING ZNOF'
             TO TST-CASE-NAME
           MOVE 'ZNOF' TO TST-EXPECTED
           MOVE SWR-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ

      *    UNCOLLECTED FUNDS RETAINED - SWEEP AVAILABLE, NOT LEDGER
           PERFORM 8000-RESET
           SET SWR-TYPE-ZBA TO TRUE
           MOVE 50000 TO SWR-SRC-LEDGER-BAL
           MOVE 20000 TO SWR-SRC-HOLD-AMT
           MOVE 30000 TO SWR-SRC-AVAIL-BAL
           MOVE 1000000 TO SWR-TGT-AVAIL-BAL
           CALL 'SWEEPRUL' USING SWEEP-RULE-PARMS
           MOVE 'ZBA WITH HOLDS SWEEPS AVAILABLE BALANCE ONLY'
             TO TST-CASE-NAME
           MOVE 30000 TO TST-EXP-NUM
           MOVE SWR-SWEEP-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       2000-TEST-TARGET.
      *    EXCESS ROUNDED DOWN TO $10,000 INCREMENT
           PERFORM 8000-RESET
           SET SWR-TYPE-TARGET TO TRUE
           MOVE 18872634.05 TO SWR-SRC-LEDGER-BAL SWR-SRC-AVAIL-BAL
           MOVE 5000000     TO SWR-TARGET-BAL
           MOVE 10000       TO SWR-INCREMENT
           MOVE 'CMMI'      TO SWR-TGT-PRODUCT-CODE
           CALL 'SWEEPRUL' USING SWEEP-RULE-PARMS
           MOVE 'TARGET EXCESS ROUNDED DOWN TO INCREMENT'
             TO TST-CASE-NAME
           MOVE 13870000 TO TST-EXP-NUM
           MOVE SWR-SWEEP-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ

      *    CMMI MINIMUM PURCHASE $10,000 OVERRIDES DEFAULT $1,000
           PERFORM 8000-RESET
           SET SWR-TYPE-TARGET TO TRUE
           MOVE 2008500 TO SWR-SRC-LEDGER-BAL SWR-SRC-AVAIL-BAL
           MOVE 2000000 TO SWR-TARGET-BAL
           MOVE 1000    TO SWR-INCREMENT
           MOVE 'CMMI'  TO SWR-TGT-PRODUCT-CODE
           CALL 'SWEEPRUL' USING SWEEP-RULE-PARMS
           MOVE 'CMMI TARGET - $8,000 BELOW $10,000 MINIMUM'
             TO TST-CASE-NAME
           MOVE 'BMIN' TO TST-EXPECTED
           MOVE SWR-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'CMMI EFFECTIVE MINIMUM TRANSFER IS 10,000'
             TO TST-CASE-NAME
           MOVE 10000 TO TST-EXP-NUM
           MOVE SWR-EFF-MIN-TRANSFER TO TST-ACT-NUM
           PERFORM 9000-NEQ

      *    NON-CMMI TARGET - DEFAULT MINIMUM $1,000 IS SWEPT
           PERFORM 8000-RESET
           SET SWR-TYPE-TARGET TO TRUE
           MOVE 101500 TO SWR-SRC-LEDGER-BAL SWR-SRC-AVAIL-BAL
           MOVE 100000 TO SWR-TARGET-BAL
           MOVE 'MMKT' TO SWR-TGT-PRODUCT-CODE
           CALL 'SWEEPRUL' USING SWEEP-RULE-PARMS
           MOVE 'NON-CMMI DEFAULT INCREMENT/MINIMUM $1,000 SWEPT'
             TO TST-CASE-NAME
           MOVE 1000 TO TST-EXP-NUM
           MOVE SWR-SWEEP-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ

      *    DEFICIT FUNDED BACK, ROUNDED UP TO INCREMENT
           PERFORM 8000-RESET
           SET SWR-TYPE-TARGET TO TRUE
           MOVE 4987500  TO SWR-SRC-LEDGER-BAL SWR-SRC-AVAIL-BAL
           MOVE 5000000  TO SWR-TARGET-BAL
           MOVE 10000    TO SWR-INCREMENT
           MOVE 'CMMI'   TO SWR-TGT-PRODUCT-CODE
           MOVE 40000000 TO SWR-TGT-AVAIL-BAL
           CALL 'SWEEPRUL' USING SWEEP-RULE-PARMS
           MOVE 'TARGET DEFICIT 12,500 FUNDED AS 20,000 (ROUND UP)'
             TO TST-CASE-NAME
           MOVE 20000 TO TST-EXP-NUM
           MOVE SWR-SWEEP-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'TARGET DEFICIT DIRECTION IS IN' TO TST-CASE-NAME
           MOVE 'I' TO TST-EXPECTED
           MOVE SWR-DIRECTION TO TST-ACTUAL
           PERFORM 9100-AEQ

      *    DEFICIT, INVESTMENT ACCOUNT EMPTY
           PERFORM 8000-RESET
           SET SWR-TYPE-TARGET TO TRUE
           MOVE 3000000 TO SWR-SRC-LEDGER-BAL SWR-SRC-AVAIL-BAL
           MOVE 5000000 TO SWR-TARGET-BAL
           MOVE ZERO    TO SWR-TGT-AVAIL-BAL
           MOVE 'CMMI'  TO SWR-TGT-PRODUCT-CODE
           CALL 'SWEEPRUL' USING SWEEP-RULE-PARMS
           MOVE 'DEFICIT NOT FUNDED WHEN INVESTMENT ACCT EMPTY'
             TO TST-CASE-NAME
           MOVE 'TNOF' TO TST-EXPECTED
           MOVE SWR-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ

      *    DEFICIT, INVESTMENT ACCOUNT SHORT - PARTIAL
           PERFORM 8000-RESET
           SET SWR-TYPE-TARGET TO TRUE
           MOVE 4700000 TO SWR-SRC-LEDGER-BAL SWR-SRC-AVAIL-BAL
           MOVE 5000000 TO SWR-TARGET-BAL
           MOVE 10000   TO SWR-INCREMENT
           MOVE 125500  TO SWR-TGT-AVAIL-BAL
           MOVE 'CMMI'  TO SWR-TGT-PRODUCT-CODE
           CALL 'SWEEPRUL' USING SWEEP-RULE-PARMS
           MOVE 'DEFICIT PARTIAL = INVESTMENT AVAIL ROUNDED DOWN'
             TO TST-CASE-NAME
           MOVE 120000 TO TST-EXP-NUM
           MOVE SWR-SWEEP-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ

      *    EXACTLY AT TARGET
           PERFORM 8000-RESET
           SET SWR-TYPE-TARGET TO TRUE
           MOVE 2000000 TO SWR-SRC-LEDGER-BAL SWR-SRC-AVAIL-BAL
           MOVE 2000000 TO SWR-TARGET-BAL
           CALL 'SWEEPRUL' USING SWEEP-RULE-PARMS
           MOVE 'AT TARGET - NO SWEEP' TO TST-CASE-NAME
           MOVE 'N' TO TST-EXPECTED
           MOVE SWR-DIRECTION TO TST-ACTUAL
           PERFORM 9100-AEQ.

       3000-TEST-RANGE.
           PERFORM 8000-RESET
           SET SWR-TYPE-RANGE TO TRUE
           MOVE 1000000 TO SWR-MIN-BAL
           MOVE 3000000 TO SWR-MAX-BAL
           MOVE 3600000 TO SWR-SRC-LEDGER-BAL SWR-SRC-AVAIL-BAL
           MOVE 50000   TO SWR-INCREMENT
           CALL 'SWEEPRUL' USING SWEEP-RULE-PARMS
           MOVE 'RANGE ABOVE MAX SWEPT BACK TO MIDPOINT'
             TO TST-CASE-NAME
           MOVE 1600000 TO TST-EXP-NUM
           MOVE SWR-SWEEP-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8000-RESET
           SET SWR-TYPE-RANGE TO TRUE
           MOVE 1000000  TO SWR-MIN-BAL
           MOVE 3000000  TO SWR-MAX-BAL
           MOVE 400000   TO SWR-SRC-LEDGER-BAL SWR-SRC-AVAIL-BAL
           MOVE 50000    TO SWR-INCREMENT
           MOVE 40000000 TO SWR-TGT-AVAIL-BAL
           CALL 'SWEEPRUL' USING SWEEP-RULE-PARMS
           MOVE 'RANGE BELOW MIN FUNDED TO MIDPOINT (RLO)'
             TO TST-CASE-NAME
           MOVE 'RLO ' TO TST-EXPECTED
           MOVE SWR-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           MOVE 'RANGE BELOW MIN FUNDING AMOUNT 1,600,000'
             TO TST-CASE-NAME
           MOVE 1600000 TO TST-EXP-NUM
           MOVE SWR-SWEEP-AMOUNT TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8000-RESET
           SET SWR-TYPE-RANGE TO TRUE
           MOVE 1000000 TO SWR-MIN-BAL
           MOVE 3000000 TO SWR-MAX-BAL
           MOVE 3000000 TO SWR-SRC-LEDGER-BAL SWR-SRC-AVAIL-BAL
           CALL 'SWEEPRUL' USING SWEEP-RULE-PARMS
           MOVE 'RANGE AT MAX (INCLUSIVE) - NO SWEEP' TO TST-CASE-NAME
           MOVE 'RINB' TO TST-EXPECTED
           MOVE SWR-REASON-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ.

       4000-TEST-VALIDATION.
           PERFORM 8000-RESET
           MOVE 'X' TO SWR-SWEEP-TYPE
           CALL 'SWEEPRUL' USING SWEEP-RULE-PARMS
           MOVE 'INVALID SWEEP TYPE RC 12' TO TST-CASE-NAME
           MOVE 12 TO TST-EXP-NUM
           MOVE SWR-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ

           PERFORM 8000-RESET
           SET SWR-TYPE-RANGE TO TRUE
           MOVE 3000000 TO SWR-MIN-BAL
           MOVE 1000000 TO SWR-MAX-BAL
           CALL 'SWEEPRUL' USING SWEEP-RULE-PARMS
           MOVE 'RANGE MIN > MAX RC 12' TO TST-CASE-NAME
           MOVE 12 TO TST-EXP-NUM
           MOVE SWR-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ.

       8000-RESET.
           INITIALIZE SWEEP-RULE-PARMS
           MOVE SPACES TO SWR-TGT-PRODUCT-CODE.

       9000-NEQ.
           MOVE 'NEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.

       9100-AEQ.
           MOVE 'AEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.

       9200-TRUE.
           MOVE 'TRUE' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.
