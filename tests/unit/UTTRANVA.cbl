      *================================================================*
      * PROGRAM  : UTTRANVA                                            *
      * TYPE     : UNIT TEST DRIVER                                    *
      * PURPOSE  : UNIT TESTS FOR TRANVAL - TRANSACTION EDIT RULES     *
      *----------------------------------------------------------------*
      * CHANGE LOG                                                     *
      * 2007-05-14 BHS  ORIGINAL                                       *
      * 2018-02-20 AKW  CD GRACE PERIOD CASES                          *
      *================================================================*
       IDENTIFICATION DIVISION.
       PROGRAM-ID. UTTRANVA.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY TESTPARM.
       COPY TRVPARM.

       PROCEDURE DIVISION.
       0000-MAIN.
           MOVE 'INIT' TO TST-FUNCTION
           MOVE 'TRANVAL' TO TST-SUITE-NAME
           CALL 'TESTLIB' USING TEST-PARMS

           PERFORM 1000-VALID-ITEM
           PERFORM 1100-BAD-CODE-AMOUNT
           PERFORM 1200-ACCOUNT-NOT-FOUND
           PERFORM 1300-EFFECTIVE-DATES
           PERFORM 1400-CHANNEL-MATRIX
           PERFORM 1500-FROZEN
           PERFORM 1600-RESTRICTED
           PERFORM 1700-DORMANT
           PERFORM 1800-OTHER-STATUSES
           PERFORM 1900-TIME-DEPOSIT
           PERFORM 2000-CHECKS-ALLOWED
           PERFORM 2100-DAILY-LIMIT

           MOVE 'SUMM' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS
           STOP RUN.

       0100-BASELINE.
           INITIALIZE TRANVAL-PARMS
           MOVE 'WPOS'   TO TRV-TRAN-CODE
           MOVE 25.00    TO TRV-AMOUNT
           MOVE 'POS'    TO TRV-CHANNEL
           MOVE 20260930 TO TRV-EFFECTIVE-DATE
           MOVE 20260930 TO TRV-BUSINESS-DATE
           MOVE 'Y'      TO TRV-ACCT-FOUND-FLAG
           MOVE 'A'      TO TRV-ACCT-STATUS
           MOVE 'DD'     TO TRV-ACCT-CATEGORY
           MOVE 'Y'      TO TRV-PROD-FOUND-FLAG
           MOVE 'Y'      TO TRV-PROD-CHECK-ALLOWED
           MOVE 1000.00  TO TRV-DAILY-WD-LIMIT
           MOVE 0        TO TRV-DAILY-WD-USED
           MOVE 'N'      TO TRV-ID-VERIFIED-FLAG.

       0200-CALL.
           CALL 'TRANVAL' USING TRANVAL-PARMS.

       1000-VALID-ITEM.
           PERFORM 0100-BASELINE
           PERFORM 0200-CALL
           MOVE 'VALID POS ACCEPTED RC 00' TO TST-CASE-NAME
           MOVE 0 TO TST-EXP-NUM
           MOVE TRV-RETURN-CODE TO TST-ACT-NUM
           PERFORM 9000-NEQ
           MOVE 'TRAN CODE ATTRIBUTES RETURNED (D,N,Y,Y,4)'
             TO TST-CASE-NAME
           MOVE 'DNYY4' TO TST-EXPECTED
           STRING TRV-DR-CR TRV-CASH-FLAG TRV-REGD-FLAG
                  TRV-CUST-INIT-FLAG TRV-POST-PRIORITY
                  DELIMITED BY SIZE INTO TST-ACTUAL
           PERFORM 9100-AEQ.

       1100-BAD-CODE-AMOUNT.
           PERFORM 0100-BASELINE
           MOVE 'WXYZ' TO TRV-TRAN-CODE
           PERFORM 0200-CALL
           MOVE 'UNKNOWN TRAN CODE - TCIN RC 08' TO TST-CASE-NAME
           MOVE 'TCIN08' TO TST-EXPECTED
           STRING TRV-REJECT-CODE TRV-RETURN-CODE DELIMITED BY SIZE
             INTO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 0 TO TRV-AMOUNT
           PERFORM 0200-CALL
           MOVE 'ZERO AMOUNT - AMT0' TO TST-CASE-NAME
           MOVE 'AMT0' TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ.

       1200-ACCOUNT-NOT-FOUND.
           PERFORM 0100-BASELINE
           MOVE 'N' TO TRV-ACCT-FOUND-FLAG
           PERFORM 0200-CALL
           MOVE 'ACCOUNT NOT ON FILE - ACNF' TO TST-CASE-NAME
           MOVE 'ACNF' TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ.

       1300-EFFECTIVE-DATES.
      *    BUS DATE 09-30 + 5 BUSINESS DAYS = WED 10-07
           PERFORM 0100-BASELINE
           MOVE 20261007 TO TRV-EFFECTIVE-DATE
           PERFORM 0200-CALL
           MOVE 'FUTURE DATED 5 BUS DAYS (10-07) ACCEPTED'
             TO TST-CASE-NAME
           MOVE SPACES TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 20261008 TO TRV-EFFECTIVE-DATE
           PERFORM 0200-CALL
           MOVE 'FUTURE DATED 6 BUS DAYS (10-08) - EDFT'
             TO TST-CASE-NAME
           MOVE 'EDFT' TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 20260830 TO TRV-EFFECTIVE-DATE
           PERFORM 0200-CALL
           MOVE 'BACK DATED 31 DAYS - EDBK' TO TST-CASE-NAME
           MOVE 'EDBK' TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 20260831 TO TRV-EFFECTIVE-DATE
           PERFORM 0200-CALL
           MOVE 'BACK DATED EXACTLY 30 DAYS - ACCEPTED' TO TST-CASE-NAME
           MOVE SPACES TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 'ADJD' TO TRV-TRAN-CODE
           MOVE 'BAT'  TO TRV-CHANNEL
           MOVE 20260115 TO TRV-EFFECTIVE-DATE
           PERFORM 0200-CALL
           MOVE 'ADJUSTMENT BACK DATED 8 MONTHS - ACCEPTED'
             TO TST-CASE-NAME
           MOVE SPACES TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 20260231 TO TRV-EFFECTIVE-DATE
           PERFORM 0200-CALL
           MOVE 'INVALID DATE 02-31 - EDIV' TO TST-CASE-NAME
           MOVE 'EDIV' TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ.

       1400-CHANNEL-MATRIX.
           PERFORM 0100-BASELINE
           MOVE 'WATM' TO TRV-TRAN-CODE
           MOVE 'BRN'  TO TRV-CHANNEL
           PERFORM 0200-CALL
           MOVE 'WATM AT BRANCH - CHNL' TO TST-CASE-NAME
           MOVE 'CHNL' TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 'WCHK' TO TRV-TRAN-CODE
           MOVE 'ONL'  TO TRV-CHANNEL
           PERFORM 0200-CALL
           MOVE 'WCHK ONLINE - CHNL (BATCH CLEARING ONLY)'
             TO TST-CASE-NAME
           MOVE 'CHNL' TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 'WCSH' TO TRV-TRAN-CODE
           MOVE 'BRN'  TO TRV-CHANNEL
           PERFORM 0200-CALL
           MOVE 'WCSH AT BRANCH - ACCEPTED' TO TST-CASE-NAME
           MOVE SPACES TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 'DXFR' TO TRV-TRAN-CODE
           MOVE 'MOB'  TO TRV-CHANNEL
           PERFORM 0200-CALL
           MOVE 'DXFR ANY CHANNEL - ACCEPTED' TO TST-CASE-NAME
           MOVE SPACES TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ.

       1500-FROZEN.
           PERFORM 0100-BASELINE
           MOVE 'F'    TO TRV-ACCT-STATUS
           MOVE 'DACH' TO TRV-TRAN-CODE
           MOVE 'ACH'  TO TRV-CHANNEL
           PERFORM 0200-CALL
           MOVE 'FROZEN - CREDIT ALSO REJECTED AFRZ' TO TST-CASE-NAME
           MOVE 'AFRZ' TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 'F'    TO TRV-ACCT-STATUS
           MOVE 'DREV' TO TRV-TRAN-CODE
           MOVE 'BAT'  TO TRV-CHANNEL
           PERFORM 0200-CALL
           MOVE 'FROZEN - DREV ACCEPTED' TO TST-CASE-NAME
           MOVE SPACES TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ.

       1600-RESTRICTED.
           PERFORM 0100-BASELINE
           MOVE 'R'    TO TRV-ACCT-STATUS
           MOVE 'WATM' TO TRV-TRAN-CODE
           MOVE 'ATM'  TO TRV-CHANNEL
           PERFORM 0200-CALL
           MOVE 'RESTRICTED - DEBIT REJECTED ARST' TO TST-CASE-NAME
           MOVE 'ARST' TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 'R'    TO TRV-ACCT-STATUS
           MOVE 'DACH' TO TRV-TRAN-CODE
           MOVE 'ACH'  TO TRV-CHANNEL
           PERFORM 0200-CALL
           MOVE 'RESTRICTED - CREDIT ACCEPTED' TO TST-CASE-NAME
           MOVE SPACES TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 'R'    TO TRV-ACCT-STATUS
           MOVE 'WFMN' TO TRV-TRAN-CODE
           MOVE 'BAT'  TO TRV-CHANNEL
           PERFORM 0200-CALL
           MOVE 'RESTRICTED - BANK FEE DEBIT ACCEPTED' TO TST-CASE-NAME
           MOVE SPACES TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ.

       1700-DORMANT.
           PERFORM 0100-BASELINE
           MOVE 'D'    TO TRV-ACCT-STATUS
           MOVE 'DCSH' TO TRV-TRAN-CODE
           MOVE 'BRN'  TO TRV-CHANNEL
           PERFORM 0200-CALL
           MOVE 'DORMANT - CASH DEPOSIT REACTIVATES' TO TST-CASE-NAME
           MOVE 'Y' TO TST-EXPECTED
           MOVE TRV-REACTIVATE-FLAG TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 'D'    TO TRV-ACCT-STATUS
           MOVE 'DINT' TO TRV-TRAN-CODE
           MOVE 'BAT'  TO TRV-CHANNEL
           PERFORM 0200-CALL
           MOVE 'DORMANT - INTEREST DOES NOT REACTIVATE'
             TO TST-CASE-NAME
           MOVE 'N' TO TST-EXPECTED
           MOVE TRV-REACTIVATE-FLAG TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 'D'    TO TRV-ACCT-STATUS
           MOVE 'WATM' TO TRV-TRAN-CODE
           MOVE 'ATM'  TO TRV-CHANNEL
           PERFORM 0200-CALL
           MOVE 'DORMANT - ATM DEBIT REJECTED ADRM' TO TST-CASE-NAME
           MOVE 'ADRM' TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 'D'    TO TRV-ACCT-STATUS
           MOVE 'WCSH' TO TRV-TRAN-CODE
           MOVE 'BRN'  TO TRV-CHANNEL
           MOVE 'Y'    TO TRV-ID-VERIFIED-FLAG
           PERFORM 0200-CALL
           MOVE 'DORMANT - BRANCH DEBIT WITH ID ACCEPTED'
             TO TST-CASE-NAME
           MOVE 'Y' TO TST-EXPECTED
           STRING TRV-REJECT-CODE(1:1) TRV-REACTIVATE-FLAG
                  DELIMITED BY SIZE INTO TST-ACTUAL
           MOVE ' Y' TO TST-EXPECTED
           PERFORM 9100-AEQ.

       1800-OTHER-STATUSES.
           PERFORM 0100-BASELINE
           MOVE 'C'    TO TRV-ACCT-STATUS
           MOVE 'DACH' TO TRV-TRAN-CODE
           MOVE 'ACH'  TO TRV-CHANNEL
           PERFORM 0200-CALL
           MOVE 'CLOSED - ACLS' TO TST-CASE-NAME
           MOVE 'ACLS' TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 'E'    TO TRV-ACCT-STATUS
           PERFORM 0200-CALL
           MOVE 'ESCHEATED - AESC' TO TST-CASE-NAME
           MOVE 'AESC' TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 'X'    TO TRV-ACCT-STATUS
           PERFORM 0200-CALL
           MOVE 'CHARGED OFF - DEBIT ACOF' TO TST-CASE-NAME
           MOVE 'ACOF' TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 'X'    TO TRV-ACCT-STATUS
           MOVE 'DCSH' TO TRV-TRAN-CODE
           MOVE 'BRN'  TO TRV-CHANNEL
           PERFORM 0200-CALL
           MOVE 'CHARGED OFF - RECOVERY CREDIT ACCEPTED'
             TO TST-CASE-NAME
           MOVE SPACES TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ.

       1900-TIME-DEPOSIT.
           PERFORM 0100-BASELINE
           MOVE 'TD'     TO TRV-ACCT-CATEGORY
           MOVE 'WXFR'   TO TRV-TRAN-CODE
           MOVE 'ONL'    TO TRV-CHANNEL
           MOVE 20261115 TO TRV-MATURITY-DATE
           MOVE 20261125 TO TRV-GRACE-END-DATE
           PERFORM 0200-CALL
           MOVE 'CD TRANSFER BEFORE MATURITY - TDDR' TO TST-CASE-NAME
           MOVE 'TDDR' TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 'TD'     TO TRV-ACCT-CATEGORY
           MOVE 'WXFR'   TO TRV-TRAN-CODE
           MOVE 'ONL'    TO TRV-CHANNEL
           MOVE 20260930 TO TRV-MATURITY-DATE
           MOVE 20261010 TO TRV-GRACE-END-DATE
           PERFORM 0200-CALL
           MOVE 'CD TRANSFER IN GRACE PERIOD - ACCEPTED'
             TO TST-CASE-NAME
           MOVE SPACES TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 'TD'     TO TRV-ACCT-CATEGORY
           MOVE 'WPEN'   TO TRV-TRAN-CODE
           MOVE 'BAT'    TO TRV-CHANNEL
           PERFORM 0200-CALL
           MOVE 'CD EARLY WD PENALTY - ACCEPTED' TO TST-CASE-NAME
           MOVE SPACES TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 'TD'     TO TRV-ACCT-CATEGORY
           MOVE 'DXFR'   TO TRV-TRAN-CODE
           MOVE 'ONL'    TO TRV-CHANNEL
           PERFORM 0200-CALL
           MOVE 'CD ADDITIONAL DEPOSIT - TDCR' TO TST-CASE-NAME
           MOVE 'TDCR' TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ.

       2000-CHECKS-ALLOWED.
           PERFORM 0100-BASELINE
           MOVE 'SV'   TO TRV-ACCT-CATEGORY
           MOVE 'WCHK' TO TRV-TRAN-CODE
           MOVE 'BAT'  TO TRV-CHANNEL
           MOVE 'N'    TO TRV-PROD-CHECK-ALLOWED
           PERFORM 0200-CALL
           MOVE 'CHECK ON HIGH YIELD SAVINGS - NCHK' TO TST-CASE-NAME
           MOVE 'NCHK' TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 'DCHK' TO TRV-TRAN-CODE
           MOVE 'MOB'  TO TRV-CHANNEL
           MOVE 'N'    TO TRV-PROD-CHECK-ALLOWED
           PERFORM 0200-CALL
           MOVE 'CHECK DEPOSIT TO NO-CHECK PRODUCT - OK'
             TO TST-CASE-NAME
           MOVE SPACES TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ.

       2100-DAILY-LIMIT.
           PERFORM 0100-BASELINE
           MOVE 'WATM'  TO TRV-TRAN-CODE
           MOVE 'ATM'   TO TRV-CHANNEL
           MOVE 500.00  TO TRV-AMOUNT
           MOVE 600.00  TO TRV-DAILY-WD-USED
           PERFORM 0200-CALL
           MOVE 'ATM 500 AFTER 600 USED - DWLM' TO TST-CASE-NAME
           MOVE 'DWLM' TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 'WATM'  TO TRV-TRAN-CODE
           MOVE 'ATM'   TO TRV-CHANNEL
           MOVE 400.00  TO TRV-AMOUNT
           MOVE 600.00  TO TRV-DAILY-WD-USED
           PERFORM 0200-CALL
           MOVE 'ATM EXACTLY AT 1000 LIMIT - ACCEPTED' TO TST-CASE-NAME
           MOVE 'Y' TO TST-EXPECTED
           STRING TRV-REJECT-CODE(1:1) TRV-WD-LIMIT-FLAG
                  DELIMITED BY SIZE INTO TST-ACTUAL
           MOVE ' Y' TO TST-EXPECTED
           PERFORM 9100-AEQ
           PERFORM 0100-BASELINE
           MOVE 'WCSH'  TO TRV-TRAN-CODE
           MOVE 'BRN'   TO TRV-CHANNEL
           MOVE 5000.00 TO TRV-AMOUNT
           PERFORM 0200-CALL
           MOVE 'BRANCH CASH 5000 NOT SUBJECT TO ATM LIMIT'
             TO TST-CASE-NAME
           MOVE SPACES TO TST-EXPECTED
           MOVE TRV-REJECT-CODE TO TST-ACTUAL
           PERFORM 9100-AEQ.

       9000-NEQ.
           MOVE 'NEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS.

       9100-AEQ.
           MOVE 'AEQ' TO TST-FUNCTION
           CALL 'TESTLIB' USING TEST-PARMS
           MOVE SPACES TO TST-ACTUAL TST-EXPECTED.
